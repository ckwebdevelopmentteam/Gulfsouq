{%- liquid
  assign collections_menu = empty
  assign quick_links = empty
  assign show_menu = false
  if section.settings.enable_menu or section.settings.enable_collections
    if section.settings.enable_collections and section.settings.collections_menu != blank
      assign collections_menu = section.settings.collections_menu
    endif
    if section.settings.enable_menu
      assign quick_links = linklists[section.settings.filter_menu]
    endif
    assign show_menu = true
  endif
  assign sorting_block = section.blocks | where: 'type', 'sorting' | first
  assign description_block = section.blocks | where: 'type', 'description' | first
  assign show_filters_and_menu = true
  assign show_filters = section.settings.enable_filters

  if show_filters and collection.filters == empty
    assign show_filters = false
  endif
  if show_menu and quick_links == empty and collections_menu == empty
    assign show_menu = false
  endif

  if show_filters == false and show_menu == false
    assign show_filters_and_menu = false
   endif
  if section.settings.enable_secondary_products_per_row_mobile
    assign enable_collection_grid_choice_mobile = true
    assign first_width_class_mobile = 'w100-mobile|1'
    assign secondary_width_class_mobile = 'w50-mobile|2'
  else
    if section.settings.products_per_row_mobile == '1'
      assign first_width_class_mobile = 'w100-mobile|1'
    else
      assign first_width_class_mobile = 'w50-mobile|2'
    endif
    assign secondary_width_class_mobile = first_width_class_mobile
  endif
  assign first_collection_grid_view_mobile = first_width_class_mobile | split: '|' | first
  assign secondary_collection_grid_view_mobile = secondary_width_class_mobile | split: '|' | first
  assign has_selected_view_mobile = false
  if cart.attributes.collection_grid_view_mobile == first_collection_grid_view_mobile or cart.attributes.collection_grid_view_mobile == secondary_collection_grid_view_mobile
    assign has_selected_view_mobile = true
  endif
  if has_selected_view_mobile and section.settings.enable_secondary_products_per_row_mobile
    assign width_class_mobile = cart.attributes.collection_grid_view_mobile | split: '|' | first
  else
    if section.settings.products_per_row_mobile == '1'
      assign width_class_mobile = first_width_class_mobile | split: '|' | first
    else
      assign width_class_mobile = secondary_width_class_mobile | split: '|' | first
    endif
  endif

  case section.settings.products_per_row
    when 1
      assign first_width_class = 'w100|1'
    when 2
      assign first_width_class = 'w50|2'
    when 3
      assign first_width_class = 'w33|3'
    when 4
      assign first_width_class = 'w25|4'
  endcase
  assign img_width = 100 | divided_by: section.settings.products_per_row

  if section.settings.enable_secondary_products_per_row
    assign enable_collection_grid_choice = true
    case section.settings.secondary_products_per_row
      when 1
        assign secondary_width_class = 'w100|1'
      when 2
        assign secondary_width_class = 'w50|2'
      when 3
        assign secondary_width_class = 'w33|3'
      when 4
        assign secondary_width_class = 'w25|4'
      when 5
        assign secondary_width_class = 'w20|5'
    endcase
  else
    assign secondary_width_class = first_width_class
  endif
  assign first_collection_grid_view = first_width_class | split: '|' | first
  assign secondary_collection_grid_view = secondary_width_class | split: '|' | first
  assign has_selected_view_mobile = false
  if cart.attributes.collection_grid_view == first_collection_grid_view or cart.attributes.collection_grid_view == secondary_collection_grid_view
    assign has_selected_view = true
  endif
  if has_selected_view and section.settings.enable_secondary_products_per_row
    assign width_class = cart.attributes.collection_grid_view | split: '|' | first
  else
    if section.settings.default_grid == 'primary'
      assign width_class = first_width_class | split: '|' | first
    else
      assign width_class = secondary_width_class | split: '|' | first
    endif
  endif


  if section.settings.enable_grid_list_toggle
    assign enable_collection_view_choice = true
  endif
  assign collection_view = cart.attributes.collection_view | default: section.settings.productview_type
-%}

{%- capture image_sizes -%}
  {% if settings.width < 2000 %}
    (min-width: 1300px)
    {%- if show_filters_and_menu -%}
      {%- if img_width == 100 -%}
        calc(({{ settings.width }}px - 275px) * 0.2)
      {%- else -%}
        calc(({{ settings.width }}px - 275px) * 0.{{ img_width }})
      {%- endif -%}
    {%- else -%}
      {%- if img_width == 100 -%}
        calc({{ settings.width }}px * 0.2)
      {%- else -%}
        calc({{ settings.width }}px * 0.{{ img_width }})
      {%- endif -%}
    {%- endif -%}
    ,
  {% endif %}
  (min-width: 1000px)
  {%- if show_filters_and_menu -%}
    {%- if img_width == 100 -%}
      calc((100vw - 275px) * 0.2)
    {%- else -%}
      calc((100vw - 275px) * 0.{{ img_width }})
    {%- endif -%}
  {%- else -%}
    {%- if img_width == 100 -%}
      calc(100vw * 0.2)
    {%- else -%}
      calc(100vw * 0.{{ img_width }})
    {%- endif -%}
  {%- endif -%}
  ,
  {%- if width_class_mobile contains 'w100-mobile' -%}
    100vw
  {%- else -%}
    50vw
  {%- endif -%}
{%- endcapture -%}

<style>
  /* Collection page custom toolbar and layout overrides */
  .collection-wrapper,
  #root .collection-wrapper {
    padding-left: 20px !important;
    padding-right: 20px !important;
    display: block !important;
    box-sizing: border-box !important;
  }
  .collection-wrapper > aside {
    display: none !important;
  }
  .collection-wrapper > div {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
  }

  /* Offers Top Toolbar */
  .offers-top-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 14px 0;
    margin: 20px 0 28px 0;
    position: relative;
    z-index: 50;
    font-family: inherit;
    border-top: 1px solid #e5e7eb !important;
    border-bottom: 1px solid #e5e7eb !important;
  }
  .offers-left-filters {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .offers-right-controls {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .offers-dropdown-container {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .offers-dropdown-btn {
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0;
    margin: 0;
    font-size: 1.4rem;
    font-weight: 500;
    color: #1f2937;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
    transition: color 0.15s ease;
  }
  .offers-dropdown-btn:before,
  .offers-dropdown-btn:after {
    display: none !important;
    content: none !important;
    border: none !important;
  }
  .offers-dropdown-btn:hover,
  .offers-dropdown-btn:focus,
  .offers-dropdown-btn:active {
    color: #0C3E61;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }
  .offers-dropdown-btn svg.offers-chevron {
    transition: transform 0.2s ease;
    display: inline-block;
    vertical-align: middle;
  }
  .offers-dropdown-container.open .offers-dropdown-btn svg.offers-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Menus */
  .offers-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.04);
    min-width: 200px;
    z-index: 100;
    padding: 8px 0;
  }
  .offers-dropdown-container.open .offers-dropdown-menu {
    display: block;
  }
  .offers-dropdown-menu.offers-sort-menu {
    left: auto;
    right: 0;
    min-width: 220px;
  }

  /* Checkbox / Filter Items */
  .offers-filter-form {
    padding: 8px 16px;
  }
  .offers-checkbox-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    font-size: 1.35rem;
    color: #374151;
    cursor: pointer;
    user-select: none;
  }
  .offers-checkbox-item input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: #0C3E61;
    cursor: pointer;
  }

  /* Price Filter Menu */
  .offers-dropdown-menu.offers-price-menu {
    padding: 16px;
    min-width: 240px;
  }
  .offers-price-inputs {
    display: flex;
    gap: 12px;
    margin-bottom: 12px;
  }
  .offers-price-field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .offers-price-field label {
    font-size: 1.15rem;
    color: #374151 !important;
    font-weight: 500;
  }
  .offers-price-field input {
    width: 100%;
    padding: 6px 10px;
    border: 1px solid #d1d5db !important;
    border-radius: 6px;
    font-size: 1.3rem;
    color: #000000 !important;
    background: #ffffff !important;
  }
  .offers-price-field input::placeholder {
    color: #6b7280 !important;
    opacity: 1 !important;
  }
  .offers-price-apply-btn {
    width: 100%;
    padding: 8px 16px;
    background: #0C3E61 !important;
    color: #ffffff !important;
    border: none !important;
    border-radius: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    font-size: 1.3rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .offers-price-apply-btn:before,
  .offers-price-apply-btn:after {
    display: none !important;
    content: none !important;
    border: none !important;
  }
  .offers-price-apply-btn:hover,
  .offers-price-apply-btn:focus,
  .offers-price-apply-btn:active {
    background: #092c45 !important;
    color: #ffffff !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }

  /* Item Count */
  .offers-items-count {
    font-size: 1.4rem;
    color: #6b7280;
    font-weight: 400;
    white-space: nowrap;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }

  /* Sort Options List */
  .offers-sort-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .offers-sort-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px;
    font-size: 1.35rem;
    color: #374151;
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .offers-sort-item:hover {
    background: #f3f4f6;
    color: #0C3E61;
  }
  .offers-sort-item.active {
    font-weight: 600;
    color: #0C3E61;
  }
  .offers-sort-tick {
    width: 14px;
    display: inline-block;
    font-weight: 700;
    color: #0C3E61;
  }

  /* Grid Toggles */
  .offers-grid-toggles {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
  }
  .offers-grid-btn {
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0;
    margin: 0;
    color: #9ca3af;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.15s ease;
    line-height: 1;
  }
  .offers-grid-btn:before,
  .offers-grid-btn.after {
    display: none !important;
    content: none !important;
    border: none !important;
  }
  .offers-grid-btn:hover,
  .offers-grid-btn:focus,
  .offers-grid-btn:active,
  .offers-grid-btn.active {
    color: #1f2937;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }

  @media (max-width: 768px) {
    .offers-top-toolbar {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .offers-right-controls {
      width: 100% !important;
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
    }
    .offers-grid-toggles {
      display: none !important;
    }
  }

  /* Icon 2: Compact 6-per-row Grid View */
  html body #collection.gs-compact-7 {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow: visible !important;
  }

  /* Override ALL theme li width/float rules (w50, w33, w25, etc.) with ultra-high specificity */
  html body #collection.gs-compact-7 > li,
  html body #collection.gs-compact-7 > li.gs-card,
  html body #collection.gs-compact-7 > li.product-card,
  html body #collection.gs-compact-7 > li[class] {
    float: none !important;
    width: calc((100% - 40px) / 6) !important;
    max-width: calc((100% - 40px) / 6) !important;
    min-width: calc((100% - 40px) / 6) !important;
    flex: 0 0 calc((100% - 40px) / 6) !important;
    box-sizing: border-box !important;
    padding: 8px 6px 8px 6px !important;
    min-height: auto !important;
    border-radius: 10px !important;
    border: 1px solid #ebebeb !important;
    background: #fff !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    margin: 0 !important;
  }

  /* Responsive breakpoints for 6-per-row view */
  @media (max-width: 1100px) {
    html body #collection.gs-compact-7 > li,
    html body #collection.gs-compact-7 > li[class] {
      width: calc((100% - 32px) / 5) !important;
      max-width: calc((100% - 32px) / 5) !important;
      min-width: calc((100% - 32px) / 5) !important;
      flex: 0 0 calc((100% - 32px) / 5) !important;
    }
  }

  @media (max-width: 850px) {
    html body #collection.gs-compact-7 > li,
    html body #collection.gs-compact-7 > li[class] {
      width: calc((100% - 24px) / 4) !important;
      max-width: calc((100% - 24px) / 4) !important;
      min-width: calc((100% - 24px) / 4) !important;
      flex: 0 0 calc((100% - 24px) / 4) !important;
    }
  }

  @media (max-width: 600px) {
    html body #collection.gs-compact-7 > li,
    html body #collection.gs-compact-7 > li[class] {
      width: calc((100% - 16px) / 3) !important;
      max-width: calc((100% - 16px) / 3) !important;
      min-width: calc((100% - 16px) / 3) !important;
      flex: 0 0 calc((100% - 16px) / 3) !important;
    }
  }

  html body #collection.gs-compact-7 .gs-card-media,
  html body #collection.gs-compact-7 > li figure,
  html body #collection.gs-compact-7 > li .item-media {
    height: auto !important;
    min-height: 0 !important;
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    background: transparent !important;
    position: static !important;
  }

  html body #collection.gs-compact-7 .gs-card-media picture img,
  html body #collection.gs-compact-7 .gs-card-media img,
  html body #collection.gs-compact-7 > li figure img,
  html body #collection.gs-compact-7 > li .item-media img,
  html body #collection.gs-compact-7 > li a > img,
  html body #collection.gs-compact-7 > li picture img {
    width: 100% !important;
    height: 125px !important;
    max-height: 125px !important;
    max-width: 100% !important;
    object-fit: contain !important;
    position: static !important;
    display: block !important;
  }

  html body #collection.gs-compact-7 .gs-card-content {
    padding: 4px 2px 0 2px !important;
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
  }

  html body #collection.gs-compact-7 .gs-card-title,
  html body #collection.gs-compact-7 h3,
  html body #collection.gs-compact-7 h2,
  html body #collection.gs-compact-7 > li .title,
  html body #collection.gs-compact-7 > li p.title {
    font-size: 12px !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    color: #0C3E61 !important;
    text-align: center !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
    max-height: 34px !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Hide everything except image and title in compact view */
  html body #collection.gs-compact-7 .gs-card-badges,
  html body #collection.gs-compact-7 .gs-wishlist-btn,
  html body #collection.gs-compact-7 .gs-card-vendor,
  html body #collection.gs-compact-7 .gs-card-rating,
  html body #collection.gs-compact-7 .gs-stock-status,
  html body #collection.gs-compact-7 .gs-card-price-wrap,
  html body #collection.gs-compact-7 .gs-card-actions,
  html body #collection.gs-compact-7 .s1pr,
  html body #collection.gs-compact-7 .r6rt,
  html body #collection.gs-compact-7 .submit,
  html body #collection.gs-compact-7 .link-btn,
  html body #collection.gs-compact-7 .label,
  html body #collection.gs-compact-7 .overlay-buy_button,
  html body #collection.gs-compact-7 .overlay-unavailable-buy-button,
  html body #collection.gs-compact-7 form,
  html body #collection.gs-compact-7 p.price,
  html body #collection.gs-compact-7 .price,
  html body #collection.gs-compact-7 .swatch,
  html body #collection.gs-compact-7 .f8pr,
  html body #collection.gs-compact-7 .badge,
  html body #collection.gs-compact-7 [class*="badge"],
  html body #collection.gs-compact-7 .wishlist,
  html body #collection.gs-compact-7 [class*="wishlist"] {
    display: none !important;
  }
</style>
<div class="collection-wrapper offers-page {% if show_filters_and_menu %}m6cl{% if section.settings.filter_sticky %} sticky{% endif %}{% endif %}{% if section.settings.filters_menu_alignment == 'right' %} m6cl-inv{% endif %} section-width-{{ section.settings.width }}">
  {%- if show_filters_and_menu -%}<div>{%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
      	{%- when '@app' -%}
          {% render block %}
        {%- when 'spacer' -%}
          <div class="module-spacer" style="margin-bottom:{{ block.settings.height }}px;" {{ block.shopify_attributes }}></div>
        {%- when 'title'-%}
          <header {% if block.settings.text_alignment == 'center' %}class="text-center"{% endif %} {{ block.shopify_attributes }}>
            <h1 class="collection-title {{ block.settings.title_size }}" style="font-size: 3.8rem; font-weight: 700; color: #111827;">
              {% if collection.handle == 'offers' %}Top Offers{% else %}{{ collection.title }}{% endif %}
            </h1>
          </header>
          {%- if sorting_block == nil and show_filters_and_menu -%}
            {%- render 'filters-sorting',
              display: 'mobile-filter-button',
              sticky: section.settings.filter_mobile_sticky,
              show_filters: show_filters
            -%}
          {%- endif -%}
        {%- when 'description'-%}
          <article class="cols b30 {% if block.settings.text_alignment == 'center' %}text-center{% endif %}" {{ block.shopify_attributes }}>
            {%- if collection.image and section.settings.show_collection_image -%}
              <figure class="w50 desktop-hide {% if settings.multiply_collection_images == 'multiply' %}img-multiply{% elsif settings.multiply_collection_images == 'multiply-bg' %}img-multiply-bg{% endif %}">
                <img
                  src="{{ collection.image | image_url: width: 640 }}"
                  srcset="{% render 'image-srcset', image: collection.image, max_width: 720 %}"
                  sizes="
                    (min-width: 1000px) 0
                    (min-width: 760px) 50vw
                    100vw
                  "
                  alt="{{ collection.image.alt | default: collection.title | escape }}"
                  width="640"
                  height="640"
                  loading="lazy"
                >
              </figure>
            {%- endif -%}
            {%- if collection.description != empty or block.settings.text != blank -%}
              <div class="w50">
                {%- if block.settings.enable_read_more -%}
                  <div class="m6lm">
                    {% if block.settings.text != blank %}
                      {{ block.settings.text }}
                    {% else %}  
                      {{ collection.description }}
                    {% endif %}
                  </div>
                  <p class="has-link-more"><a href="./" class="strong link-more">{{ 'general.read_more.read' | t }} <span>{{ 'general.read_more.more' | t }}</span> <span class="hidden">{{ 'general.read_more.less' | t }}</span> <i aria-hidden="true" class="icon-chevron-down"></i></a></p>
                {%- else -%}
                  {% if block.settings.text != blank %}
                    {{ block.settings.text }}
                  {% else %}  
                    {{ collection.description }}
                  {% endif %}
                {%- endif -%}
              </div>
            {%- endif -%}
          </article>
        {%- when 'sorting'-%}
          {%- render 'filters-sorting',
            display: 'sorting',
            sticky: section.settings.filter_mobile_sticky,
            show_filters: show_filters,
            origin: "collection",
            object: collection,
            show_amount_of_products: section.settings.show_amount_of_products_in_collection,
            collection_view: collection_view,
            enable_collection_view_choice: enable_collection_view_choice,
            enable_collection_grid_choice: enable_collection_grid_choice,
            collection_grid_view: width_class,
            grid_1: first_width_class,
            grid_2: secondary_width_class,
            enable_collection_grid_choice_mobile: enable_collection_grid_choice_mobile,
            collection_grid_view_mobile: width_class_mobile,
            grid_1_mobile: first_width_class_mobile,
            grid_2_mobile: secondary_width_class_mobile
          -%}
        {%- when 'product_grid'-%}
          {%- if collection.products.size > 0 -%}
            {%- paginate collection.products by section.settings.pagination_qty -%}
              {%- if section.settings.pagination_type == 'button' and paginate.previous %}
                {% render 'pagination',
                  paginate: paginate,
                  pagination_type: section.settings.pagination_type,
                  prev_button: true
                %}
              {%- endif -%}
              <ul id="collection" class="l4cl gs-product-grid {{ width_class }} {{ width_class_mobile }} mobile-scroll {% if settings.enable_quick_buy %}with-quick-buy{% endif %}{% if collection_view == 'list' %} list{% endif %}{% unless show_filters_and_menu %} mobile-wide{% endunless %}" {{ block.shopify_attributes }}>
                {%- liquid
                  if settings.fill_product_images
                    assign largest_product_img = collection.products.first
                  else
                    assign products_in_view = section.settings.products_per_row | times: 2
                    assign largest_img_width = ''
                    for product in collection.products limit: products_in_view
                      if product.selected_or_first_available_variant.featured_image
                        assign product_image = product.selected_or_first_available_variant.featured_image
                      else
                        assign product_image = product.featured_image
                      endif
                      if largest_img_width == '' or product_image.width > largest_img_width
                        assign largest_img_width = product_image.width
                        assign largest_product_img = product
                      endif
                    endfor
                  endif
                -%}
                {%- for product in collection.products -%}
                  {%- liquid
                    capture placeholder_int
                      cycle 1, 2, 3, 4, 5, 6
                    endcapture
                    if forloop.first or largest_product_img == product
                      assign no_lazyload = true
                    elsif section.settings.products_per_row_mobile == '2' and forloop.index == 2
                      assign no_lazyload = true
                    else
                      assign no_lazyload = false
                    endif
                  -%}
                  {%- render 'product-item',
                    product: product,
                    placeholder_int: placeholder_int,
                    type: 'both',
                    quick_buy_compact: section.settings.enable_quick_buy_compact,
                    enable_quick_buy_desktop: section.settings.enable_quick_buy_desktop,
                    enable_quick_buy_mobile: section.settings.enable_quick_buy_mobile,
                    enable_quick_buy_qty_selector: section.settings.enable_quick_buy_qty_selector,
                    enable_quick_buy_drawer: section.settings.enable_quick_buy_drawer,
                    enable_color_picker: section.settings.enable_color_picker,
                    no_lazyload: no_lazyload,
                    sizes: image_sizes
                  -%}
                {%- endfor -%}
              </ul>
              <script type="application/ld+json">
              {
                "@context": "https://schema.org",
                "@type": "ItemList",
                "name": {{ collection.title | json }},
                "url": "{{ shop.url }}{{ collection.url }}",
                "numberOfItems": {{ collection.products_count }},
                "itemListElement": [
                  {%- for product in collection.products limit: 24 -%}
                    {%- unless forloop.first -%},{%- endunless -%}
                    {
                      "@type": "ListItem",
                      "position": {{ forloop.index }},
                      "name": {{ product.title | json }},
                      "url": "{{ shop.url }}{{ product.url }}"
                    }
                  {%- endfor -%}
                ]
              }
              </script>
              {% render 'pagination',
                paginate: paginate,
                pagination_type: section.settings.pagination_type,
                show_amount: section.settings.show_amount_of_products_in_collection
              %}
            {%- endpaginate -%}
          {%- else -%}
            <p>{{ 'collection.empty_collection_html' | t }}</p>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
    {%- if description_block == nil and section.settings.show_collection_image and collection.image -%}
      <article class="cols b30">
        <figure class="w50 desktop-hide {% if settings.multiply_collection_images == 'multiply' %}img-multiply{% elsif settings.multiply_collection_images == 'multiply-bg' %}img-multiply-bg{% endif %}">
          <img
            src="{{ collection.image | image_url: width: 640 }}"
            srcset="{% render 'image-srcset', image: collection.image, max_width: 720 %}"
            sizes="
              (min-width: 1000px) 0
              (min-width: 760px) 50vw
              100vw
            "
            alt="{{ collection.image.alt | default: collection.title | escape }}"
            width="640"
            height="640"
            loading="lazy"
          >
        </figure>
      </article>
    {%- endif -%}
  {%- if show_filters_and_menu -%}</div>{%- endif -%}
  {% if show_filters_and_menu %}
    {% for filter in collection.filters limit: 1 %}{% endfor %} {% comment %} This is just to get rid of the "this theme does not support filters" message in the shopify admin {% endcomment %}
    <aside>
      {%- render 'filters-sorting',
        display: 'filters',
        show_filters: show_filters,
        quick_links: quick_links,
        collections_menu: collections_menu,
        show_collection_image: section.settings.show_collection_image,
        filters_show_more_limit: section.settings.filters_show_more_limit
      -%}
    </aside>
  {% endif %}
</div>


{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- liquid
  assign image_ratio = section.settings.image_ratio
  case image_ratio
    when 'portrait'
      assign image_width =  "240"
      assign image_height = "300"
    when 'square'
      assign image_width =  "240"
      assign image_height = "240"
    else
      assign image_width =  "300"
      assign image_height = "240"
  endcase

  assign limit = section.settings.number_of_items
  case limit
    when 0
      assign width_class = 'w20'
    when 2
      assign width_class = 'w50'
    when 3
      assign width_class = 'w33'
    when 4
      assign width_class = 'w25'
    when 5
      assign width_class = 'w20'
    when 6
      assign width_class = 'w16'
    when 7
      assign width_class = 'w14'
    else
      assign width_class = 'w12'
  endcase
  assign img_width_limit = limit
  assign img_width = 100 | divided_by: img_width_limit
-%}
{%- paginate collections by section.settings.pagination_qty -%}
  <div class="all-collections-container section-width-{{ section.settings.width }}">
    <header class="all-collections-header">
      <h1 class="all-collections-heading">{{ 'collection.all_collections' | t }}</h1>
    </header>

    <div class="all-collections-grid">
      {%- for collection in collections -%}
        {%- liquid
          capture current
            cycle 1, 2, 3, 4, 5, 6
          endcapture
          assign collection_img = collection.featured_image | default: collection.image | default: collection.products.first.featured_image
        -%}
        <a href="{{ collection.url }}" class="all-collection-card">
          <div class="all-collection-card-img-box">
            {%- if collection_img != blank -%}
              <img
                src="{{ collection_img | image_url: width: 400 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                class="all-collection-card-img"
              >
            {%- else -%}
              <div class="all-collection-card-placeholder">
                {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          <div class="all-collection-card-content">
            <span class="all-collection-card-title">{{ collection.title }}</span>
            <span class="all-collection-card-accent"></span>
          </div>
        </a>
      {%- endfor -%}
    </div>

    {% render 'pagination',
      paginate: paginate,
      mobile_center: true
    %}
  </div>
{%- endpaginate -%}

<style>
  .all-collections-container {
    padding: 36px 0 48px 0;
  }

  .all-collections-header {
    margin-bottom: 32px;
  }

  .all-collections-heading {
    font-size: 32px !important;
    font-weight: 800 !important;
    color: #0C3E61 !important;
    margin: 0 !important;
    letter-spacing: -0.3px !important;
  }

  .all-collections-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  @media (max-width: 1300px) {
    .all-collections-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (max-width: 1024px) {
    .all-collections-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 768px) {
    .all-collections-container {
      padding: 24px 0 32px 0;
    }
    .all-collections-header {
      margin-bottom: 20px;
    }
    .all-collections-heading {
      font-size: 24px !important;
    }
    .all-collections-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
  }

  @media (max-width: 480px) {
    .all-collections-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  .all-collection-card {
    background: #FFFFFF;
    border: 1.5px solid #F1F5F9;
    border-radius: 20px;
    padding: 24px 16px 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(12, 62, 97, 0.04);
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.28s ease, border-color 0.28s ease;
    min-height: 255px;
    box-sizing: border-box;
    width: 100%;
  }

  .all-collection-card:hover {
    transform: translateY(-8px);
    border-color: #BE982D;
    box-shadow: 0 14px 32px rgba(12, 62, 97, 0.1), 0 4px 12px rgba(190, 152, 45, 0.15);
  }

  .all-collection-card-img-box {
    width: 100%;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    box-sizing: border-box;
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }

  .all-collection-card-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .all-collection-card:hover .all-collection-card-img {
    transform: scale(1.08);
  }

  .all-collection-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .all-collection-card-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: 14px;
  }

  .all-collection-card-title {
    font-size: 15px;
    font-weight: 700;
    color: #0C3E61;
    text-align: center;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 38px;
    transition: color 0.2s ease;
  }

  .all-collection-card:hover .all-collection-card-title {
    color: #BE982D;
  }

  .all-collection-card-accent {
    width: 32px;
    height: 3px;
    background-color: #BE982D;
    border-radius: 2px;
    margin-top: 8px;
    transition: width 0.28s ease, background-color 0.28s ease;
  }

  .all-collection-card:hover .all-collection-card-accent {
    width: 48px;
    background-color: #D4AF37;
  }

  @media (max-width: 480px) {
    .all-collection-card {
      min-height: 200px;
      padding: 14px 10px 12px 10px;
      border-radius: 16px;
    }
    .all-collection-card-img-box {
      height: 95px;
    }
    .all-collection-card-title {
      font-size: 12px;
      height: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "t:main.list_collection.name",
  "tag": "article",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:global.layout.width.label",
      "options": [
        {
          "value": "boxed",
          "label": "t:global.layout.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:global.layout.width.options__2.label"
        }
      ],
      "default": "boxed",
      "visible_if": "{{ settings.width < 2000 }}"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "t:global.typography.title_size.label",
      "options": [
        {
          "value": "h1",
          "label": "t:global.typography.title_size.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.typography.title_size.h2.label"
        },
        {
          "value": "h3",
          "label": "t:global.typography.title_size.h3.label"
        },
        {
          "value": "h4",
          "label": "t:global.typography.title_size.h4.label"
        },
        {
          "value": "h5",
          "label": "t:global.typography.title_size.h5.label"
        }
      ],
      "default": "h1"
    },
    {
      "id": "image_ratio",
      "type": "select",
      "label": "t:main.list_collection.settings.image_ratio.label",
      "options": [
        {
          "value": "portrait",
          "label": "t:main.list_collection.settings.image_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:main.list_collection.settings.image_ratio.options__2.label"
        },
        {
          "value": "landscape",
          "label": "t:main.list_collection.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square"
    },
    {
      "id": "fill_images",
      "type": "checkbox",
      "label": "t:main.list_collection.settings.fill_images.label",
      "default": true
    },
    {
      "type": "range",
      "id": "pagination_qty",
      "label": "t:main.list_collection.settings.pagination_qty.label",
      "min": 12,
      "max": 48,
      "step": 12,
      "default": 48
    },
    {
      "type": "range",
      "id": "number_of_items",
      "label": "t:main.list_collection.settings.number_of_items.label",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    }
  ]
}
{% endschema %}

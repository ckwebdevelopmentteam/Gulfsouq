                </a>
              </div>
            </div>
          </article>
        </li>

        <li class="gs-blog-card-item-{{ section.id }}">
          <article class="gs-blog-card-{{ section.id }}">
            <div class="gs-blog-media-{{ section.id }}">
              <a href="#">
                <img src="//images.unsplash.com/photo-1509358271058-acd22cc93898?w=640&auto=format&fit=crop" alt="Middle Eastern Dates" loading="lazy" width="400" height="270">
              </a>
              <span class="gs-blog-tag-{{ section.id }}">DATES</span>
            </div>
            <div class="gs-blog-body-{{ section.id }}">
              <div class="gs-blog-meta-{{ section.id }}">
                <span class="gs-blog-date-{{ section.id }}">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span>September 18, 2025</span>
                </span>
                <span class="gs-blog-meta-sep-{{ section.id }}">|</span>
                <span class="gs-blog-author-{{ section.id }}">by Mohammed Shafeeq</span>
              </div>
              <h3 class="gs-blog-title-{{ section.id }}">
                <a href="#">Best 10 Middle Eastern Dates Varieties: Premium Quality Guide 2025</a>
              </h3>
              <p class="gs-blog-excerpt-{{ section.id }}">Explore the finest date varieties, their benefits and how to choose the best for you.</p>
              <div class="gs-blog-footer-{{ section.id }}">
                <a href="#" class="gs-blog-readmore-{{ section.id }}">
                  <span>Read More</span>
                  <span class="gs-readmore-arrow-{{ section.id }}">→</span>
                </a>
              </div>
            </div>
          </article>
        </li>
      {% endif %}
    </ul>

    <!-- Optional View All Button -->
    {% if section.settings.show_link and section.settings.link_url != blank %}
      <div class="gs-blog-viewall-wrap-{{ section.id }}">
        <a href="{{ section.settings.link_url }}" class="gs-blog-viewall-btn-{{ section.id }}">
          {{ section.settings.link_text | default: 'View All Articles' }} →
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "tag": "article",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "number_of_items",
      "label": "Number of articles",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Container max width",
      "min": 1200,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1520
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "OUR BLOG"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<h2>Read about Gulf Products</h2>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Stories, guides & insights about authentic Gulf products, culture and more."
    },
    {
      "type": "checkbox",
      "id": "show_diamond_divider",
      "label": "Show diamond divider ornament",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "id": "show_link",
      "type": "checkbox",
      "label": "Show 'View all' button",
      "default": false
    },
    {
      "id": "link_text",
      "type": "text",
      "label": "Button text",
      "default": "View All Articles"
    },
    {
      "id": "link_url",
      "type": "url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Article Display"
    },
    {
      "id": "show_image",
      "type": "checkbox",
      "label": "Show featured image",
      "default": true
    },
    {
      "id": "show_date",
      "type": "checkbox",
      "label": "Show date",
      "default": true
    },
    {
      "id": "show_author",
      "type": "checkbox",
      "label": "Show author",
      "default": true
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "id": "spacing_desktop",
      "type": "range",
      "label": "Spacing desktop",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "id": "spacing_mobile",
      "type": "range",
      "label": "Spacing mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "id": "fix_zindex",
      "type": "range",
      "label": "Z-Index",
      "min": 0,
      "max": 25,
      "step": 1,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Blog posts",
      "settings": {
        "eyebrow": "OUR BLOG",
        "subheading": "Stories, guides & insights about authentic Gulf products, culture and more.",
        "show_diamond_divider": true,
        "show_excerpt": true
      }
    }
  ]
}
{% endschema %}

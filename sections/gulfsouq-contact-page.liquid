{%- liquid
  assign contact_email = shop.email | default: 'hello@gulfsouq.in'
  assign contact_phone = shop.phone
  assign contact_form_id = 'gs-contact-form-' | append: section.id
-%}

<section class="gs-contact-page" aria-labelledby="contact-page-title">
  <div class="gs-contact-page__inner">
    <header class="gs-contact-page__intro">
      <p>Gulf Souq support</p>
      <h1 id="contact-page-title">How can we help?</h1>
      <span>Send us a message and our customer support team will get back to you as soon as possible.</span>
    </header>

    <div class="gs-contact-page__grid">
      <aside class="gs-contact-page__details" aria-label="Contact details">
        <h2>Contact us</h2>
        <p>For orders, delivery updates, products, or any other question, choose the option that works best for you.</p>
        <div class="gs-contact-page__methods">
          <a href="mailto:{{ contact_email }}"><b>Email us</b><small>{{ contact_email }}</small></a>
          {%- if contact_phone != blank -%}<a href="tel:{{ contact_phone | replace: ' ', '' }}"><b>Call us</b><small>{{ contact_phone }}</small></a>{%- endif -%}
          {%- if settings.whatsapp != blank and settings.whatsapp != '0' -%}<a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener"><b>WhatsApp us</b><small>Chat with our support team</small></a>{%- endif -%}
        </div>
        <div class="gs-contact-page__note"><b>Need help with an order?</b><span>Include your order number so we can help you faster.</span></div>
      </aside>

      <div class="gs-contact-page__form-card">
        {%- form 'contact', id: contact_form_id -%}
          {%- if form.posted_successfully? -%}<p class="gs-contact-alert success" role="status">Thank you — your message has been sent. We’ll be in touch soon.</p>
          {%- elsif form.errors -%}<p class="gs-contact-alert error" role="alert">Please check your email address and try again.</p>{%- endif -%}
          <div class="gs-contact-page__form-heading"><h2>Send a message</h2><p>Fields marked * are required.</p></div>
          <div class="gs-contact-page__fields">
            <p><label for="contact-name-{{ section.id }}">Full name *</label><input id="contact-name-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required></p>
            <p><label for="contact-email-{{ section.id }}">Email address *</label><input id="contact-email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required></p>
            <p><label for="contact-phone-{{ section.id }}">Phone number</label><input id="contact-phone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel"></p>
            <p><label for="contact-order-{{ section.id }}">Order number</label><input id="contact-order-{{ section.id }}" type="text" name="contact[order_number]"></p>
            <p class="full"><label for="contact-message-{{ section.id }}">How can we help? *</label><textarea id="contact-message-{{ section.id }}" name="contact[body]" rows="6" required></textarea></p>
          </div>
          <button type="submit">Send message</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .gs-contact-page { padding:56px 20px 76px; background:#fff; color:#103f60; }
  #shopify-section-{{ section.id }} .gs-contact-page__inner { width:min(1120px,100%); margin:auto; }
  #shopify-section-{{ section.id }} .gs-contact-page__intro { max-width:630px; margin:0 auto 38px; text-align:center; }
  #shopify-section-{{ section.id }} .gs-contact-page__intro > p { margin:0 0 8px; color:#ad8730; font-size:12px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  #shopify-section-{{ section.id }} .gs-contact-page__intro h1 { margin:0; color:#103f60; font-size:clamp(30px,4vw,46px); line-height:1.1; letter-spacing:-.03em; }
  #shopify-section-{{ section.id }} .gs-contact-page__intro span { display:block; margin-top:14px; color:#5d7185; font-size:16px; line-height:1.65; }
  #shopify-section-{{ section.id }} .gs-contact-page__grid { display:grid; grid-template-columns:minmax(260px,.85fr) minmax(0,1.15fr); overflow:hidden; border:1px solid #dbe5ee; border-radius:18px; box-shadow:0 14px 38px rgba(16,63,96,.09); }
  #shopify-section-{{ section.id }} .gs-contact-page__details { padding:40px; background:#f4f8fb; }
  #shopify-section-{{ section.id }} .gs-contact-page h2 { margin:0; color:#103f60; font-size:24px; line-height:1.2; }
  #shopify-section-{{ section.id }} .gs-contact-page__details > p { margin:12px 0 26px; color:#5d7185; line-height:1.6; }
  #shopify-section-{{ section.id }} .gs-contact-page__methods { display:grid; gap:10px; }
  #shopify-section-{{ section.id }} .gs-contact-page__methods a { display:block; padding:13px 14px; border-left:3px solid #ad8730; border-radius:0 8px 8px 0; background:#fff; color:#103f60; text-decoration:none; transition:transform .2s,background .2s; }
  #shopify-section-{{ section.id }} .gs-contact-page__methods a:hover { background:#fff8e9; transform:translateX(2px); }
  #shopify-section-{{ section.id }} .gs-contact-page__methods b, #shopify-section-{{ section.id }} .gs-contact-page__methods small { display:block; }
  #shopify-section-{{ section.id }} .gs-contact-page__methods b { font-size:14px; }
  #shopify-section-{{ section.id }} .gs-contact-page__methods small { margin-top:3px; color:#637a90; font-size:13px; }
  #shopify-section-{{ section.id }} .gs-contact-page__note { display:grid; gap:4px; margin-top:30px; color:#597187; font-size:13px; line-height:1.5; }
  #shopify-section-{{ section.id }} .gs-contact-page__note b { color:#103f60; }
  #shopify-section-{{ section.id }} .gs-contact-page__form-card { padding:40px; }
  #shopify-section-{{ section.id }} .gs-contact-page__form-heading { display:flex; align-items:baseline; justify-content:space-between; gap:16px; margin-bottom:25px; }
  #shopify-section-{{ section.id }} .gs-contact-page__form-heading p { margin:0; color:#71859a; font-size:12px; }
  #shopify-section-{{ section.id }} .gs-contact-page__fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
  #shopify-section-{{ section.id }} .gs-contact-page__fields p { margin:0; }
  #shopify-section-{{ section.id }} .gs-contact-page__fields .full { grid-column:1 / -1; }
  #shopify-section-{{ section.id }} .gs-contact-page label { display:block; margin-bottom:7px; color:#234f70; font-size:13px; font-weight:700; }
  #shopify-section-{{ section.id }} .gs-contact-page input, #shopify-section-{{ section.id }} .gs-contact-page textarea { box-sizing:border-box; width:100%; border:1px solid #cfdce7; border-radius:8px; background:#fff; color:#103f60; font:inherit; outline:0; transition:border-color .18s,box-shadow .18s; }
  #shopify-section-{{ section.id }} .gs-contact-page input { height:46px; padding:0 13px; }
  #shopify-section-{{ section.id }} .gs-contact-page textarea { min-height:130px; padding:12px 13px; resize:vertical; }
  #shopify-section-{{ section.id }} .gs-contact-page input:focus, #shopify-section-{{ section.id }} .gs-contact-page textarea:focus { border-color:#ad8730; box-shadow:0 0 0 3px rgba(173,135,48,.15); }
  #shopify-section-{{ section.id }} .gs-contact-page button { display:inline-flex; align-items:center; justify-content:center; min-height:48px; margin-top:24px; padding:0 24px; border:0; border-radius:8px; background:#103f60; box-shadow:none; color:#fff; font:inherit; font-weight:800; cursor:pointer; }
  #shopify-section-{{ section.id }} .gs-contact-page button::before, #shopify-section-{{ section.id }} .gs-contact-page button::after { display:none !important; content:none !important; }
  #shopify-section-{{ section.id }} .gs-contact-page button:hover { background:#0a314d; }
  #shopify-section-{{ section.id }} .gs-contact-alert { margin:0 0 20px; padding:12px 14px; border-radius:8px; font-size:14px; }
  #shopify-section-{{ section.id }} .gs-contact-alert.success { background:#eaf7ef; color:#17663a; } #shopify-section-{{ section.id }} .gs-contact-alert.error { background:#fff0f0; color:#a93232; }
  @media (max-width:760px) { #shopify-section-{{ section.id }} .gs-contact-page { padding:34px 16px 48px; } #shopify-section-{{ section.id }} .gs-contact-page__intro { margin-bottom:26px; } #shopify-section-{{ section.id }} .gs-contact-page__grid { grid-template-columns:1fr; border-radius:14px; } #shopify-section-{{ section.id }} .gs-contact-page__details, #shopify-section-{{ section.id }} .gs-contact-page__form-card { padding:26px 20px; } #shopify-section-{{ section.id }} .gs-contact-page__fields { grid-template-columns:1fr; gap:15px; } #shopify-section-{{ section.id }} .gs-contact-page__fields .full { grid-column:auto; } #shopify-section-{{ section.id }} .gs-contact-page__form-heading { display:block; margin-bottom:22px; } #shopify-section-{{ section.id }} .gs-contact-page__form-heading p { margin-top:6px; } #shopify-section-{{ section.id }} .gs-contact-page button { width:100%; } }
</style>

{% schema %}
{"name":"Gulf Souq contact page","tag":"div","class":"shopify-section-gulfsouq-contact-page","settings":[],"presets":[{"name":"Gulf Souq contact page"}]}
{% endschema %}

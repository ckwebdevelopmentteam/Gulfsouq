<script>
  (function() {
    function initGulfSouqHeader() {
      // 1. Centered Search Modal Logic with Predictive Live Search
      const searchModal = document.getElementById('gs-search-modal');
      const searchModalBackdrop = document.getElementById('gs-search-modal-backdrop');
      const searchModalCloseBtn = document.getElementById('gs-modal-close-btn');
      const searchModalInput = document.getElementById('gs-modal-search-input');
      const searchModalGrid = document.getElementById('gs-modal-products-grid');
      const searchModalTitle = document.getElementById('gs-modal-section-title');
      const searchModalLoading = document.getElementById('gs-modal-loading');
      const searchModalEmpty = document.getElementById('gs-modal-empty');
      const searchTriggers = document.querySelectorAll('.gs-desktop-search-btn, .gs-mobile-search-btn, .gs-search-trigger-btn, [aria-controls="gs-search-dropdown"], [aria-controls="gs-search-modal"]');

      let initialProductsHTML = searchModalGrid ? searchModalGrid.innerHTML : '';
      let searchDebounceTimer = null;

      function openSearchModal() {
        if (!searchModal) return;
        searchModal.classList.add('active');
        document.body.style.overflow = 'hidden';
        if (searchModalInput) {
          setTimeout(() => {
            searchModalInput.focus();
            searchModalInput.select();
          }, 150);
        }
      }

      function closeSearchModal() {
        if (!searchModal) return;
        searchModal.classList.remove('active');
        document.body.style.overflow = '';
      }

      searchTriggers.forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          openSearchModal();
        });
      });

      if (searchModalBackdrop) {
        searchModalBackdrop.addEventListener('click', function(e) {
          e.preventDefault();
          closeSearchModal();
        });
      }

      if (searchModalCloseBtn) {
        searchModalCloseBtn.addEventListener('click', function(e) {
          e.preventDefault();
          closeSearchModal();
        });
      }

      // Live Predictive Search
      if (searchModalInput) {
        searchModalInput.addEventListener('input', function() {
          const query = this.value.trim();
          clearTimeout(searchDebounceTimer);

          if (!query) {
            if (searchModalTitle) searchModalTitle.textContent = 'Products';
            if (searchModalGrid) {
              searchModalGrid.innerHTML = initialProductsHTML;
              searchModalGrid.style.display = 'grid';
            }
            if (searchModalEmpty) searchModalEmpty.style.display = 'none';
            if (searchModalLoading) searchModalLoading.style.display = 'none';
            return;
          }

          if (searchModalLoading) searchModalLoading.style.display = 'flex';
          if (searchModalEmpty) searchModalEmpty.style.display = 'none';
          if (searchModalGrid) searchModalGrid.style.display = 'none';

          searchDebounceTimer = setTimeout(() => {
            fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=4&resources[options][unavailable_products]=hide`)
              .then(res => res.json())
              .then(data => {
                if (searchModalLoading) searchModalLoading.style.display = 'none';
                const products = data?.resources?.results?.products || [];

                if (products.length > 0 && searchModalGrid) {
                  if (searchModalTitle) searchModalTitle.textContent = `Products (${products.length})`;
                  if (searchModalEmpty) searchModalEmpty.style.display = 'none';
                  searchModalGrid.style.display = 'grid';

                  searchModalGrid.innerHTML = products.map(prod => {
                    const imgUrl = prod.featured_image?.url || prod.image || '';
                    const comparePriceVal = parseFloat(prod.compare_at_price_max || prod.compare_at_price || 0);
                    const priceVal = parseFloat(prod.price || 0);
                    const formattedCompare = comparePriceVal % 1 === 0 ? Math.round(comparePriceVal).toLocaleString('en-IN') : comparePriceVal.toFixed(2);
                    const formattedPrice = priceVal % 1 === 0 ? Math.round(priceVal).toLocaleString('en-IN') : priceVal.toFixed(2);
                    const comparePriceHtml = comparePriceVal > priceVal 
                      ? `<span class="gs-modal-price-compare">Rs. ${formattedCompare}</span>` 
                      : '';
                    const priceHtml = `<span class="gs-modal-price-regular">Rs. ${formattedPrice}</span>`;

                    return `
                      <a href="${prod.url}" class="gs-modal-product-card">
                        <div class="gs-modal-product-img-wrap">
                          ${imgUrl ? `<img src="${imgUrl}" alt="${prod.title}" loading="lazy" width="120" height="120" />` : ''}
                        </div>
                        <div class="gs-modal-product-info">
                          <div class="gs-modal-product-title">${prod.title}</div>
                          <div class="gs-modal-product-pricing">
                            ${comparePriceHtml}
                            ${priceHtml}
                          </div>
                        </div>
                      </a>
                    `;
                  }).join('');
                } else {
                  if (searchModalTitle) searchModalTitle.textContent = 'Products';
                  if (searchModalGrid) searchModalGrid.style.display = 'none';
                  if (searchModalEmpty) searchModalEmpty.style.display = 'block';
                }
              })
              .catch(err => {
                console.error('Search query error:', err);
                if (searchModalLoading) searchModalLoading.style.display = 'none';
                if (searchModalGrid) searchModalGrid.style.display = 'grid';
              });
          }, 250);
        });
      }

      // 2. Mobile Drawer Toggle & Accordion
      const mobileToggle = document.querySelector('.gs-mobile-toggle-btn');
      const mobileDrawer = document.getElementById('gs-mobile-drawer');
      const drawerClose = document.querySelector('.gs-mobile-drawer-close');
      const drawerBackdrop = document.querySelector('.gs-mobile-drawer-backdrop');

      function openDrawer() {
        if (mobileDrawer) mobileDrawer.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        if (mobileDrawer) mobileDrawer.classList.remove('active');
        document.body.style.overflow = '';
      }

      if (mobileToggle) {
        mobileToggle.addEventListener('click', function(e) {
          e.preventDefault();
          openDrawer();
        });
      }

      if (drawerClose) {
        drawerClose.addEventListener('click', function(e) {
          e.preventDefault();
          closeDrawer();
        });
      }

      if (drawerBackdrop) {
        drawerBackdrop.addEventListener('click', function(e) {
          e.preventDefault();
          closeDrawer();
        });
      }

      // Submenu accordion toggles
      const sublinkToggles = document.querySelectorAll('.gs-mobile-sublink-toggle');
      sublinkToggles.forEach(toggle => {
        toggle.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const parentItem = this.closest('.gs-mobile-link-item');
          if (parentItem) {
            parentItem.classList.toggle('open');
          }
        });
      });

      // 3. Login / Register / Recover Modal Dropdown Toggle & View Switching
      const loginTrigger = document.querySelector('.gs-login-modal-trigger');
      const loginDropdown = document.getElementById('gs-login-modal-dropdown');

      function switchAuthPane(targetPaneName) {
        if (!loginDropdown) return;
        const allPanes = loginDropdown.querySelectorAll('.gs-auth-pane');
        allPanes.forEach(pane => pane.classList.remove('is-active'));
        const targetPane = loginDropdown.querySelector('#gs-pane-' + targetPaneName);
        if (targetPane) {
          targetPane.classList.add('is-active');
          const firstInput = targetPane.querySelector('input:not([type="hidden"])');
          if (firstInput) {
            setTimeout(() => firstInput.focus(), 80);
          }
        }
      }

      function openLoginModal(viewName = 'login') {
        if (!loginDropdown) return;
        switchAuthPane(viewName);
        loginDropdown.classList.add('is-active');
        if (loginTrigger) loginTrigger.setAttribute('aria-expanded', 'true');
      }

      function closeLoginModal() {
        if (!loginDropdown) return;
        loginDropdown.classList.remove('is-active');
        if (loginTrigger) loginTrigger.setAttribute('aria-expanded', 'false');
      }

      if (loginTrigger) {
        loginTrigger.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (loginDropdown && loginDropdown.classList.contains('is-active')) {
            closeLoginModal();
          } else {
            closeSearchModal();
            closeDrawer();
            openLoginModal('login');
          }
        });
      }

      // Switch pane triggers (e.g. "Create account", "Sign In", "Forgot password?")
      if (loginDropdown) {
        const switchButtons = loginDropdown.querySelectorAll('.gs-switch-view-trigger');
        switchButtons.forEach(btn => {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const target = this.getAttribute('data-switch-to');
            if (target) {
              switchAuthPane(target);
            }
          });
        });

        // Close buttons on all panes
        const closeBtns = loginDropdown.querySelectorAll('.gs-login-modal-close');
        closeBtns.forEach(btn => {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            closeLoginModal();
          });
        });
      }

      // Close when clicking outside of dropdown
      document.addEventListener('click', function(e) {
        if (loginDropdown && loginDropdown.classList.contains('is-active')) {
          if (!loginDropdown.contains(e.target) && !loginTrigger.contains(e.target)) {
            closeLoginModal();
          }
        }
      });

      // 4. Scroll Listener to Lock Header to Top (Leaves Announcement Bar to scroll away naturally)
      const headerSection = document.querySelector('.gs-header-section');
      const headerWrapper = document.querySelector('.gs-header-wrapper');
      const annBar = document.querySelector('.gs-announcement-bar');

      function handleHeaderScroll() {
        if (!headerSection || !headerWrapper) return;
        const scrollTop = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
        const triggerPoint = (annBar && annBar.offsetHeight > 0) ? annBar.offsetHeight : 34;

        if (scrollTop > triggerPoint) {
          if (!headerSection.classList.contains('is-fixed')) {
            headerWrapper.style.minHeight = headerWrapper.offsetHeight + 'px';
            headerSection.classList.add('is-fixed');
          }
        } else {
          if (headerSection.classList.contains('is-fixed')) {
            headerSection.classList.remove('is-fixed');
            headerWrapper.style.minHeight = '';
          }
        }
      }

      window.addEventListener('scroll', handleHeaderScroll, { passive: true });
      document.addEventListener('scroll', handleHeaderScroll, { passive: true });
      window.addEventListener('resize', handleHeaderScroll, { passive: true });
      handleHeaderScroll();

      // Close on escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeSearchModal();
          closeDrawer();
          closeLoginModal();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGulfSouqHeader);
    } else {
      initGulfSouqHeader();
    }
  })();
</script>


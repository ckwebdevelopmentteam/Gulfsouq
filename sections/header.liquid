  /* Hot Deals Flame Tag in Sub-Nav */
  #nav-bar a.btn-deals-tag,
  #nav-outer a.btn-deals-tag {
    background: #FEF2F2 !important;
    color: #EF4444 !important;
    border: 1px solid #FCA5A5 !important;
    padding: 5px 12px !important;
    border-radius: 18px !important;
    font-weight: 800 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
  }

  /* Header Right Icons & Account Container Transparent Background */
  #nav-user,
  #nav-user ul,
  #nav-user li,
  #nav-user a,
  #nav-user span,
  #nav-user .l4ca,
  #nav-user .l4ca li,
  #nav-user .l4ca a,
  [data-type="user-nav"],
  [data-type="user-nav"] a,
  [data-type="user-nav"] li {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
  }

  .shopify-section-group-header-group:empty,
  .shopify-section-announcement-bar:empty,
  .shopify-section-announcement-bar-container:empty {
    display: none !important;
    height: 0 !important;
  }

  .shopify-section-header:before,
  .shopify-section-header:after,
  #header-outer:before,
  #header-outer:after,
  #header:before,
  #header:after,
  #header-inner:before,
  #header-inner:after,
  .shopify-section-group-header-group:before,
  .shopify-section-group-header-group:after,
  #nav:before,
  #nav:after,
  #nav-bar:before,
  #nav-bar:after,
  #nav-outer:before,
  #nav-outer:after,
  .nav-main:before,
  .nav-main:after,
  #nav.plain:before,
  #nav.plain:after,
  #nav-bar.plain:before,

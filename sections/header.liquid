<script>
  (function() {
    function relocateNavToBody() {
      const nav = document.querySelector('#nav');
      if (nav && nav.parentElement !== document.body) {
        document.body.appendChild(nav);
      }
      const searchOverlay = document.querySelector('#gs-search-overlay');
      if (searchOverlay && searchOverlay.parentElement !== document.body) {
        document.body.appendChild(searchOverlay);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', relocateNavToBody);
    } else {
      relocateNavToBody();
    }

    function forceCloseDrawer() {
      document.documentElement.classList.remove('nav-active', 'menu-open', 'nav-open', 'mobile-nav-open');
      document.body.classList.remove('nav-active', 'menu-open', 'nav-open', 'mobile-nav-open');
      const navEls = document.querySelectorAll('#nav, #nav-outer, nav#nav');
      navEls.forEach(function(el) {
        el.classList.remove('active', 'opened', 'open');
      });
    }

    function forceOpenDrawer() {
      document.documentElement.classList.add('nav-active', 'menu-open');
      document.body.classList.add('nav-active', 'menu-open');
      const nav = document.querySelector('#nav');
      if (nav) {
        nav.classList.add('active', 'opened', 'open');
      }
    }

    function isDrawerActive() {
      const nav = document.querySelector('#nav');
      return (
        document.documentElement.classList.contains('nav-active') ||
        document.body.classList.contains('nav-active') ||
        document.body.classList.contains('menu-open') ||
        (nav && (nav.classList.contains('active') || nav.classList.contains('opened')))
      );
    }

    function closeSearchOverlay() {
      document.body.classList.remove('gs-search-active');
      document.documentElement.classList.remove('gs-search-active');
    }

    function openSearchOverlay() {
      forceCloseDrawer();
      document.body.classList.add('gs-search-active');
      document.documentElement.classList.add('gs-search-active');
      const input = document.querySelector('.gs-search-input');
      if (input) {
        setTimeout(function() { input.focus(); }, 100);
      }
    }

    // Unified click listener for Search, Mobile Hamburger, & Close Actions
    document.addEventListener('click', function(e) {
      const searchBtn = e.target.closest('.gs-search-btn, a[href*="search"], [aria-controls="search"], .icon-zoom');
      const searchCloseBtn = e.target.closest('.gs-search-close-btn');
      const searchOverlay = document.querySelector('#gs-search-overlay');

      // 1. Search Icon Tapped -> Open Interactive Search Overlay
      if (searchBtn && !e.target.closest('#gs-search-overlay')) {
        e.preventDefault();
        e.stopPropagation();
        if (document.body.classList.contains('gs-search-active')) {
          closeSearchOverlay();
        } else {
          openSearchOverlay();
        }
        return;
      }

      // 2. Search Close Button Tapped
      if (searchCloseBtn) {
        e.preventDefault();
        e.stopPropagation();
        closeSearchOverlay();
        return;
      }

      // 3. Tapped outside search overlay
      if (document.body.classList.contains('gs-search-active') && searchOverlay && !searchOverlay.contains(e.target)) {
        closeSearchOverlay();
      }

      const nav = document.querySelector('#nav');
      const toggleBtn = e.target.closest('#header-inner > a.toggle, .header-menu-toggle, [aria-controls="nav"], .nav-toggle, .m6s-toggle');
      const closeBtn = e.target.closest('.gs-sidebar-close-btn, .close-nav, #nav .close, .overlay-close');

      // Hamburger button tap: toggle menu open/close
      if (toggleBtn && nav && !nav.contains(toggleBtn)) {
        e.preventDefault();
        e.stopPropagation();
        closeSearchOverlay();
        if (isDrawerActive()) {
          forceCloseDrawer();
        } else {
          forceOpenDrawer();
        }
        return;
      }

      // Close button tap: close menu
      if (closeBtn) {
        e.preventDefault();
        e.stopPropagation();
        forceCloseDrawer();
        return;
      }

      // Tap outside drawer: close menu
      if (isDrawerActive() && nav && !nav.contains(e.target)) {
        forceCloseDrawer();
      }
    }, true);
  })();
</script>


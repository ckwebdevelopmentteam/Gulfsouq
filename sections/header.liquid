{% comment %}
  Gulf Souq — Header with Top Gold Announcement Banner & Navy Navigation Bar
  Colors:
    - Announcement Banner: #ad8730 (Rich Gold) with white text & plain arrows (no bg, no border, no animation)
    - Main Header: #103f60 (Gulf Souq Navy) with white text & white action icons
    - Logo: Compact Gulf Souq Logo + Search Icon directly beside it
    - Center: Navigation Menu Links (Shop by categories, Shop By Brands, Shop All, etc.)
    - Right: Account Icon + Shopping Cart with gold badge count
{% endcomment %}

<div class="gs-header-wrapper" id="gs-header-wrapper-{{ section.id }}">

  <!-- 1. TOP GOLD ANNOUNCEMENT BANNER (#ad8730 - Not fixed, scrolls away) -->
  {%- if section.settings.show_announcement_bar -%}
    <div class="gs-announcement-bar" id="gs-announcement-bar">
      <div class="gs-announcement-container">
        
        <!-- Plain Previous Arrow (Span role="button", NO white background, NO border, NO animation) -->
        <span role="button" tabindex="0" class="gs-ann-arrow-btn gs-ann-prev" aria-label="Previous announcement">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </span>

        <!-- Centered Announcement Text -->
        <div class="gs-announcement-content-wrap">
          <span class="gs-ann-text" id="gs-ann-text">{{ section.settings.announcement_text | default: 'Shop our latest arrivals' }}</span>
        </div>

        <!-- Plain Next Arrow (Span role="button", NO white background, NO border, NO animation) -->
        <span role="button" tabindex="0" class="gs-ann-arrow-btn gs-ann-next" aria-label="Next announcement">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>

      </div>
    </div>
  {%- endif -%}

  <!-- 2. MAIN NAVY NAVIGATION HEADER (#103f60 - Fixed/Sticky at top) -->
  <header class="gs-header-section {% if section.settings.enable_sticky_header %}gs-sticky-header{% endif %}" id="gs-header-section-{{ section.id }}">
    <div class="gs-header-container">
      
      <!-- LEFT ZONE: Desktop (Logo) / Mobile (Hamburger + Search Icon) -->
      <div class="gs-header-left">
        
        <!-- Mobile Hamburger Toggle (Hidden on Desktop) -->
        <span role="button" tabindex="0" class="gs-mobile-toggle-btn" aria-label="Open Navigation Menu" aria-controls="gs-mobile-drawer">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </span>

        <!-- Mobile Search Icon Trigger (Hidden on Desktop) -->
        <span role="button" tabindex="0" class="gs-mobile-search-btn gs-search-trigger-btn" aria-label="Search" aria-controls="gs-search-dropdown">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>

        <!-- Desktop Logo (Hidden on Mobile) -->
        <div class="gs-desktop-logo-wrap">
          <a href="{{ routes.root_url }}" class="gs-logo-link" aria-label="{{ shop.name }}">
            {%- if settings.logo -%}
              <img 
                src="{{ settings.logo | image_url: width: 260 }}" 
                alt="{{ settings.logo.alt | default: shop.name | escape }}"
                class="gs-logo-img"
                width="{{ settings.logo_width | default: 120 }}"
                height="auto"
                loading="eager"
              >
            {%- elsif settings.mobile_logo -%}
              <img 
                src="{{ settings.mobile_logo | image_url: width: 260 }}" 
                alt="{{ shop.name | escape }}"
                class="gs-logo-img"
                width="{{ settings.logo_width | default: 120 }}"
                height="auto"
                loading="eager"
              >
            {%- else -%}
              <span class="gs-logo-text">GULF SOUQ</span>
            {%- endif -%}
          </a>
        </div>

      </div>

      <!-- CENTER ZONE: Desktop (Nav Menu) / Mobile (Centered Logo) -->
      <div class="gs-header-center">
        
        <!-- Desktop Nav Links (Hidden on Mobile) -->
        <nav class="gs-desktop-nav" aria-label="Main Navigation">
          {%- assign nav_menu_handle = section.settings.menubar_menu | default: 'main-menu' -%}
          {%- assign main_nav_links = linklists[nav_menu_handle].links -%}

          <ul class="gs-nav-list">
            {%- if main_nav_links.size > 0 -%}
              {%- for link in main_nav_links -%}
                <li class="gs-nav-item {% if link.links.size > 0 %}has-dropdown{% endif %}">
                  <a href="{{ link.url }}" class="gs-nav-link {% if link.active %}active{% endif %}">
                    <span>{{ link.title }}</span>
                    {%- if link.links.size > 0 -%}
                      <svg class="gs-dropdown-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    {%- endif -%}
                  </a>

                  {%- if link.links.size > 0 -%}
                    <ul class="gs-dropdown-menu">
                      {%- for child_link in link.links -%}
                        <li class="gs-dropdown-item">
                          <a href="{{ child_link.url }}" class="gs-dropdown-link">
                            {{ child_link.title }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- else -%}
              <li class="gs-nav-item has-dropdown">
                <a href="/collections/all" class="gs-nav-link">
                  <span>Shop by categories</span>
                  <svg class="gs-dropdown-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </a>
                <ul class="gs-dropdown-menu">
                  <li class="gs-dropdown-item"><a href="/collections/dates" class="gs-dropdown-link">Handpicked Dates</a></li>
                  <li class="gs-dropdown-item"><a href="/collections/athar-and-perfume" class="gs-dropdown-link">Perfumes & Attar</a></li>
                  <li class="gs-dropdown-item"><a href="/collections/chocolates" class="gs-dropdown-link">Chocolates</a></li>
                  <li class="gs-dropdown-item"><a href="/collections/nuts-and-dry-fruits" class="gs-dropdown-link">Nuts & Dry Fruits</a></li>
                  <li class="gs-dropdown-item"><a href="/collections/gift-hamper-boxes" class="gs-dropdown-link">Gift Hampers</a></li>
                </ul>
              </li>
              <li class="gs-nav-item">
                <a href="/collections/all" class="gs-nav-link"><span>Shop By Brands</span></a>
              </li>
              <li class="gs-nav-item">
                <a href="/collections/all" class="gs-nav-link"><span>Shop All</span></a>
              </li>
              <li class="gs-nav-item">
                <a href="/collections/chocolates" class="gs-nav-link"><span>Chocolates</span></a>
              </li>
              <li class="gs-nav-item">
                <a href="/collections/athar-and-perfume" class="gs-nav-link"><span>Perfumes</span></a>
              </li>
              <li class="gs-nav-item">
                <a href="/collections/offers" class="gs-nav-link"><span>Big Offers</span></a>
              </li>
              <li class="gs-nav-item">
                <a href="/pages/about-us" class="gs-nav-link"><span>About</span></a>
              </li>
              <li class="gs-nav-item">
                <a href="/pages/contact" class="gs-nav-link"><span>Contact</span></a>
              </li>
              <li class="gs-nav-item">
                <a href="/pages/faq" class="gs-nav-link"><span>FAQs</span></a>
              </li>
            {%- endif -%}
          </ul>
        </nav>

        <!-- Mobile Centered Logo (Hidden on Desktop) -->
        <div class="gs-mobile-center-logo">
          <a href="{{ routes.root_url }}" class="gs-logo-link" aria-label="{{ shop.name }}">
            {%- if settings.mobile_logo -%}
              <img 
                src="{{ settings.mobile_logo | image_url: width: 260 }}" 
                alt="{{ shop.name | escape }}"
                class="gs-logo-img"
                width="{{ settings.logo_width | default: 120 }}"
                height="auto"
                loading="eager"
              >
            {%- elsif settings.logo -%}
              <img 
                src="{{ settings.logo | image_url: width: 260 }}" 
                alt="{{ settings.logo.alt | default: shop.name | escape }}"
                class="gs-logo-img"
                width="{{ settings.logo_width | default: 120 }}"
                height="auto"
                loading="eager"
              >
            {%- else -%}
              <span class="gs-logo-text">GULF SOUQ</span>
            {%- endif -%}
          </a>
        </div>

      </div>

      <!-- RIGHT ZONE: Desktop (Search + Account + Cart) / Mobile (Account + Cart) -->
      <div class="gs-header-right">
        
        <!-- Desktop Search Icon Trigger (Hidden on Mobile) -->
        <span role="button" tabindex="0" class="gs-desktop-search-btn gs-desktop-only gs-search-trigger-btn" aria-label="Search" aria-controls="gs-search-dropdown">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>

        <!-- Account Icon & Login Dropdown Modal -->
        {%- if shop.customer_accounts_enabled -%}
          <div class="gs-account-wrapper">
            <a 
              href="{% if customer %}{{ routes.account_url }}{% else %}#login{% endif %}" 
              class="gs-action-icon-btn gs-account-btn {% unless customer %}gs-login-modal-trigger{% endunless %}" 
              id="gs-account-trigger"
              aria-label="{% if customer %}My Account{% else %}Login{% endif %}"
              {% unless customer %}aria-expanded="false" role="button"{% endunless %}
            >
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </a>            {%- unless customer -%}
              <!-- AUTH DROPDOWN MODAL (Login, Register, Recover in-place) -->
              <div class="gs-login-modal-dropdown" id="gs-login-modal-dropdown" role="dialog" aria-modal="true" aria-label="Customer Authentication">
                <div class="gs-login-modal-arrow"></div>
                <div class="gs-login-modal-inner">
                  
                  <!-- 1. LOGIN PANE -->
                  <div class="gs-auth-pane is-active" id="gs-pane-login">
                    <div class="gs-login-modal-header">
                      <h3 class="gs-login-modal-title">Login</h3>
                      <button type="button" class="gs-login-modal-close" aria-label="Close popup">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                      </button>
                    </div>

                    {%- form 'customer_login', id: 'gs-header-login-form', class: 'gs-header-login-form' -%}
                      <input type="hidden" name="return_to" value="back">

                      {%- if form.errors -%}
                        <div class="gs-login-error-msg">
                          {{ form.errors | default_errors }}
                        </div>
                      {%- endif -%}

                      <div class="gs-login-field-group">
                        <label for="gs-login-email" class="gs-login-label">Email</label>
                        <input 
                          type="email" 
                          name="customer[email]" 
                          id="gs-login-email" 
                          class="gs-login-input" 
                          placeholder="Email" 
                          autocomplete="email"
                          required
                        >
                      </div>

                      <div class="gs-login-field-group">
                        <div class="gs-login-label-row">
                          <label for="gs-login-password" class="gs-login-label">Password</label>
                        </div>
                        <input 
                          type="password" 
                          name="customer[password]" 
                          id="gs-login-password" 
                          class="gs-login-input" 
                          placeholder="Password" 
                          autocomplete="current-password"
                          required
                        >
                      </div>

                      <div class="gs-login-forgot-row">
                        <a href="#recover" class="gs-login-forgot-link gs-switch-view-trigger" data-switch-to="recover">Forgot password?</a>
                      </div>

                      <button type="submit" class="gs-login-btn">
                        <span>Sign In</span>
                      </button>

                      <div class="gs-login-footer">
                        <p class="gs-login-register-prompt">
                          Don't have an account yet?
                          <a href="#register" class="gs-login-register-link gs-switch-view-trigger" data-switch-to="register">Create account</a>
                        </p>
                      </div>
                    {%- endform -%}
                  </div>

                  <!-- 2. REGISTER / CREATE ACCOUNT PANE -->
                  <div class="gs-auth-pane" id="gs-pane-register">
                    <div class="gs-login-modal-header">
                      <h3 class="gs-login-modal-title">Create Account</h3>
                      <button type="button" class="gs-login-modal-close" aria-label="Close popup">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                      </button>
                    </div>

                    {%- form 'create_customer', id: 'gs-header-register-form', class: 'gs-header-login-form' -%}
                      <input type="hidden" name="return_to" value="back">

                      {%- if form.errors -%}
                        <div class="gs-login-error-msg">
                          {{ form.errors | default_errors }}
                        </div>
                      {%- endif -%}

                      <div class="gs-login-field-row">
                        <div class="gs-login-field-group gs-field-half">
                          <label for="gs-reg-first-name" class="gs-login-label">First Name</label>
                          <input 
                            type="text" 
                            name="customer[first_name]" 
                            id="gs-reg-first-name" 
                            class="gs-login-input" 
                            placeholder="First Name" 
                            autocomplete="given-name"
                            required
                          >
                        </div>
                        <div class="gs-login-field-group gs-field-half">
                          <label for="gs-reg-last-name" class="gs-login-label">Last Name</label>
                          <input 
                            type="text" 
                            name="customer[last_name]" 
                            id="gs-reg-last-name" 
                            class="gs-login-input" 
                            placeholder="Last Name" 
                            autocomplete="family-name"
                            required
                          >
                        </div>
                      </div>

                      <div class="gs-login-field-group">
                        <label for="gs-reg-email" class="gs-login-label">Email</label>
                        <input 
                          type="email" 
                          name="customer[email]" 
                          id="gs-reg-email" 
                          class="gs-login-input" 
                          placeholder="Email" 
                          autocomplete="email"
                          required
                        >
                      </div>

                      <div class="gs-login-field-group">
                        <label for="gs-reg-password" class="gs-login-label">Password</label>
                        <input 
                          type="password" 
                          name="customer[password]" 
                          id="gs-reg-password" 
                          class="gs-login-input" 
                          placeholder="Password" 
                          autocomplete="new-password"
                          required
                        >
                      </div>

                      <button type="submit" class="gs-login-btn">
                        <span>Create Account</span>
                      </button>

                      <div class="gs-login-footer">
                        <p class="gs-login-register-prompt">
                          Already have an account?
                          <a href="#login" class="gs-login-register-link gs-switch-view-trigger" data-switch-to="login">Sign In</a>
                        </p>
                      </div>
                    {%- endform -%}
                  </div>

                  <!-- 3. RECOVER PASSWORD PANE -->
                  <div class="gs-auth-pane" id="gs-pane-recover">
                    <div class="gs-login-modal-header">
                      <h3 class="gs-login-modal-title">Reset Password</h3>
                      <button type="button" class="gs-login-modal-close" aria-label="Close popup">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                      </button>
                    </div>

                    <p class="gs-recover-info-text">Enter your email and we'll send you instructions to reset your password.</p>

                    {%- form 'recover_customer_password', id: 'gs-header-recover-form', class: 'gs-header-login-form' -%}
                      {%- if form.errors -%}
                        <div class="gs-login-error-msg">
                          {{ form.errors | default_errors }}
                        </div>
                      {%- endif -%}

                      <div class="gs-login-field-group">
                        <label for="gs-rec-email" class="gs-login-label">Email</label>
                        <input 
                          type="email" 
                          name="email" 
                          id="gs-rec-email" 
                          class="gs-login-input" 
                          placeholder="Email" 
                          autocomplete="email"
                          required
                        >
                      </div>

                      <button type="submit" class="gs-login-btn">
                        <span>Submit</span>
                      </button>

                      <div class="gs-login-footer">
                        <p class="gs-login-register-prompt">
                          Remember your password?
                          <a href="#login" class="gs-login-register-link gs-switch-view-trigger" data-switch-to="login">Sign In</a>
                        </p>
                      </div>
                    {%- endform -%}
                  </div>

                </div>
              </div>
            {%- endunless -%}
          </div>
        {%- endif -%}

        <!-- Cart Icon -->
        <a 
          href="{{ routes.cart_url }}" 
          class="gs-action-icon-btn gs-cart-btn" 
          {% if settings.enable_cart_drawer %}data-panel="cart"{% endif %} 
          aria-label="Shopping Cart"
        >
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="gs-cart-count-badge" id="cart-count">{{ cart.item_count }}</span>
        </a>

      </div>

    </div>

    <!-- 3. SEARCH MODAL POPUP (Dynamic Predictive Search) -->
    <div class="gs-search-modal" id="gs-search-modal" role="dialog" aria-modal="true" aria-label="Search products">
      <div class="gs-search-modal-backdrop" id="gs-search-modal-backdrop"></div>
      <div class="gs-search-modal-container">
        
        <!-- Modal Search Header -->
        <div class="gs-search-modal-header">
          <form action="{{ routes.search_url }}" method="get" class="gs-modal-search-form" id="gs-modal-search-form">
            <svg class="gs-modal-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#555555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input 
              type="search" 
              name="q" 
              id="gs-modal-search-input" 
              class="gs-modal-search-input" 
              placeholder="Search" 
              autocomplete="off" 
              required 
            />
          </form>
          <button type="button" class="gs-modal-close-btn" id="gs-modal-close-btn" aria-label="Close search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#333333" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Modal Products Content -->
        <div class="gs-modal-body">
          <div class="gs-modal-section-title" id="gs-modal-section-title">Products</div>
          
          <div class="gs-modal-products-grid" id="gs-modal-products-grid">
            {%- assign popular_collection = collections['all'] | default: collections.first -%}
            {%- for product in popular_collection.products limit: 4 -%}
              <a href="{{ product.url }}" class="gs-modal-product-card">
                <div class="gs-modal-product-img-wrap">
                  {%- if product.featured_image -%}
                    <img src="{{ product.featured_image | image_url: width: 240 }}" alt="{{ product.title | escape }}" loading="lazy" width="120" height="120" />
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'gs-modal-placeholder' }}
                  {%- endif -%}
                </div>
                <div class="gs-modal-product-info">
                  <div class="gs-modal-product-title">{{ product.title }}</div>
                  <div class="gs-modal-product-pricing">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="gs-modal-price-compare">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                    {%- endif -%}
                    <span class="gs-modal-price-regular">{{ product.price | money_without_trailing_zeros }}</span>
                  </div>
                </div>
              </a>
            {%- endfor -%}
          </div>

          <div class="gs-modal-loading" id="gs-modal-loading" style="display: none;">
            <div class="gs-modal-spinner"></div>
            <span>Searching products...</span>
          </div>

          <div class="gs-modal-empty" id="gs-modal-empty" style="display: none;">
            <p>No products found matching your search.</p>
          </div>
        </div>

      </div>
    </div>

  </header>

</div>

<!-- 4. MOBILE NAVIGATION DRAWER -->
<div class="gs-mobile-drawer" id="gs-mobile-drawer">
  <div class="gs-mobile-drawer-backdrop"></div>
  <div class="gs-mobile-drawer-content">
    
    <!-- Drawer Header -->
    <div class="gs-mobile-drawer-header">
      <span class="gs-mobile-drawer-title">Menu</span>
      <span role="button" tabindex="0" class="gs-mobile-drawer-close" aria-label="Close menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </span>
    </div>

    <!-- Drawer Links -->
    <div class="gs-mobile-drawer-links-wrap">
      <ul class="gs-mobile-links-list">
        {%- if main_nav_links.size > 0 -%}
          {%- for link in main_nav_links -%}
            <li class="gs-mobile-link-item {% if link.links.size > 0 %}has-sublinks{% endif %}">
              <div class="gs-mobile-link-row">
                <a href="{{ link.url }}" class="gs-mobile-link">
                  <span>{{ link.title }}</span>
                </a>
                {%- if link.links.size > 0 -%}
                  <span role="button" tabindex="0" class="gs-mobile-sublink-toggle" aria-label="Toggle {{ link.title }} Submenu">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#103f60" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                {%- endif -%}
              </div>

              {%- if link.links.size > 0 -%}
                <ul class="gs-mobile-sublinks-list">

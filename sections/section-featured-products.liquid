<script>
  function scrollFeaturedProducts(sectionId, offset) {
    const track = document.getElementById('FeaturedProductTrack-' + sectionId);
    if (track) {
      track.scrollBy({ left: offset, behavior: 'smooth' });
    }
  }
</script>


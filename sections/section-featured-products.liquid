{%- liquid
  assign limit = section.settings.number_of_items
  case limit
    when 0
      assign width_class = 'w33'
    when 1
      if section.settings.text_alignment == 'aside'
        assign width_class = 'w50'
      else
        assign width_class = 'w33'
      endif
    when 2
      assign width_class = 'w50'
    when 3
      assign width_class = 'w33'
    when 4
      assign width_class = 'w25'
    when 5
      assign width_class = 'w20'
    when 6
      assign width_class = 'w16'
    when 7
      assign width_class = 'w14'
    else
      assign width_class = 'w12'
  endcase

  assign img_width_limit = limit
  assign img_width = 100 | divided_by: img_width_limit

  if section.settings.show_link and section.settings.link_text != empty and section.settings.link_url != blank
    assign link = true
  endif

  if section.settings.title != empty or section.settings.text != empty
    assign show_header = true
  elsif link and section.settings.text_alignment == 'start'
    assign show_header = true
  endif

  if section.settings.text_alignment == 'aside'
    assign aside = true
  else
    assign aside = false
  endif

  capture title_classes
    echo 'w720 '
    if section.settings.text_alignment == 'center'
      echo ' text-center align-center'
    endif
  endcapture
  assign slider = false
  if request.visual_preview_mode == false
    if section.settings.layout == 'slider'
      assign slider = true
    elsif section.settings.layout == 'grid'
      assign slider = false
    endif
  endif
-%}

{%- capture image_sizes -%}
    (min-width: 1300px)
    {% if aside %}
        {% if settings.width < 2000 %}
            {%- if img_width == 100 -%}
                calc(({{ settings.width }}px * 0.6) * 0.2
            {% else %}
                calc(({{ settings.width }}px * 0.6) * 0.{{ img_width }}
            {% endif %}
        {% else %}
            {%- if img_width == 100 -%}
                calc((100vw * 0.6) * 0.2
            {% else %}
                calc((100vw * 0.6) * 0.{{ img_width }}
            {% endif %}
        {% endif %}
    {% else %}
       {% if settings.width < 2000 %}
            {%- if img_width == 100 -%}
                calc({{ settings.width }}px * 0.2)
            {% else %}
                calc({{ settings.width }}px * 0.{{ img_width }})
            {% endif %}
        {% else %}
            {%- if img_width == 100 -%}
                calc(100vw * 0.2)
            {% else %}
                calc(100vw * 0.{{ img_width }})
            {% endif %}
        {% endif %}
    {% endif %}
    ,
    (min-width: 1000px)
    {% if aside %}
        {%- if img_width == 100 -%}
            calc((100vw * 0.6) * 0.2
        {% else %}
            calc((100vw * 0.6) * 0.{{ img_width }}
        {% endif %}
    {% else %}
        {%- if img_width == 100 -%}
            calc(100vw * 0.2)
        {% else %}
            calc(100vw * 0.{{ img_width }})
        {% endif %}
    {% endif %}
    ,
    (min-width: 760px)
    {% if slider %}
        calc(100vw * 0.3)
    {% else %}
        320px
    {% endif %}
    ,
    170px
{%- endcapture -%}

{%- if link %}
  {%- capture link -%}
        {%- liquid
            assign button_color = section.settings.button_style | split: ' ' | first
            assign button_style = section.settings.button_style | split: ' ' | last
            assign is_link = false
            if button_style == 'link'
                assign is_link = true
            endif
        -%}
        <p class="class-x link-btn"><a href="{{ section.settings.link_url }}" class="overlay-{{ button_color }} {% if is_link %}inline strong{% elsif button_style == 'inv' %}inv{% endif %}">{% if is_link %}<span>{% endif %}{{ section.settings.link_text }}{% if is_link %}</span>&nbsp;<i aria-hidden="true" class="icon-chevron-right"></i>{% endif %}</a></p>
    {%- endcapture %}
{%- endif -%}

{%- if aside %}<div class="m6ac section-width-{{ section.settings.width }}">{%- endif -%}
{%- liquid
  assign clean_title = section.settings.title | strip_html | strip
  if clean_title == blank
    assign clean_title = "Today's Top Deals & Best Sellers"
  endif
  assign clean_subtitle = section.settings.text | strip_html | strip
  if clean_subtitle == blank
    assign clean_subtitle = "Handpicked top rated items & exclusive offers for you"
  endif
  
  assign deals_view_all_text = section.settings.link_text
  if deals_view_all_text == blank or deals_view_all_text == 'Button'
    assign deals_view_all_text = 'View All'
  endif
  assign deals_view_all_text = deals_view_all_text | replace: ' &rarr;', '' | replace: '&rarr;', '' | replace: ' →', '' | replace: '→', ''
-%}

<div class="deals-section-inner">
  <div class="deals-header-inner">
    <div class="deals-header-titles">
      <h2 class="deals-title">{{ clean_title }}</h2>
      <p class="deals-subtitle">{{ clean_subtitle }}</p>
    </div>
    {%- if section.settings.show_link -%}
      <div class="deals-header-right">
        <a href="{{ section.settings.link_url | default: '/collections/all' }}" class="deals-view-all-link">
          <span>{{ deals_view_all_text }}</span>
          <span class="deals-arrow-icon" aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>

  <div class="deals-product-track-container">
    <ul id="FeaturedProductTrack-{{ section.id }}" class="deals-product-track {% if settings.enable_quick_buy and section.settings.hide_quick_buy == false %}with-quick-buy{% endif %}">
      {%- liquid
        assign product_list = section.settings.products
        assign has_real_products = false
        
        if product_list != blank and product_list.count > 0
          for p in product_list
            if p.title != blank
              assign has_real_products = true
              break
            elsif all_products[p].title != blank
              assign has_real_products = true
              break
            endif
          endfor
        endif

        if has_real_products == false
          if collections['homecoming-boxes'].products.size > 0
            assign product_list = collections['homecoming-boxes'].products
          elsif collections['gift-hamper-boxes'].products.size > 0
            assign product_list = collections['gift-hamper-boxes'].products
          elsif collections['pravasi-boxes'].products.size > 0
            assign product_list = collections['pravasi-boxes'].products
          else
            assign product_list = collections['all'].products
          endif
        endif

        for product_item in product_list limit: 12
          assign target_product = product_item
          if target_product.title == blank and all_products[target_product].title != blank
            assign target_product = all_products[target_product]
          endif

          capture placeholder_int
            cycle 1, 2, 3, 4, 5, 6
          endcapture
          if section.index == 1 and forloop.first
            assign no_lazyload = true
          endif
          render 'product-item', product: target_product, placeholder_int: placeholder_int, enable_quick_buy_desktop: section.settings.enable_quick_buy_desktop, enable_quick_buy_mobile: section.settings.enable_quick_buy_mobile, enable_quick_buy_qty_selector: section.settings.enable_quick_buy_qty_selector, quick_buy_compact: section.settings.enable_quick_buy_compact, sizes: image_sizes, enable_quick_buy_drawer: section.settings.enable_quick_buy_drawer, enable_color_picker: section.settings.enable_color_picker, no_lazyload: no_lazyload
        endfor
      -%}
    </ul>
  </div>

  {%- if section.settings.show_link -%}
    <div class="deals-footer-mobile">
      <a href="{{ section.settings.link_url | default: '/collections/all' }}" class="deals-view-link-mobile">
        <span>{{ deals_view_all_text }}</span>
        <span class="deals-arrow-icon" aria-hidden="true">→</span>
      </a>
    </div>
  {%- endif -%}
</div>


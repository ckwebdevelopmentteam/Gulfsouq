{% comment %}
  Section: Explore Categories Grid
  Description: Premium category showcase with 2-row grid on desktop/tablet, smooth horizontal swipe carousel on mobile, and clean inline "View All →" action aligned in the header.
{% endcomment %}

<div class="explore-categories-section" id="explore-categories-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="explore-categories-inner">
    
    <!-- Section Header (Heading Left, View All Right) -->
    <div class="explore-categories-header">
      <div class="header-titles">
        <h2 class="explore-title">{{ section.settings.title | default: 'Explore Categories' | escape }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="explore-subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.view_all_text != blank -%}
        {%- assign view_all_clean = section.settings.view_all_text | replace: ' →', '' | replace: '→', '' | replace: ' &rarr;', '' | replace: '&rarr;', '' -%}
        <div class="header-actions">
          <a href="{{ section.settings.view_all_link | default: '/collections' }}" class="explore-view-all-link">
            <strong>{{ view_all_clean }}</strong>
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Categories Display (2 Equal Rows on Desktop, Swipeable on Mobile) -->
    <div class="explore-categories-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign title = block.settings.title | default: collection.title
            assign link = block.settings.link | default: collection.url | default: "/collections/all"
            assign image = block.settings.image | default: collection.featured_image | default: collection.image | default: collection.products.first.featured_image
          -%}

          <a href="{{ link }}" class="explore-category-card" {{ block.shopify_attributes }}>
            <div class="category-card-image-box">
              {%- if image != blank -%}
                <img src="{{ image | image_url: width: 300 }}"
                     alt="{{ title | escape }}"
                     loading="lazy"
                     class="category-card-img">
              {%- else -%}
                <div class="category-card-placeholder">
                  <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#0C3E61" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                  </svg>
                </div>
              {%- endif -%}
            </div>

            <div class="category-card-content">
              <span class="category-card-title">{{ title }}</span>
              {%- if section.settings.show_product_count and collection.all_products_count > 0 -%}
                <span class="category-card-count">{{ collection.all_products_count }} items</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}

      {%- else -%}
        <!-- Fallback to store collections -->
        {%- for collection in collections -%}
          {%- unless collection.handle == 'frontpage' -%}
            {%- liquid
              assign title = collection.title
              assign link = collection.url
              assign image = collection.featured_image | default: collection.image | default: collection.products.first.featured_image
            -%}

            <a href="{{ link }}" class="explore-category-card">
              <div class="category-card-image-box">
                {%- if image != blank -%}
                  <img src="{{ image | image_url: width: 300 }}"
                       alt="{{ title | escape }}"
                       loading="lazy"
                       class="category-card-img">
                {%- else -%}
                  <div class="category-card-placeholder">
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#0C3E61" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                      <line x1="8" y1="21" x2="16" y2="21"></line>
                      <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                  </div>
                {%- endif -%}
              </div>

              <div class="category-card-content">
                <span class="category-card-title">{{ title }}</span>
                {%- if section.settings.show_product_count and collection.all_products_count > 0 -%}
                  <span class="category-card-count">{{ collection.all_products_count }} items</span>
                {%- endif -%}
              </div>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  /* --------------------------------------------------
     EXPLORE CATEGORIES - SECTION STYLING
  --------------------------------------------------- */
  .explore-categories-section {
    padding: 38px 0 28px 0;
    background: #FFFFFF;
    position: relative;
    box-sizing: border-box;
  }

  .explore-categories-inner {
    max-width: 1420px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* Section Header: Heading on Left, View All on Right */
  .explore-categories-header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    margin-bottom: 16px !important;
    gap: 16px !important;
  }

  .explore-categories-header .header-titles {
    display: flex !important;
    flex-direction: column !important;
    gap: 2px !important;
    min-width: 0 !important;
    flex: 1 1 auto !important;
  }

  .explore-title {
    font-size: 30px !important;
    font-weight: 800 !important;
    color: #0C3E61 !important;
    margin: 0 !important;
    padding: 0 !important;
    letter-spacing: -0.3px !important;
    line-height: 1.2 !important;
  }

  .explore-subtitle {
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #64748B !important;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1.3 !important;
  }

  .header-actions {
    display: flex !important;
    align-items: center !important;
    flex-shrink: 0 !important;
    margin: 0 !important;
  }

  /* Bordered "View All →" Button */
  .explore-view-all-link {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    color: #FFFFFF !important;
    text-decoration: none !important;
    letter-spacing: 0.3px !important;
    text-transform: none !important;
    white-space: nowrap !important;
    padding: 8px 24px !important;
    min-width: 110px !important;
    border-radius: 8px !important;
    background: #0C3E61 !important;
    border: 1.5px solid #0C3E61 !important;
    box-shadow: 0 2px 6px rgba(12, 62, 97, 0.12) !important;
    transition: all 0.22s ease !important;
    cursor: pointer !important;
  }

  .explore-view-all-link .explore-arrow-icon {
    display: none !important;
  }

  .explore-view-all-link strong {
    font-weight: 600 !important;
    color: inherit !important;
    font-style: normal !important;
  }

  .explore-view-all-link:hover {
    color: #FFFFFF !important;
    border-color: #082D47 !important;
    background: #082D47 !important;
    box-shadow: 0 4px 12px rgba(12, 62, 97, 0.25) !important;
  }

  .explore-view-all-link:hover .explore-arrow-icon {
    transform: translateX(3px);
  }

  /* 2-Row Equal Grid Layout on Desktop */
  .explore-categories-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
    width: 100%;
    box-sizing: border-box;
  }

  /* Category Card */
  .explore-category-card {
    background: #FFFFFF;
    border: 1.5px solid #F1F5F9;
    border-radius: 18px;
    padding: 22px 14px 18px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    box-shadow: 0 3px 12px rgba(12, 62, 97, 0.03);
    transition: transform 0.28s cubic-bezier(0.25, 0.8, 0.25, 1),
                box-shadow 0.28s ease,
                border-color 0.28s ease;
    box-sizing: border-box;
    cursor: pointer;
    min-height: 215px;
  }

  .explore-category-card:hover {
    transform: translateY(-5px);
    border-color: #BE982D;
    box-shadow: 0 12px 28px rgba(12, 62, 97, 0.09), 0 3px 10px rgba(190, 152, 45, 0.14);
  }

  /* Card Image */
  .category-card-image-box {
    width: 100%;
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
  }

  .category-card-img {
    max-width: 100%;
    max-height: 105px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 6px 12px rgba(12, 62, 97, 0.08));
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .explore-category-card:hover .category-card-img {
    transform: scale(1.09);
  }

  .category-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.4;
  }

  /* Card Title & Info */
  .category-card-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    margin-top: 12px;
    gap: 2px;
  }

  .category-card-title {
    font-size: 14px;
    font-weight: 700;
    color: #0C3E61;
    text-align: center;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 36px;
    letter-spacing: -0.1px;
    transition: color 0.22s ease;
  }

  .explore-category-card:hover .category-card-title {
    color: #BE982D;
  }

  .category-card-count {
    font-size: 11.5px;
    font-weight: 500;
    color: #7E7E7E;
    line-height: 1;
    margin-top: 1px;
  }

  /* --------------------------------------------------
     RESPONSIVE BREAKPOINTS
  --------------------------------------------------- */
  @media (max-width: 1200px) {
    .explore-categories-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 900px) {
    .explore-categories-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .explore-category-card {
      min-height: 195px;
      padding: 18px 12px 14px 12px;
    }
    .category-card-image-box {
      height: 95px;
    }
    .category-card-img {
      max-height: 90px;
    }
    .category-card-title {
      font-size: 13px;
      height: 33px;
    }
  }

  /* Mobile Devices (<= 768px): Header with View All Right + Horizontal Swipe Carousel */
  @media (max-width: 768px) {
    .explore-categories-section {
      padding: 24px 0 16px 0;
    }

    .explore-categories-inner {
      padding: 0 14px;
    }

    .explore-categories-header {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      margin-bottom: 14px !important;
      gap: 10px !important;
    }

    .explore-title {
      font-size: 22px !important;
      letter-spacing: -0.2px !important;
    }

    .explore-subtitle {
      font-size: 12px !important;
    }

    .header-actions {
      display: flex !important;
      align-items: center !important;
      flex-shrink: 0 !important;
      margin-bottom: 0 !important;
    }

    .explore-view-all-link {
      font-size: 13px !important;
      font-weight: 600 !important;
      color: #FFFFFF !important;
      gap: 5px !important;
      padding: 6px 14px !important;
      border-radius: 7px !important;
      border: 1.5px solid #0C3E61 !important;
      background: #0C3E61 !important;
      box-shadow: 0 1px 4px rgba(12, 62, 97, 0.12) !important;
      text-transform: none !important;
    }

    .explore-view-all-link .explore-arrow-icon {
      font-size: 13px !important;
      font-weight: 700 !important;
    }

    /* Horizontal Swipeable Track on Mobile */
    .explore-categories-grid {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      scroll-behavior: smooth !important;
      -webkit-overflow-scrolling: touch !important;
      scroll-snap-type: x mandatory !important;
      gap: 12px !important;
      padding: 4px 4px 10px 4px !important;
      margin: 0 !important;
      scrollbar-width: none !important; /* Firefox */
      -ms-overflow-style: none !important; /* IE/Edge */
    }

    .explore-categories-grid::-webkit-scrollbar {
      display: none !important; /* Chrome/Safari */
    }

    .explore-category-card {
      flex: 0 0 130px !important;
      min-width: 130px !important;
      max-width: 130px !important;
      min-height: 175px !important;
      scroll-snap-align: start !important;
      border-radius: 16px !important;
      padding: 15px 8px 12px 8px !important;
      background: #FFFFFF !important;
      border: 1.5px solid #F1F5F9 !important;
      box-shadow: 0 2px 8px rgba(12, 62, 97, 0.04) !important;
    }

    .category-card-image-box {
      height: 82px !important;
    }

    .category-card-img {
      max-height: 78px !important;
    }

    .category-card-content {
      margin-top: 10px !important;
    }

    .category-card-title {
      font-size: 12px !important;
      height: 30px !important;
      line-height: 1.25 !important;
    }

    .category-card-count {
      font-size: 10.5px !important;
    }
  }

  @media (max-width: 420px) {
    .explore-category-card {
      flex: 0 0 118px !important;
      min-width: 118px !important;
      max-width: 118px !important;
      min-height: 165px !important;
      padding: 12px 6px 10px 6px !important;
    }

    .category-card-image-box {
      height: 75px !important;
    }

    .category-card-img {
      max-height: 70px !important;
    }

    .category-card-title {
      font-size: 11.5px !important;
      height: 28px !important;
    }

    .explore-title {
      font-size: 20px !important;
    }

    .explore-view-all-link {
      font-size: 12px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Explore Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore Categories"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Curated collections for your daily needs"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show Product Count",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "info": "Leave blank to use collection title dynamically"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Leave blank to use collection featured image dynamically"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link",
          "info": "Leave blank to link directly to collection URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Explore Categories Grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Chocolates" } },
        { "type": "category", "settings": { "title": "Dates" } },
        { "type": "category", "settings": { "title": "Perfumes" } },
        { "type": "category", "settings": { "title": "Nuts & Dry Fruits" } },
        { "type": "category", "settings": { "title": "Gift Hampers" } },
        { "type": "category", "settings": { "title": "Electronics" } },
        { "type": "category", "settings": { "title": "Homecoming Boxes" } },
        { "type": "category", "settings": { "title": "Watches" } },
        { "type": "category", "settings": { "title": "Beauty & Personal Care" } },
        { "type": "category", "settings": { "title": "Spices & Herbs" } },
        { "type": "category", "settings": { "title": "Toys" } },
        { "type": "category", "settings": { "title": "Home & Living" } }
      ]
    }
  ]
}
{% endschema %}

{%- liquid
  assign newsletter_block = section.blocks | where: 'type', 'socials_newsletter' | first
  assign customer_service_block = section.blocks | where: 'type', 'customer_support' | first
  assign menu_block = section.blocks | where: 'type', 'menu' | first
-%}

<div class="gs-footer-wrapper" id="shopify-section-footer">
  <div class="gs-footer-inner">
    <div class="gs-footer-grid">
      
      {%- comment -%} COLUMN 1: About Gulf Souq / Customer Support {%- endcomment -%}
      <div class="gs-footer-col gs-footer-col-about" {{ customer_service_block.shopify_attributes }}>
        <div class="gs-footer-heading-wrap">
          <h3 class="gs-footer-title">
            {{ customer_service_block.settings.title | default: 'About Gulf Souq' | strip_html }}
          </h3>
          <span class="gs-title-bar"></span>
        </div>

        <div class="gs-footer-about-text">
          {%- if customer_service_block.settings.extra_customer_support != blank -%}
            {{ customer_service_block.settings.extra_customer_support }}
          {%- else -%}
            <p>Premium Gulf Products — Direct from Dubai & Saudi Arabia. Authentic Arabic perfumes, premium dates, and luxury gift hampers.</p>
          {%- endif -%}
        </div>

        {%- if newsletter_block.settings.show_socials -%}
          <div class="gs-footer-socials">
            <a href="https://www.instagram.com/gulfsouq.in" target="_blank" rel="noopener" aria-label="Instagram" class="gs-social-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
            <a href="https://www.facebook.com/gulfsouq.in" target="_blank" rel="noopener" aria-label="Facebook" class="gs-social-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            </a>
            <a href="https://wa.me/919207545444" target="_blank" rel="noopener" aria-label="WhatsApp" class="gs-social-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.438 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} COLUMNS 2 & 3: Navigation Menus {%- endcomment -%}
      {%- if menu_block -%}
        {%- assign footer_links = linklists[menu_block.settings.menu].links -%}
        {%- if footer_links.size > 0 -%}
          {%- for link in footer_links -%}
            <div class="gs-footer-col gs-footer-col-menu" {{ menu_block.shopify_attributes }}>
              <div class="gs-footer-heading-wrap">
                <h3 class="gs-footer-title">{{ link.title }}</h3>
                <span class="gs-title-bar"></span>
              </div>
              {%- if link.links != blank -%}
                <ul class="gs-footer-links">
                  {%- for sub_link in link.links -%}
                    <li>
                      <a href="{{ sub_link.url }}" class="gs-footer-link">{{ sub_link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} COLUMN 4: Newsletter & Exclusive Offers {%- endcomment -%}
      {%- if newsletter_block -%}
        <div class="gs-footer-col gs-footer-col-newsletter" {{ newsletter_block.shopify_attributes }}>
          <div class="gs-footer-heading-wrap">
            <h3 class="gs-footer-title">
              {{ newsletter_block.settings.title | default: 'Get Exclusive Gift Ideas' }}
            </h3>
            <span class="gs-title-bar"></span>
          </div>

          <p class="gs-footer-newsletter-text">Subscribe for exclusive offers, seasonal gift hampers, and newly arrived Gulf specialties.</p>
          
          {%- form 'customer', id: 'newsletter-footer', class: 'gs-newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <div class="gs-newsletter-success">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Thank you for subscribing!</span>
              </div>
            {%- else -%}
              <div class="gs-newsletter-box">
                <input type="email" 
                       name="contact[email]" 
                       id="email-{{ section.id }}" 
                       class="gs-newsletter-input"
                       placeholder="Enter your email..." 
                       required 
                       aria-label="Email Address">
                <button type="submit" class="gs-newsletter-btn" aria-label="Subscribe">
                  <span>SUBSCRIBE</span>
                  <span class="gs-newsletter-arrow">→</span>
                </button>
              </div>
              {%- if form.errors -%}
                <p class="gs-newsletter-error">{{ form.errors.messages['email'] }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} FOOTER BOTTOM BAR {%- endcomment -%}
    <div class="gs-footer-bottom">
      <div class="gs-footer-copyright">
        &copy; {{ 'now' | date: "%Y" }} <span class="gs-brand-name">GULF SOUQ</span>. All rights reserved. Powered by Shopify.
      </div>
      {%- if section.settings.show_payment_methods -%}
        <div class="gs-footer-payments">
          {%- for type in shop.enabled_payment_types -%}
            <span class="gs-payment-badge">{{ type | payment_type_svg_tag }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  /* Reset theme wrapper constraints */
  #content > .shopify-section-footer,
  .shopify-section-footer {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #07243A !important;
    position: relative !important;
    overflow: visible !important;
    text-align: left !important;
  }

  .shopify-section-footer::before,
  .shopify-section-footer > div::before {
    display: none !important;
  }

  .gs-footer-wrapper {
    background: #07243A !important;
    color: #FFFFFF !important;
    width: 100% !important;
    position: relative !important;
    box-sizing: border-box !important;
    padding: 56px 0 28px 0 !important;
    text-align: left !important;
  }

  .gs-footer-inner {
    max-width: 1420px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
    box-sizing: border-box !important;
    width: 100% !important;
    text-align: left !important;
  }

  .gs-footer-grid {
    display: grid !important;
    grid-template-columns: 1.15fr 0.95fr 0.95fr 1.6fr !important;
    gap: 36px !important;
    align-items: start !important;
    width: 100% !important;
    box-sizing: border-box !important;
    margin-bottom: 48px !important;
    text-align: left !important;
  }

  .gs-footer-col {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    text-align: left !important;
    box-sizing: border-box !important;
    min-width: 0 !important;
  }

  /* Perfect Unification of Heading + Underline */
  .gs-footer-heading-wrap {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    text-align: left !important;
    margin: 0 0 18px 0 !important;
    padding: 0 !important;
  }

  .gs-footer-title {
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
    text-transform: uppercase !important;
    letter-spacing: 0.8px !important;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1.25 !important;
    text-align: left !important;
    display: block !important;
  }

  .gs-title-bar {
    width: 32px !important;
    height: 2.5px !important;
    background: #BE982D !important;
    border-radius: 2px !important;
    margin-top: 8px !important;
    margin-left: 0 !important;
    display: block !important;
  }

  .gs-footer-about-text,
  .gs-footer-about-text p {
    font-size: 14px !important;
    line-height: 1.6 !important;
    color: #94A3B8 !important;
    margin: 0 0 16px 0 !important;
    text-align: left !important;
  }

  .gs-footer-socials {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 10px !important;
    margin: 0 !important;
  }

  .gs-social-icon {
    width: 34px !important;
    height: 34px !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #CBD5E1 !important;
    text-decoration: none !important;
    transition: all 0.2s ease !important;
  }

  .gs-social-icon:hover {
    background: #BE982D !important;
    border-color: #BE982D !important;
    color: #FFFFFF !important;
    transform: translateY(-2px) !important;
  }

  .gs-footer-links {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    text-align: left !important;
    gap: 11px !important;
  }

  .gs-footer-links li {
    padding: 0 !important;
    margin: 0 !important;
    text-align: left !important;
    width: 100% !important;
  }

  .gs-footer-link {
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #CBD5E1 !important;
    text-decoration: none !important;
    display: inline-block !important;
    text-align: left !important;
    transition: all 0.2s ease !important;
    line-height: 1.35 !important;
  }

  .gs-footer-link:hover {
    color: #BE982D !important;
    transform: translateX(4px) !important;
  }

  .gs-footer-newsletter-text {
    font-size: 14px !important;
    line-height: 1.55 !important;
    color: #94A3B8 !important;
    margin: 0 0 16px 0 !important;
    text-align: left !important;
  }

  .gs-newsletter-form {
    width: 100% !important;
    margin: 0 !important;
    text-align: left !important;
  }

  /* Clean Single Integrated Newsletter Box */
  .gs-newsletter-box {
    display: flex !important;
    align-items: stretch !important;
    width: 100% !important;
    height: 45px !important;
    border-radius: 8px !important;
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1.5px solid rgba(255, 255, 255, 0.2) !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
  }

  .gs-newsletter-box:focus-within {
    border-color: #BE982D !important;
    box-shadow: 0 0 0 3px rgba(190, 152, 45, 0.2) !important;
  }

  .gs-newsletter-input {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    height: 100% !important;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    padding: 0 14px !important;
    color: #FFFFFF !important;
    font-size: 13px !important;
    box-sizing: border-box !important;
    box-shadow: none !important;
    text-align: left !important;
  }

  .gs-newsletter-input::placeholder {
    color: #94A3B8 !important;
    font-size: 13px !important;
    letter-spacing: -0.1px !important;
    text-align: left !important;
  }

  .gs-newsletter-btn {
    all: unset !important;
    background: #BE982D !important;
    color: #07243A !important;
    border: none !important;
    outline: none !important;
    padding: 0 15px !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.5px !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 5px !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
    box-sizing: border-box !important;
    transition: background 0.2s ease !important;
  }

  .gs-newsletter-btn:hover {
    background: #D4AF37 !important;
  }

  .gs-newsletter-btn::before,
  .gs-newsletter-btn::after {
    display: none !important;
    content: none !important;
  }

  .gs-newsletter-arrow {
    font-size: 13px !important;
    font-weight: 700 !important;
    transition: transform 0.2s ease !important;
  }

  .gs-newsletter-btn:hover .gs-newsletter-arrow {
    transform: translateX(3px) !important;
  }

  .gs-newsletter-success {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    font-size: 13.5px !important;
    color: #25D366 !important;
    font-weight: 600 !important;
    margin: 0 !important;
    text-align: left !important;
  }

  .gs-newsletter-error {
    font-size: 12px !important;
    color: #EF4444 !important;
    margin: 6px 0 0 0 !important;
    text-align: left !important;
  }

  /* Bottom Bar */
  .gs-footer-bottom {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 20px !important;
    padding-top: 24px !important;
    border-top: 1px solid rgba(255, 255, 255, 0.12) !important;
    width: 100% !important;
    box-sizing: border-box !important;
    flex-wrap: wrap !important;
  }

  .gs-footer-copyright {
    font-size: 13px !important;
    color: #94A3B8 !important;
    margin: 0 !important;
    line-height: 1.5 !important;
  }

  .gs-brand-name {
    color: #FFFFFF !important;
    font-weight: 600 !important;
  }

  .gs-footer-payments {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    flex-wrap: wrap !important;
  }

  .gs-payment-badge {
    display: inline-flex !important;
    align-items: center !important;
  }

  .gs-payment-badge svg {
    height: 24px !important;
    width: auto !important;
    border-radius: 4px !important;
  }

  @media only screen and (max-width: 1024px) and (min-width: 769px) {
    .gs-footer-grid {
      grid-template-columns: 1fr 1fr !important;
      gap: 36px !important;
    }
  }

  @media only screen and (max-width: 768px) {
    .gs-footer-wrapper {
      padding: 36px 0 24px 0 !important;
      text-align: left !important;
    }
    .gs-footer-inner {
      padding: 0 16px !important;
      text-align: left !important;
    }
    .gs-footer-grid {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 28px 20px !important;
      margin-bottom: 28px !important;
      text-align: left !important;
    }
    .gs-footer-col {
      align-items: flex-start !important;
      text-align: left !important;
    }
    .gs-footer-col-about {
      grid-column: 1 / -1 !important;
      text-align: left !important;
    }
    .gs-footer-col-newsletter {
      grid-column: 1 / -1 !important;
      text-align: left !important;
    }
    .gs-footer-heading-wrap {
      align-items: flex-start !important;
      text-align: left !important;
      margin: 0 0 14px 0 !important;
    }
    .gs-footer-title {
      font-size: 14px !important;
      text-align: left !important;
    }
    .gs-title-bar {
      margin-left: 0 !important;
    }
    .gs-footer-about-text,
    .gs-footer-about-text p {
      font-size: 13.5px !important;
      line-height: 1.55 !important;
      margin: 0 0 14px 0 !important;
      text-align: left !important;
    }
    .gs-footer-socials {
      justify-content: flex-start !important;
      margin: 0 !important;
    }
    .gs-footer-links {
      text-align: left !important;
      align-items: flex-start !important;
      gap: 10px !important;
    }
    .gs-footer-links li {
      text-align: left !important;
    }
    .gs-footer-link {
      font-size: 13.5px !important;
      text-align: left !important;
    }
    .gs-footer-newsletter-text {
      font-size: 13.5px !important;
      margin: 0 0 14px 0 !important;
      text-align: left !important;
    }
    .gs-newsletter-box {
      display: flex !important;
      flex-direction: row !important;
      align-items: stretch !important;
      height: 44px !important;
      border-radius: 8px !important;
      background: rgba(255, 255, 255, 0.08) !important;
      border: 1.5px solid rgba(255, 255, 255, 0.2) !important;
      overflow: hidden !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    .gs-newsletter-input {
      flex: 1 1 auto !important;
      min-width: 0 !important;
      height: 100% !important;
      padding: 0 12px !important;
      font-size: 12.5px !important;
      border: none !important;
      background: transparent !important;
      box-shadow: none !important;
      text-align: left !important;
    }
    .gs-newsletter-btn {
      height: 100% !important;
      padding: 0 14px !important;
      font-size: 11px !important;
      border-radius: 0 !important;
      width: auto !important;
      flex-shrink: 0 !important;
    }
    .gs-footer-bottom {
      flex-direction: column !important;
      align-items: center !important;
      text-align: center !important;
      gap: 14px !important;
      padding-top: 20px !important;
      border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
    }
    .gs-footer-copyright {
      text-align: center !important;
    }
    .gs-footer-payments {
      justify-content: center !important;
      gap: 6px !important;
    }
  }
</style>

{% schema %}
{
  "name": "t:static_sections.footer.name",
  "class": "shopify-section-footer",
  "tag": "footer",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:global.layout.width.label",
      "options": [
        {
          "value": "boxed",
          "label": "t:global.layout.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:global.layout.width.options__2.label"
        }
      ],
      "default": "boxed",
      "visible_if": "{{ settings.width < 2000 }}"
    },
    {
      "type": "color_scheme",
      "id": "footer_color",
      "label": "t:static_sections.footer.settings.footer_color.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "t:global.typography.title_font.label",
      "options": [
        {
          "value": "primary",
          "label": "t:global.typography.title_font.primary.label"
        },
        {
          "value": "secondary",
          "label": "t:global.typography.title_font.secondary.label"
        }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "title_size_blocks",
      "label": "t:global.typography.title_size.label",
      "options": [
        {
          "value": "h1",
          "label": "t:global.typography.title_size.h1.label"
        },
        {
          "value": "h2",
          "label": "t:global.typography.title_size.h2.label"
        },
        {
          "value": "h3",
          "label": "t:global.typography.title_size.h3.label"
        },
        {
          "value": "h4",
          "label": "t:global.typography.title_size.h4.label"
        },
        {
          "value": "h5",
          "label": "t:global.typography.title_size.h5.label"
        }
      ],
      "default": "h4"
    },
    {
      "type": "header",
      "content": "t:static_sections.footer.settings.bottom_bar.header"
    },
    {
      "type": "color_scheme",
      "id": "bottom_color",
      "label": "t:global.color_palette.label",
      "default": "scheme-6"
    },
    {
      "id": "bottom_img",
      "type": "image_picker",
      "label": "t:static_sections.footer.settings.bottom_bar.bottom_img.label",
      "info": "t:static_sections.footer.settings.bottom_bar.bottom_img.info"
    },
    {
      "id": "bottom_img_width",
      "type": "range",
      "label": "t:static_sections.footer.settings.bottom_bar.bottom_img_width.label",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 125
    },
    {
      "id": "bottom_img_link",
      "type": "url",
      "label": "t:static_sections.footer.settings.bottom_bar.bottom_img_link.label"
    },
    {
      "id": "enable_country_selector",
      "type": "checkbox",
      "label": "t:static_sections.footer.settings.bottom_bar.enable_country_selector.label",
      "info": "t:static_sections.footer.settings.bottom_bar.enable_country_selector.info",
      "default": false
    },
    {
      "id": "enable_language_selector",
      "type": "checkbox",
      "label": "t:static_sections.footer.settings.bottom_bar.enable_language_selector.label",
      "info": "t:static_sections.footer.settings.bottom_bar.enable_language_selector.info",
      "default": true
    },
    {
      "type": "checkbox",

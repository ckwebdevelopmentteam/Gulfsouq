{% comment %}
  Section: Brand Stats & Heritage Banner
  Description: Custom section matching Reference Image 2 with Gulf Souq navy background (#103f60), repeating subtle leaf/damask pattern, brand story, and 2x2 stats grid.
{% endcomment %}

<div class="gs-brand-stats-section" id="gs-brand-stats-{{ section.id }}">
  <div class="gs-brand-stats-bg-pattern"></div>
  
  <div class="gs-brand-stats-container">
    <!-- Left Side: Brand Heritage & Story -->
    <div class="gs-brand-stats-story">
      <h2 class="gs-brand-stats-title">{{ section.settings.heading | default: "GULFSOUQ DATES & LUXURY PRODUCTS" | escape }}</h2>
      <div class="gs-brand-stats-divider"></div>
      <p class="gs-brand-stats-desc">
        {{ section.settings.description | default: "Welcome to Gulfsouq, where an unwavering commitment to authenticity brings you the finest treasures from the Arabian Gulf. Enjoy our unique assortment of dates, harvested with care, pure attars & luxury perfumes, exotic nuts, and imported delicacies. Experience true luxury with our curated collections delivered with freshness and quality across India." | escape }}
      </p>
    </div>

    <!-- Center Vertical Divider -->
    <div class="gs-brand-stats-v-divider"></div>

    <!-- Right Side: 2x2 Stats Grid -->
    <div class="gs-brand-stats-grid">
      <!-- Stat 1: Stores -->
      <div class="gs-brand-stat-item">
        <div class="gs-brand-stat-icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#DFB85A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21h18v-8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8z"/>
            <path d="M4 11V4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v7"/>
            <path d="M9 21v-4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4"/>
            <path d="M8 7h8"/>
          </svg>
        </div>
        <div class="gs-brand-stat-text">
          <span class="gs-brand-stat-num">{{ section.settings.stat1_num | default: "200+" | escape }}</span>
          <span class="gs-brand-stat-label">{{ section.settings.stat1_label | default: "Stores Across India" | escape }}</span>
        </div>
      </div>

      <!-- Stat 2: Countries -->
      <div class="gs-brand-stat-item">
        <div class="gs-brand-stat-icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#DFB85A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </div>
        <div class="gs-brand-stat-text">
          <span class="gs-brand-stat-num">{{ section.settings.stat2_num | default: "2+" | escape }}</span>
          <span class="gs-brand-stat-label">{{ section.settings.stat2_label | default: "Countries Partnered" | escape }}</span>
        </div>
      </div>

      <!-- Stat 3: Products -->
      <div class="gs-brand-stat-item">
        <div class="gs-brand-stat-icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#DFB85A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a9 9 0 0 0-9 9c0 4.97 4.03 9 9 9s9-4.03 9-9a9 9 0 0 0-9-9z"/>
            <path d="M12 7v5l3 3"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </div>
        <div class="gs-brand-stat-text">
          <span class="gs-brand-stat-num">{{ section.settings.stat3_num | default: "5000+" | escape }}</span>
          <span class="gs-brand-stat-label">{{ section.settings.stat3_label | default: "Happy Customers" | escape }}</span>
        </div>
      </div>

      <!-- Stat 4: Varieties -->
      <div class="gs-brand-stat-item">
        <div class="gs-brand-stat-icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#DFB85A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </div>
        <div class="gs-brand-stat-text">
          <span class="gs-brand-stat-num">{{ section.settings.stat4_num | default: "50+" | escape }}</span>
          <span class="gs-brand-stat-label">{{ section.settings.stat4_label | default: "Varieties Of Premium Items" | escape }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .gs-brand-stats-section {
    position: relative;
    width: 100%;
    background-color: #103f60 !important;
    overflow: hidden;
    padding: 56px 0;
    box-sizing: border-box;
  }

  /* Subtle Damask / Leaf Pattern Overlay matching Navbar Blue */
  .gs-brand-stats-bg-pattern {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0.08;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='1' fill-rule='evenodd'%3E%3Cpath d='M30 30c0-5.5 4.5-10 10-10s10 4.5 10 10-4.5 10-10 10-10-4.5-10-10zm-20 0c0-5.5 4.5-10 10-10s10 4.5 10 10-4.5 10-10 10-10-4.5-10-10zm10-20c5.5 0 10-4.5 10-10S25.5 0 20 0 10 4.5 10 10s4.5 10 10 10zm20 0c5.5 0 10-4.5 10-10S45.5 0 40 0 30 4.5 30 10s4.5 10 10 10zM20 40c-5.5 0-10 4.5-10 10s4.5 10 10 10 10-4.5 10-10-4.5-10-10-10zm20 0c-5.5 0-10 4.5-10 10s4.5 10 10 10 10-4.5 10-10-4.5-10-10-10z'/%3E%3C/g%3E%3C/svg%3E");
    background-repeat: repeat;
  }

  .gs-brand-stats-container {
    position: relative;
    z-index: 2;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }

  .gs-brand-stats-story {
    flex: 1;
    max-width: 540px;
  }

  .gs-brand-stats-title {
    font-size: 24px !important;
    font-weight: 800 !important;
    color: #FFFFFF !important;
    text-transform: uppercase !important;
    letter-spacing: 0.8px !important;
    margin: 0 0 12px 0 !important;
    line-height: 1.3 !important;
    font-family: inherit !important;
  }

  .gs-brand-stats-divider {
    width: 60px;
    height: 2.5px;
    background-color: #DFB85A;
    margin-bottom: 20px;
    border-radius: 2px;
  }

  .gs-brand-stats-desc {
    font-size: 15px !important;
    line-height: 1.7 !important;
    color: rgba(255, 255, 255, 0.88) !important;
    margin: 0 !important;
    font-weight: 400 !important;
  }

  .gs-brand-stats-v-divider {
    width: 1px;
    min-height: 160px;
    background: rgba(255, 255, 255, 0.18);
    margin: 0 48px;
    align-self: stretch;
  }

  .gs-brand-stats-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 36px 48px;
    align-items: center;
  }

  .gs-brand-stat-item {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .gs-brand-stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    border-radius: 12px;
    background: rgba(223, 184, 90, 0.1);
    border: 1px solid rgba(223, 184, 90, 0.25);
  }

  .gs-brand-stat-text {
    display: flex;
    flex-direction: column;
  }

  .gs-brand-stat-num {
    font-size: 28px !important;
    font-weight: 800 !important;
    color: #FFFFFF !important;
    line-height: 1.1 !important;
    letter-spacing: -0.5px !important;
  }

  .gs-brand-stat-label {
    font-size: 13px !important;
    font-weight: 600 !important;
    color: rgba(255, 255, 255, 0.85) !important;
    margin-top: 4px !important;
    line-height: 1.3 !important;
  }

  @media (max-width: 992px) {
    .gs-brand-stats-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 36px;
      padding: 0 24px;
    }

    .gs-brand-stats-story {
      max-width: 100%;
    }

    .gs-brand-stats-v-divider {
      display: none;
    }

    .gs-brand-stats-grid {
      width: 100%;
      gap: 28px 24px;
    }
  }

  @media (max-width: 576px) {
    .gs-brand-stats-section {
      padding: 40px 0;
    }

    .gs-brand-stats-title {
      font-size: 20px !important;
    }

    .gs-brand-stats-desc {
      font-size: 14px !important;
    }

    .gs-brand-stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 16px;
    }

    .gs-brand-stat-icon {
      width: 44px;
      height: 44px;
    }

    .gs-brand-stat-icon svg {
      width: 32px;
      height: 32px;
    }

    .gs-brand-stat-num {
      font-size: 22px !important;
    }

    .gs-brand-stat-label {
      font-size: 12px !important;
    }
  }
</style>

<script>
  (function() {
    function initBrandStatsCounter() {
      const section = document.getElementById('gs-brand-stats-{{ section.id }}');
      if (!section) return;

      const statNums = section.querySelectorAll('.gs-brand-stat-num');
      if (!statNums.length) return;

      let animated = false;

      function startCountUp() {
        if (animated) return;
        animated = true;

        statNums.forEach(el => {
          const originalText = el.textContent.trim();
          const targetNum = parseInt(originalText.replace(/[^0-9]/g, ''), 10);
          const suffix = originalText.replace(/[0-9]/g, '');

          if (isNaN(targetNum)) return;

          const duration = 1800; // ms
          const startTime = performance.now();

          function updateNumber(currentTime) {
            const elapsedTime = currentTime - startTime;
            const progress = Math.min(elapsedTime / duration, 1);
            
            // Ease out quad
            const easeProgress = 1 - (1 - progress) * (1 - progress);
            const currentNum = Math.floor(easeProgress * targetNum);

            el.textContent = currentNum.toLocaleString() + suffix;

            if (progress < 1) {
              requestAnimationFrame(updateNumber);
            } else {
              el.textContent = targetNum.toLocaleString() + suffix;
            }
          }

          requestAnimationFrame(updateNumber);
        });
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            startCountUp();
            observer.disconnect();
          }
        });
      }, { threshold: 0.2 });

      observer.observe(section);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBrandStatsCounter);
    } else {
      initBrandStatsCounter();
    }
  })();
</script>

{% schema %}
{
  "name": "Brand Stats & Story",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GULFSOUQ DATES & LUXURY PRODUCTS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Welcome to Gulfsouq, where an unwavering commitment to authenticity brings you the finest treasures from the Arabian Gulf. Enjoy our unique assortment of dates, harvested with care, pure attars & luxury perfumes, exotic nuts, and imported delicacies. Experience true luxury with our curated collections delivered with freshness and quality across India."
    },
    {
      "type": "text",
      "id": "stat1_num",
      "label": "Stat 1 Number",
      "default": "200+"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Stat 1 Label",
      "default": "Stores Across India"
    },
    {
      "type": "text",
      "id": "stat2_num",
      "label": "Stat 2 Number",
      "default": "2+"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Stat 2 Label",
      "default": "Countries Partnered"
    },
    {
      "type": "text",
      "id": "stat3_num",
      "label": "Stat 3 Number",
      "default": "5000+"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Stat 3 Label",
      "default": "Happy Customers"
    },
    {
      "type": "text",
      "id": "stat4_num",
      "label": "Stat 4 Number",
      "default": "50+"
    },
    {
      "type": "text",
      "id": "stat4_label",
      "label": "Stat 4 Label",
      "default": "Varieties Of Premium Items"
    }
  ],
  "presets": [
    {
      "name": "Brand Stats & Story"
    }
  ]
}
{% endschema %}

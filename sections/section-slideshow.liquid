  document.addEventListener('DOMContentLoaded', function() {
    if (typeof Swiper !== 'undefined') {
      new Swiper('.side-promo-swiper-{{ section.id }}', {
        loop: true,
        autoplay: {
          delay: 4500,
          disableOnInteraction: false
        },
        speed: 700,
        effect: 'fade',
        fadeEffect: { crossFade: true }
      });
    }

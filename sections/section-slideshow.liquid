    #shopify-section-{{ section.id }} .hero-shop-now-btn span,
    #shopify-section-{{ section.id }} .m6fr .link-btn a *,
    #shopify-section-{{ section.id }} .m6fr .link-btn a span,
    #root #shopify-section-{{ section.id }} .hero-shop-now-btn span,
    #root #shopify-section-{{ section.id }} .hero-shop-now-btn *,
    #root #shopify-section-{{ section.id }} .m6fr .link-btn a span,
    #root #shopify-section-{{ section.id }} .m6fr .link-btn a * {

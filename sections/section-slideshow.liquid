    margin: 0 !important;
    margin-bottom: 0 !important;
  }

  #shopify-section-{{ section.id }} .swiper-slide,
  #shopify-section-{{ section.id }} .swiper-slide-active,
  #shopify-section-{{ section.id }} .m6fr .swiper-slide,
  #shopify-section-{{ section.id }} .s4wi .swiper-slide,
  #shopify-section-{{ section.id }} .wide .swiper-slide,
  #root #shopify-section-{{ section.id }} .swiper-slide,

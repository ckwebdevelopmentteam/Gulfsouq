    #shopify-section-{{ section.id }} .m6fr,
    #shopify-section-{{ section.id }} .m6fr article,
    #shopify-section-{{ section.id }} .swiper-outer,
    #shopify-section-{{ section.id }} .swiper-wrapper,
    #shopify-section-{{ section.id }} .swiper-slide,
    #shopify-section-{{ section.id }} .swiper-slide-active,
    #root #shopify-section-{{ section.id }} .swiper-slide,
    .t1as #shopify-section-{{ section.id }} .swiper-slide,
    .t1as #shopify-section-{{ section.id }} .m6fr.wide.s4wi article,
    .t1as #shopify-section-{{ section.id }} .m6fr.wide article,
    .t1as #shopify-section-{{ section.id }} .swiper-slide article {
      height: 480px !important;
      min-height: 440px !important;
      max-height: 500px !important;
      padding: 0 !important;
      margin: 0 !important;
      margin-bottom: 0 !important;
    }

    #shopify-section-{{ section.id }} .m6fr article {
      border-radius: 0 !important;
      overflow: hidden !important;
      border: none !important;
      width: 100% !important;
      height: 480px !important;
      min-height: 440px !important;
      max-height: 500px !important;
      margin: 0 !important;
      margin-bottom: 0 !important;
      padding: 0 !important;
      box-sizing: border-box !important;
      position: relative !important;
    }

    #shopify-section-{{ section.id }} .m6fr figure {
      position: absolute !important;

      left: 0 !important;
      right: 0 !important;
      margin: 0 auto !important;
    }

    #shopify-section-{{ section.id }} .swiper-pagination-bullet {
      width: 10px !important;
      height: 10px !important;
      background: rgba(255, 255, 255, 0.6) !important;
      opacity: 0.85 !important;

    #shopify-section-{{ section.id }} .m6fr .link-btn a,
    #shopify-section-{{ section.id }} .m6fr a.hero-shop-now-btn,
    #shopify-section-{{ section.id }} .m6fr a.overlay-primary,
    #shopify-section-{{ section.id }} .m6fr a.overlay-secondary,

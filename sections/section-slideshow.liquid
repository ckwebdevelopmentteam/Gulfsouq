    padding: 0 !important;
    margin: 0 !important;
    margin-bottom: 0 !important;
    box-sizing: border-box !important;
    position: relative !important;
  }

  #shopify-section-{{ section.id }} .swiper-scrollbar,
  #shopify-section-{{ section.id }} .scrollbar,
  #shopify-section-{{ section.id }} .nav-scroll,
  #shopify-section-{{ section.id }} ::-webkit-scrollbar {
    display: none !important;

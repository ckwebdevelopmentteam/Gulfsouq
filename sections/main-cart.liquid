{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- liquid
  assign form_id = 'cart-form-' | append: section.id
  assign product_image_ratio = settings.product_image_ratio
  case product_image_ratio
    when '310x430'
      assign image_width = 160
      assign image_height = 200
    when '430x310'
      assign image_width = 160
      assign image_height = 120
    else
      assign image_width = 160
      assign image_height = 160
  endcase

  assign free_shipping_amount = settings.free_shipping_amount | replace: ',', '.' | times: 1
  assign has_free_shipping_amount = false
  if settings.enable_free_shipping
    assign has_free_shipping_amount = true
    assign free_shipping_amount = settings.free_shipping_amount | replace: ',', '.' | times: 1 | times: 100
  endif
-%}

{%- if cart.item_count == 0 -%}
  <article class="cart-empty gs-cart-empty-state text-center align-center">
    <div class="gs-empty-icon-wrapper">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#ad8730" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
    </div>
    <h1 class="gs-empty-title">{{ 'cart.empty_title' | t | default: 'Your Shopping Cart is Empty' }}</h1>
    <p class="gs-empty-subtitle">{{ 'cart.empty_subtitle' | t | default: "Looks like you haven't added any items yet. Explore our curated Gulf products, imported chocolates, authentic perfumes, and luxury gift hampers!" }}</p>
    <div class="gs-empty-actions">
      <a href="{{ routes.collections_url }}" class="gs-empty-cta-btn">
        <span>Explore Best Sellers</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>

    <div class="gs-empty-categories">
      <p class="gs-empty-cat-title">Popular Categories to Explore:</p>
      <div class="gs-empty-cat-pills">
        <a href="/collections/athar-and-perfume" class="gs-cat-pill">🧴 Perfumes</a>
        <a href="/collections/chocolates" class="gs-cat-pill">🍫 Chocolates</a>
        <a href="/collections/dates" class="gs-cat-pill">🌴 Dates</a>
        <a href="/collections/homecoming-boxes" class="gs-cat-pill">🎁 Pravasi-Petti</a>
        <a href="/collections/nuts-dry-fruits" class="gs-cat-pill">🌰 Nuts & Dry Fruits</a>
        <a href="/collections/offers" class="gs-cat-pill">🔥 Special Offers</a>
      </div>
    </div>
  </article>
{%- else -%}
  <article class="form-cart gs-cart-page-wrap section-width-{{ section.settings.width }}" data-totalqty="{{ cart.item_count }}" data-totalprice="{{ cart.total_price | money }}">
    
    <!-- Top Header & Breadcrumbs -->
    <header class="gs-cart-page-header">
      <div class="gs-cart-title-group">
        <h1 class="gs-cart-main-heading">
          {{ 'cart.title' | t | default: 'Your Shopping Cart' }}
          <span class="gs-cart-header-badge">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
        </h1>
      </div>
      <a href="{{ routes.collections_url }}" class="gs-cart-continue-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        <span>{{ 'cart.continue_shopping' | t | default: 'Continue Shopping' }}</span>
      </a>
    </header>

    <!-- Main Two-Column Layout -->
    <div class="gs-cart-layout-container">
      
      <!-- Left Column: Items, Free Shipping Bar, Notes -->
      <div class="gs-cart-main-col">
        
        <!-- Free Shipping Progress Bar Card -->
        {%- if has_free_shipping_amount and cart.requires_shipping -%}
          <div class="gs-free-shipping-card">
            {%- if free_shipping_amount > cart.total_price -%}
              {%- assign amount_remaining = free_shipping_amount | minus: cart.total_price | money -%}
              {%- assign progress_pct = cart.total_price | times: 100.0 | divided_by: free_shipping_amount | round -%}
              <div class="gs-fs-header-row">
                <span class="gs-fs-icon">🚚</span>
                <p class="gs-fs-msg">
                  Add <strong>{{ amount_remaining }}</strong> more to unlock <span class="gs-fs-highlight">FREE Express Shipping!</span>
                </p>
              </div>
              <div class="gs-fs-bar-track">
                <div class="gs-fs-bar-fill" style="width: {{ progress_pct | at_most: 100 }}%;"></div>
              </div>
            {%- else -%}
              <div class="gs-fs-header-row unlocked">
                <span class="gs-fs-icon">🎉</span>
                <p class="gs-fs-msg unlocked">
                  Congratulations! You've qualified for <strong>FREE Express Shipping!</strong>
                </p>
              </div>
              <div class="gs-fs-bar-track">
                <div class="gs-fs-bar-fill completed" style="width: 100%;"></div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Cart Items Card -->
        <div class="gs-cart-items-card">
          <!-- Desktop Header Row -->
          <div class="gs-cart-table-head">
            <span class="gs-th-item">Product</span>
            <span class="gs-th-price">Price</span>
            <span class="gs-th-qty">Quantity</span>
            <span class="gs-th-total">Total</span>
            <span class="gs-th-action"></span>
          </div>

          <!-- Items List -->
          <ul class="gs-cart-items-list">
            {%- for line_item in cart.items -%}
              {%- liquid
                assign can_update_quantity = line_item.instructions.can_update_quantity | default: true, allow_false: true
                assign can_remove = line_item.instructions.can_remove | default: true, allow_false: true
              -%}
              <li class="gs-cart-item-row" data-line="{{ forloop.index }}">
                
                <!-- Product Thumbnail & Details -->
                <div class="gs-item-thumb-col">
                  {%- if line_item.image -%}
                    <a href="{{ line_item.url }}" class="gs-item-img-link">
                      <img
                        src="{{ line_item | image_url: width: 200, height: 200, crop: 'center' }}"
                        width="84"
                        height="84"
                        alt="{{ line_item.image.alt | default: line_item.title | escape }}"
                        loading="lazy"
                        class="gs-item-img"
                      >
                    </a>
                  {%- else -%}
                    <div class="gs-item-img-placeholder">
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </div>
                  {%- endif -%}
                </div>

                <!-- Product Info -->
                <div class="gs-item-info-col">
                  {%- if line_item.product.vendor -%}
                    <span class="gs-item-vendor">{{ line_item.product.vendor }}</span>
                  {%- endif -%}
                  <h3 class="gs-item-title">
                    <a href="{{ line_item.url }}">{{ line_item.product.title }}</a>
                  </h3>

                  <!-- Variant options -->
                  {%- if line_item.item_components.size > 0 -%}
                    <div class="gs-item-bundle-meta">
                      <span>{{ line_item.item_components | sum: 'quantity' }} {{ 'cart.product.items' | t }} included</span>
                    </div>
                  {%- else -%}
                    <div class="gs-item-options-wrap">
                      {% render 'cart-item-options', line_item: line_item, origin: 'cartpage', bundle: false %}
                    </div>
                  {%- endif -%}

                  <span class="gs-stock-status">In Stock</span>
                </div>

                <!-- Unit Price Column -->
                <div class="gs-item-price-col">
                  {%- if line_item.variant.compare_at_price > line_item.variant.price -%}
                    <span class="gs-old-price">{{ line_item.variant.compare_at_price | money }}</span>
                  {%- endif -%}
                  <span class="gs-unit-price">{{ line_item.final_price | money }}</span>
                </div>

                <!-- Quantity Controls Stepper -->
                <div class="gs-item-qty-col">
                  <div class="gs-qty-stepper {% unless can_update_quantity %}hidden{% endunless %}" style="display: inline-flex !important; flex-direction: row !important; align-items: center !important; height: 32px !important; border: 1.5px solid #CBD5E1 !important; border-radius: 6px !important; background: #FFFFFF !important; margin: 0 !important; padding: 0 !important; box-sizing: border-box !important; overflow: hidden !important;">
                    <button type="button" class="gs-qty-btn gs-qty-minus" aria-label="Decrease quantity" data-line="{{ forloop.index }}" style="display: inline-flex !important; align-items: center !important; justify-content: center !important; width: 28px !important; height: 32px !important; border: none !important; background: #F8FAFC !important; color: #103F60 !important; font-size: 15px !important; font-weight: 700 !important; cursor: pointer !important; padding: 0 !important; margin: 0 !important; user-select: none !important;">−</button>
                    <input
                      type="number"
                      name="updates[]"
                      id="qty-main-{{ line_item.index | plus: 1 }}"
                      class="disable-on-change gs-qty-input"
                      value="{{ line_item.quantity }}"
                      data-line="{{ forloop.index }}"
                      aria-label="quantity"
                      autocomplete="off"
                      form="{{ form_id }}"
                      min="1"
                      {% if line_item.variant.inventory_management == 'shopify' and line_item.variant.inventory_policy == 'deny' -%}
                        max="{{ line_item.variant.inventory_quantity }}"
                      {% elsif line_item.variant.quantity_rule.max %}
                        max="{{ line_item.variant.quantity_rule.max }}"
                      {% endif %}
                      {% if line_item.variant.quantity_rule.increment %}
                        step="{{ line_item.variant.quantity_rule.increment }}"
                      {% endif %}
                      style="width: 36px !important; min-width: 36px !important; max-width: 36px !important; height: 32px !important; border: none !important; border-left: 1px solid #E2E8F0 !important; border-right: 1px solid #E2E8F0 !important; background: #FFFFFF !important; text-align: center !important; font-size: 13.5px !important; font-weight: 700 !important; color: #0F172A !important; padding: 0 !important; margin: 0 !important; box-shadow: none !important; outline: none !important;"
                    >
                    <button type="button" class="gs-qty-btn gs-qty-plus" aria-label="Increase quantity" data-line="{{ forloop.index }}" style="display: inline-flex !important; align-items: center !important; justify-content: center !important; width: 28px !important; height: 32px !important; border: none !important; background: #F8FAFC !important; color: #103F60 !important; font-size: 15px !important; font-weight: 700 !important; cursor: pointer !important; padding: 0 !important; margin: 0 !important; user-select: none !important;">+</button>
                  </div>
                </div>

                <!-- Total Column -->
                <div class="gs-item-total-col">
                  <span class="gs-line-total-price">{{ line_item.final_line_price | money }}</span>
                  {%- if line_item.original_line_price > line_item.final_line_price -%}
                    <span class="gs-line-saved-badge">Saved {{ line_item.original_line_price | minus: line_item.final_line_price | money }}</span>
                  {%- endif -%}
                </div>

                <!-- Remove Button Column -->
                <div class="gs-item-action-col">
                  <a
                    class="remove-from-cart-link gs-remove-btn"
                    href="{{ line_item.url_to_remove }}"
                    data-line="{{ forloop.index }}"
                    aria-label="{{ 'cart.product.remove' | t }}"
                    title="Remove item"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      <line x1="10" y1="11" x2="10" y2="17"></line>
                      <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                  </a>
                </div>

              </li>

              <!-- Bundle Item Breakdown (if any) -->
              {% if line_item.item_components.size > 0 %}
                <li class="gs-bundle-components-row">
                  <ul class="gs-bundle-items-sublist">
                    {%- for component in line_item.item_components -%}
                      <li class="gs-bundle-subitem">
                        {%- if component.image -%}
                          <img
                            src="{{ component | image_url: width: 60, height: 60, crop: 'center' }}"
                            width="36"
                            height="36"
                            alt="{{ component.title | escape }}"
                            class="gs-bundle-subimg"
                          >
                        {%- endif -%}
                        <span class="gs-bundle-subtitle">{{ component.quantity }} × {{ component.product.title }}</span>
                      </li>
                    {%- endfor -%}
                  </ul>
                </li>
              {% endif %}

            {%- endfor -%}
          </ul>
        </div>

        <!-- Order Notes / Gift Message Card -->
        {%- if section.settings.show_order_notes -%}
          <div class="gs-cart-notes-card">
            <details class="gs-notes-accordion" {% if cart.note != blank %}open{% endif %}>
              <summary class="gs-notes-summary">
                <span class="gs-notes-label">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                  <span>{{ 'cart.add_note' | t | default: 'Special instructions for the seller / Delivery note' }}</span>
                </span>
                <svg class="gs-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="gs-notes-content">
                <textarea
                  name="note"
                  id="note_{{ section.id }}"
                  form="{{ form_id }}"
                  class="gs-notes-textarea"
                  placeholder="{{ 'cart.add_note_placeholder' | t | default: 'Add special delivery instructions, gift message, or order notes here...' }}"
                >{{ cart.note }}</textarea>
              </div>
            </details>
          </div>
        {%- endif -%}

        <!-- Store Confidence & Assurance Badges (Desktop & Mobile) -->
        <div class="gs-cart-assurances-strip">
          <div class="gs-assurance-item">
            <div class="gs-assure-icon">🛡️</div>
            <div class="gs-assure-text">
              <strong>100% Genuine</strong>
              <span>Imported Gulf Products</span>
            </div>
          </div>
          <div class="gs-assurance-item">
            <div class="gs-assure-icon">🚚</div>
            <div class="gs-assure-text">
              <strong>Fast Dispatch</strong>
              <span>Safe Delivery Across India</span>
            </div>
          </div>
          <div class="gs-assurance-item">
            <div class="gs-assure-icon">💬</div>
            <div class="gs-assure-text">
              <strong>Order Support</strong>
              <span>Direct WhatsApp Assistance</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Order Summary Sidebar (Sticky) -->
      <aside class="gs-cart-sidebar-col">
        <div class="gs-summary-card">
          
          <h2 class="gs-summary-title">Order Summary</h2>

          <!-- Subtotal & Line Totals Breakdown -->
          <div class="gs-summary-breakdown">
            
            <div class="gs-breakdown-row">
              <span class="gs-row-label">{{ 'cart.total_products' | t | default: 'Total products' }} ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
              <span class="gs-row-value">{{ cart.items_subtotal_price | money }}</span>
            </div>

            <!-- Cart-Level Discounts (if applied) -->
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="gs-breakdown-row gs-discount-row">
                  <span class="gs-row-label gs-discount-badge-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                    <span>{{ discount.title }}</span>
                    {% if discount.type == 'discount_code' -%}
                      <a class="remove-discount gs-remove-discount-btn" data-discount-code="{{ discount.title }}" title="Remove discount">✕</a>
                    {%- endif %}
                  </span>
                  <span class="gs-row-value gs-discount-amount">-{{ discount.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}

            <!-- Shipping Estimate Row -->
            <div class="gs-breakdown-row">
              <span class="gs-row-label">Estimated Shipping</span>
              <span class="gs-row-value">
                {%- if has_free_shipping_amount and cart.total_price >= free_shipping_amount -%}
                  <span class="gs-free-shipping-tag">FREE</span>
                {%- else -%}
                  <span class="gs-calculated-tag">Calculated at checkout</span>
                {%- endif -%}
              </span>
            </div>

          </div>

          <!-- Taxes and Shipping Notice -->
          <p class="gs-summary-tax-notice">
            {%- if cart.taxes_included -%}
              {{- 'cart.total_including_tax' | t | default: 'Total including VAT' -}}
            {%- else -%}
              {{- 'cart.total_excluding_tax' | t | default: 'Taxes and shipping calculated at checkout' -}}
            {%- endif -%}
          </p>

          <div class="gs-summary-divider"></div>

          <!-- Grand Total Row -->
          <div class="gs-summary-total-row">
            <span class="gs-total-label">Estimated Total</span>
            <span class="gs-total-price">{{ cart.total_price | money }}</span>
          </div>

          <!-- Promo Code / Discount Input Box -->
          {%- if section.settings.enable_discount_tab -%}
            <div class="gs-summary-discount-box">
              <form class="discount-form gs-discount-form">
                <div class="gs-discount-input-row">
                  <div class="gs-discount-field">
                    <svg class="gs-promo-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                    <input
                      type="text"
                      id="discount"
                      name="discount"
                      class="gs-discount-input"
                      placeholder="{{ 'cart.discount_code.placeholder' | t | default: 'Promo code' }}"
                      autocomplete="off"
                    >
                  </div>
                  <button type="submit" class="gs-discount-apply-btn">
                    <span>{{ 'cart.discount_code.submit' | t | default: 'Apply' }}</span>
                  </button>
                </div>
                <div class="gs-discount-feedback">
                  <span class="not-applicable-error-message gs-discount-err hidden">
                    {{- 'cart.discount_code.not_applicable' | t | default: 'Discount code cannot be applied to your cart' -}}
                  </span>
                  <span class="already-applied-error-message gs-discount-err hidden">
                    {{- 'cart.discount_code.already_applied' | t | default: 'Discount code is already applied to your cart' -}}
                  </span>
                </div>
              </form>
            </div>
          {%- endif -%}

          <!-- Main Checkout Form & CTA -->
          <form class="f8vl gs-cart-checkout-form" id="{{ form_id }}" data-hold="0" action="{{ routes.cart_url }}" method="post">
            <input type="hidden" name="attributes[collection_grid_view]" value="">
            <input type="hidden" name="attributes[collection_grid_view_mobile]" value="">
            <input type="hidden" name="attributes[collection_view]" value="">
            <input type="hidden" name="checkout" value="Checkout">

            <!-- Optional Terms and Conditions Checkbox -->
            {% if section.settings.enable_terms_checkbox and section.settings.terms_text != empty %}
              <div class="gs-terms-checkbox-wrap">
                <input
                  type="checkbox"
                  id="check_{{ section.id }}"
                  aria-label="{{ section.settings.terms_text | strip_html | escape }}"
                  data-bind="check_{{ section.id }}_mobile"
                  required
                  class="gs-custom-checkbox"
                >
                <label for="check_{{ section.id }}" class="gs-terms-label">
                  {{- section.settings.terms_text | remove: '</p>' | remove: '<p>' | replace: 'privacy_policy', 'privacy policy' | replace: 'terms_and_conditions', 'terms & conditions' -}}
                </label>
              </div>
            {% endif %}

            <!-- Primary Checkout Button -->
            <button
              type="submit"
              class="gs-checkout-main-btn"
              name="checkout"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="gs-btn-lock-svg"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" fill="none" stroke="#FFFFFF" stroke-width="2.2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4" fill="none" stroke="#FFFFFF" stroke-width="2.2"></path></svg>
              <span class="gs-btn-text">{{ 'cart.checkout' | t | default: 'CHECKOUT' }}</span>
            </button>
          </form>

          <!-- Dynamic Express Checkout Buttons (Shop Pay, GPay, etc.) -->
          {%- if section.settings.show_dynamic_buybutton and additional_checkout_buttons -%}
            <div class="gs-additional-checkout-buttons">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}

          <!-- Safe & Secure SSL Badge -->
          <div class="gs-secure-badge-row">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
            <span>Guaranteed Safe & Secure Checkout</span>
          </div>

          <!-- Payment Methods Accepted Icons -->
          {%- if section.settings.show_payment_methods -%}
            <div class="gs-payment-methods-box">
              <span class="gs-payment-title">ACCEPTED PAYMENT METHODS</span>
              <ul class="gs-payment-icons-list">
                {% for payment_method in shop.enabled_payment_types %}
                  <li>{{ payment_method | payment_type_svg_tag }}</li>
                {% endfor %}
              </ul>
            </div>
          {%- endif -%}

          <!-- App & Tab Blocks if any -->
          {%- assign tab_blocks = section.blocks | where: 'type', 'tab' %}
          {%- if tab_blocks.size > 0 -%}
            <div class="gs-summary-tabs">
              {%- for block in tab_blocks -%}
                <details class="gs-tab-detail">
                  <summary class="gs-tab-summary">{{ block.settings.title }}</summary>
                  <div class="gs-tab-content">{{ block.settings.text }}</div>
                </details>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'shipping_timer' and cart.requires_shipping -%}
              {%- render 'shipping-timer' -%}
            {%- elsif block.type == 'usp' and block.settings.usp != empty -%}
              <div class="gs-summary-usp-block" {{ block.shopify_attributes }}>
                {{ block.settings.usp }}
              </div>
            {%- endif -%}
          {%- endfor -%}

        </div>
      </aside>

    </div>

    <!-- Mobile Fixed Bottom Checkout Sticky Bar -->
    <div class="gs-mobile-sticky-checkout-bar">
      <div class="gs-sticky-info">
        <span class="gs-sticky-label">Total Amount</span>
        <span class="gs-sticky-price">{{ cart.total_price | money }}</span>
      </div>
      <button
        type="submit"
        class="gs-sticky-checkout-btn"
        name="checkout"
        form="{{ form_id }}"
      >
        <span>CHECKOUT</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </button>
    </div>

  </article>
{%- endif -%}


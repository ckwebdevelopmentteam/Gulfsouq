{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- liquid
  assign words = article.content | split: ' '
  if words.size < 360
    assign minutes = 1
  else
    assign minutes = words.size | divided_by: 180
  endif
-%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap');

  /* =========================================================
     BLOG ARTICLE HERO & BANNER STYLING
     ========================================================= */
  .shopify-section-main-article .m6fr.wide,
  #shopify-section-{{ section.id }} .m6fr.wide {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 40px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  .shopify-section-main-article .m6fr figure .img-overlay,
  #shopify-section-{{ section.id }} .m6fr figure .img-overlay {
    background: linear-gradient(180deg, rgba(10, 37, 64, 0.25) 0%, rgba(10, 37, 64, 0.72) 55%, rgba(10, 37, 64, 0.94) 100%) !important;
    opacity: 1 !important;
    display: block !important;
  }

  .shopify-section-main-article .m6fr article > div,
  #shopify-section-{{ section.id }} .m6fr article > div {
    position: relative !important;
    z-index: 10 !important;
    padding: 50px 44px 40px !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6) !important;
  }

  .shopify-section-main-article .m6fr article h1,
  .shopify-section-main-article .m6fr article h2,
  #shopify-section-{{ section.id }} .m6fr article h1,
  #shopify-section-{{ section.id }} .m6fr article h2 {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif !important;
    font-size: 40px !important;
    font-weight: 700 !important;
    line-height: 1.25 !important;
    margin-bottom: 16px !important;
    letter-spacing: -0.5px !important;
    background: none !important;
  }

  .shopify-section-main-article .m6fr article p,
  #shopify-section-{{ section.id }} .m6fr article p {
    color: rgba(255, 255, 255, 0.92) !important;
    -webkit-text-fill-color: rgba(255, 255, 255, 0.92) !important;
    font-size: 15px !important;
    font-weight: 500 !important;
    margin: 0 !important;
  }

  .shopify-section-main-article .m6fr article time,
  #shopify-section-{{ section.id }} .m6fr article time {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  /* Reading time pill in banner */
  .gs-reading-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.18);
    padding: 3px 12px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
    margin-left: 8px;
    font-size: 13.5px;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  /* =========================================================
     CRITICAL FIX: ARTICLE BODY WORD VISIBILITY & TYPOGRAPHY
     ========================================================= */
  .gs-article-body-wrapper,
  .gs-article-body-wrapper p,
  .gs-article-body-wrapper div,
  .gs-article-body-wrapper span,
  .gs-article-body-wrapper li,
  #shopify-section-{{ section.id }} .size-content p,
  #shopify-section-{{ section.id }} .size-content div,
  #shopify-section-{{ section.id }} .size-content span,
  #shopify-section-{{ section.id }} .size-content li {
    color: #2d3748 !important;
    -webkit-text-fill-color: #2d3748 !important;
    line-height: 1.85 !important;
    font-size: 17.5px !important;
  }

  .gs-article-body-wrapper p,
  #shopify-section-{{ section.id }} .size-content p {
    margin-bottom: 24px !important;
  }

  /* Headings in Article Body */
  .gs-article-body-wrapper h1,
  .gs-article-body-wrapper h2,
  .gs-article-body-wrapper h3,
  .gs-article-body-wrapper h4,
  .gs-article-body-wrapper h5,
  .gs-article-body-wrapper h6,
  #shopify-section-{{ section.id }} .size-content h1:not(.m6fr h1),
  #shopify-section-{{ section.id }} .size-content h2:not(.m6fr h2),
  #shopify-section-{{ section.id }} .size-content h3:not(.m6fr h3),
  #shopify-section-{{ section.id }} .size-content h4:not(.m6fr h4) {
    color: #0a2540 !important;
    -webkit-text-fill-color: #0a2540 !important;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif !important;
    font-weight: 700 !important;
    background: none !important;
    letter-spacing: -0.3px !important;
  }

  .gs-article-body-wrapper h2,
  #shopify-section-{{ section.id }} .size-content h2:not(.m6fr h2) {
    font-size: 28px !important;
    margin-top: 48px !important;
    margin-bottom: 18px !important;
    line-height: 1.35 !important;
    border-left: 4px solid #ff7a00 !important;
    padding-left: 16px !important;
  }

  .gs-article-body-wrapper h3,
  #shopify-section-{{ section.id }} .size-content h3:not(.m6fr h3) {
    font-size: 22px !important;
    margin-top: 36px !important;
    margin-bottom: 14px !important;
    line-height: 1.4 !important;
  }

  /* Bold / Strong */
  .gs-article-body-wrapper strong,
  .gs-article-body-wrapper b,
  #shopify-section-{{ section.id }} .size-content strong,
  #shopify-section-{{ section.id }} .size-content b {
    color: #0a2540 !important;
    -webkit-text-fill-color: #0a2540 !important;
    font-weight: 700 !important;
  }

  /* CRITICAL: ALL LINKS & WORDS PREVIOUSLY INVISIBLE (WHITE ON WHITE) */
  .gs-article-body-wrapper a,
  #shopify-section-{{ section.id }} .size-content a:not(.m6fr a):not([class*="link-btn"]):not([class*="btn"]) {
    color: #ff7a00 !important;
    -webkit-text-fill-color: #ff7a00 !important;
    font-weight: 600 !important;
    text-decoration: underline !important;
    text-decoration-color: rgba(255, 122, 0, 0.45) !important;
    text-decoration-thickness: 1.5px !important;
    text-underline-offset: 3px !important;
    transition: all 0.2s ease !important;
  }

  .gs-article-body-wrapper a:hover,
  #shopify-section-{{ section.id }} .size-content a:not(.m6fr a):not([class*="link-btn"]):not([class*="btn"]):hover {
    color: #0a2540 !important;
    -webkit-text-fill-color: #0a2540 !important;
    text-decoration-color: #0a2540 !important;
  }

  /* Table of Contents & Lists */
  .gs-article-body-wrapper ul,
  .gs-article-body-wrapper ol,
  #shopify-section-{{ section.id }} .size-content ul:not(.l4in):not(.l4sc),
  #shopify-section-{{ section.id }} .size-content ol {
    margin-bottom: 28px !important;
    padding-left: 24px !important;
    line-height: 1.8 !important;
  }

  .gs-article-body-wrapper li,
  #shopify-section-{{ section.id }} .size-content li:not(.l4in li):not(.l4sc li) {
    margin-bottom: 10px !important;
  }

  /* Auto-card styling for Table of Contents */
  .gs-article-body-wrapper ul:has(a),
  .gs-article-body-wrapper ol:has(a),
  #shopify-section-{{ section.id }} .size-content ul:has(a):not(.l4sc):not(.l4in),
  #shopify-section-{{ section.id }} .size-content ol:has(a) {
    background-color: #f8fafc !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 16px !important;
    padding: 24px 28px 24px 44px !important;
    margin: 32px 0 40px !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03) !important;
  }

  /* Blockquotes */
  .gs-article-body-wrapper blockquote,
  #shopify-section-{{ section.id }} .size-content blockquote {
    background-color: #fff9f2 !important;
    border-left: 4px solid #ff7a00 !important;
    padding: 20px 24px !important;
    margin: 32px 0 !important;
    border-radius: 0 12px 12px 0 !important;
    font-style: italic !important;
    color: #475569 !important;
    -webkit-text-fill-color: #475569 !important;
  }

  /* Images inside article */
  .gs-article-body-wrapper img,
  #shopify-section-{{ section.id }} .size-content img:not(.m6fr img) {
    border-radius: 14px !important;
    max-width: 100% !important;
    height: auto !important;
    margin: 28px 0 !important;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.07) !important;
    display: block !important;
  }

  /* Tags */
  #shopify-section-{{ section.id }} p.link-btn.tags a {
    display: inline-block !important;
    background-color: #f1f5f9 !important;
    color: #0a2540 !important;
    -webkit-text-fill-color: #0a2540 !important;
    padding: 7px 18px !important;
    border-radius: 30px !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    margin: 0 8px 10px 0 !important;
    border: 1px solid #e2e8f0 !important;
    transition: all 0.25s ease !important;
  }

  #shopify-section-{{ section.id }} p.link-btn.tags a:hover {
    background-color: #ff7a00 !important;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    border-color: #ff7a00 !important;
    transform: translateY(-2px) !important;
  }

  /* Breadcrumbs styling on article page */
  .shopify-section-breadcrumbs .n6br ol li a,
  .shopify-section-breadcrumbs .n6br ol li {
    color: #64748b !important;
    text-decoration: none !important;
    font-size: 13.5px !important;
  }

  .shopify-section-breadcrumbs .n6br ol li a:hover {
    color: #ff7a00 !important;
  }

  .shopify-section-breadcrumbs .n6br ol li:last-child {
    color: #0a2540 !important;
    font-weight: 600 !important;
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 768px) {
    .shopify-section-main-article .m6fr article h1,
    #shopify-section-{{ section.id }} .m6fr article h1 {
      font-size: 26px !important;
    }

    .shopify-section-main-article .m6fr article > div,
    #shopify-section-{{ section.id }} .m6fr article > div {
      padding: 30px 20px 24px !important;
    }

    .gs-article-body-wrapper p,
    #shopify-section-{{ section.id }} .size-content p {
      font-size: 16px !important;
    }

    .gs-article-body-wrapper h2,
    #shopify-section-{{ section.id }} .size-content h2:not(.m6fr h2) {
      font-size: 23px !important;
      margin-top: 36px !important;
    }
  }
</style>

<div class="{% if section.settings.compact %}w940 align-center{% endif %} {% if section.settings.big_fontsize %}size-content{% endif %}">
{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when '@app' -%}
      {% render block %}
    {%- when 'spacer' -%}
      <div class="module-spacer" style="margin-bottom:{{ block.settings.height }}px;" {{ block.shopify_attributes }}></div>
    {%- when 'title' -%}
      {%- if block.settings.show_banner -%}
        <div class="
          m6fr
          wide
          mobile-text-center
        " {{ block.shopify_attributes }}>
          <article class="palette-{{ block.settings.color_palette | default: 'scheme-4' }}
          module-color-palette align-start">
            <figure>
              <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 | default: 0.35 }}"></span>
              <picture>
                {%- if article.image -%}
                  <img
                    src="{{ article.image | image_url: width: 100, height: 100, width: 1400 }}"
                    srcset="{% render 'image-srcset', image: article.image %}"
                    sizes="
                      100vw
                    "
                    width="1400"
                    height="530"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    loading="{% if section.index > 2 %}lazy{% else %}eager{% endif %}"
                  >
                {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </picture>
            </figure>
            <div>
              <{{ block.settings.title_size }}>{{ article.title }}</{{ block.settings.title_size }}>
              {%- if block.settings.show_author or block.settings.show_date or block.settings.show_article_reading_time -%}
                <p>
                  {%- if block.settings.show_date and article.published_at -%}{{ article.published_at | time_tag: format: 'month_day_year' }}{%- endif -%}
                  {%- if block.settings.show_author and block.settings.show_date -%}, {% endif -%}
                  {%- if block.settings.show_author -%}{{ 'blog.written_by' | t }} {{ article.author | default: 'Gulf Souq' }}{%- endif -%}
                  {%- if block.settings.show_article_reading_time -%}
                    <span class="gs-reading-badge">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span>{{ minutes }} min read</span>
                    </span>
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </article>
        </div>
      {%- else -%}
        <header {{ block.shopify_attributes }} style="text-align: center; margin-bottom: 36px;">
          <{{ block.settings.title_size }} style="font-family: 'Playfair Display', Georgia, serif; font-size: 38px; color: #0a2540; line-height: 1.25;">{{ article.title }}</{{ block.settings.title_size }}>
          {%- if block.settings.show_author or block.settings.show_date or block.settings.show_article_reading_time -%}
            <ul class="l4in a" style="justify-content: center; color: #64748b;">
              <li>
                {%- if block.settings.show_date %}{{ article.published_at | time_tag: format: 'month_day_year' }}{%- endif -%}
                {% if block.settings.show_author and block.settings.show_date %}, {% endif %}
                {%- if block.settings.show_author -%}{{ 'blog.written_by' | t }} {{ article.author }}{%- endif -%}
              </li>
              {%- if block.settings.show_article_reading_time -%}<li>{{ 'blog.reading_time' | t: count: minutes, minutes: minutes }}</li>{%- endif -%}
            </ul>
          {%- endif -%}
        </header>
      {%- endif -%}
    {%- when 'featured_image' -%}
      {%- if article.image -%}
        <figure class="lead" {{ block.shopify_attributes }}>
          <picture>
            <img
              src="{{ article.image | image_url: width: 100, height: 100, width: 1400 }}"
              srcset="{% render 'image-srcset', image: article.image %}"
              sizes="
                {% if settings.width < 2000 %}
                  (min-width: 1300px) {% if section.settings.compact %}940px{% else %}{{ settings.width }}px{% endif %},
                  (min-width: 940px) {% if section.settings.compact %}940px{% else %}100vw{% endif %},
                {% endif %}
                100vw
              "
              width="1400"
              height="530"
              alt="{{ article.image.alt | default: article.title | escape }}"
              loading="{% if section.index > 2 %}lazy{% else %}eager{% endif %}"
            >
          </picture>
        </figure>
      {%- endif -%}
    {%- when 'excerpt' -%}
      {%- if article.excerpt -%}
        <div class="gs-article-lead-excerpt" style="font-size: 19px; line-height: 1.7; color: #4b5563; font-weight: 500; padding: 16px 20px; border-left: 4px solid #ff7a00; background-color: #fdfaf6; border-radius: 0 12px 12px 0; margin-bottom: 36px;" {{ block.shopify_attributes }}>
          {{ article.excerpt | strip_html }}
        </div>
      {%- endif -%}
    {%- when 'content' -%}
      <div class="gs-article-body-wrapper" {{ block.shopify_attributes }}>
        {{ article.content }}
      </div>
    {%- when 'share_buttons'-%}
      {%- liquid
        assign share_whatsapp = block.settings.share_whatsapp
        assign share_facebook = block.settings.share_facebook
        assign share_twitter = block.settings.share_twitter
        assign share_pinterest = block.settings.share_pinterest
        assign share_messenger = block.settings.share_messenger
        assign share_email = block.settings.share_email
      -%}
      {%- if share_whatsapp or share_facebook or share_twitter or share_pinterest or share_messenger or share_email -%}
        <ul class="l4sc" {{ block.shopify_attributes }} style="margin: 36px 0; padding: 18px 0; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
          <li class="title" style="color: #0a2540; font-weight: 700;">{{ 'blog.share' | t | default: 'Share this post:' }}</li>
          {%- render 'social-share-buttons', share: article, share_whatsapp: share_whatsapp, share_facebook: share_facebook, share_twitter: share_twitter, share_pinterest: share_pinterest, share_messenger: share_messenger, share_email: share_email -%}
        </ul>
      {%- endif -%}
    {%- when 'tags' -%}
      {% if article.tags.size > 0 %}
        <div style="margin: 40px 0 20px; padding-top: 24px; border-top: 1px solid #e2e8f0;" {{ block.shopify_attributes }}>
          <h2 style="font-size: 15px; font-weight: 700; color: #0a2540; margin-bottom: 14px; text-transform: uppercase; letter-spacing: 1px;">{{ 'blog.tags' | t }}</h2>
          <p class="link-btn tags">
            {%- for tag in article.tags -%}
              {%- if current_tags contains tag -%}
                {{ tag | link_to_remove_tag: tag }}
              {%- else -%}
                {{ tag | link_to_add_tag: tag }}
              {%- endif -%}
            {%- endfor -%}
          </p>
        </div>
      {% endif %}
    {%- when 'comments'-%}
      {%- if article.comments_count > 0 and blog.comments_enabled? -%}
        <h2 {{ block.shopify_attributes }}>{{ 'blog.article.comment_form.title' | t }}</h2>
        {%- paginate article.comments by 2 -%}
          <ul class="l4cm">
            {%- for comment in article.comments -%}
              <li>
                <p>{{ comment.content | strip_html }}</p>
                <footer>
                  <h3>{{ comment.author | slice: 0, 2 | upcase }}</h3>
                  <p>{{ comment.author }} <span class="small">{{ comment.created_at | time_tag: format: 'month_day_year' }}</span></p>
                </footer>
              </li>
            {%- endfor -%}
          </ul>
          {%- render 'pagination',
            paginate: paginate,
            show_amount: true
          -%}
        {%- endpaginate -%}
      {%- endif %}
      {%- if blog.comments_enabled? -%}
        {%- liquid
          capture posted_successfully_message
            if blog.moderated?
              echo 'blog.article.comment_form.posted_successfully_moderated' | t
            else
              echo 'blog.article.comment_form.posted_successfully_not_moderated' | t
            endif
          endcapture
        -%}
        {%- form 'new_comment', article, class: 'f8cm base-font' -%}
          {%- if form.errors -%}
          	<script>
              document.addEventListener('DOMContentLoaded', function () {
                  var alertAttributes = { message: "{{ 'blog.article.comment_form.email' | t }} {{ form.errors.messages['email'] }}", type: "error", origin: "article" },
            			    showAlertEvent = new CustomEvent("showAlert", {detail: alertAttributes});
            			window.dispatchEvent(showAlertEvent);
              });
            </script>
          {%- elsif form.posted_successfully? -%}
            <script>
              document.addEventListener('DOMContentLoaded', function () {
                var alertAttributes = { message: "{{ posted_successfully_message }}", type: "success", origin: "artoc;e" },
                    showAlertEvent = new CustomEvent("showAlert", {detail: alertAttributes});
                window.dispatchEvent(showAlertEvent);
              });
            </script>
          {%- endif -%}
          <input type="hidden" name="key" value="{{ page.key }}">
          <input type="hidden" name="url" value="" placeholder="URL" class="gui-hide">
          <fieldset {{ block.shopify_attributes }}>
            <legend>{{ 'blog.article.comment_form.form_title' | t }}</legend>
            <h2>{{ 'blog.article.comment_form.form_title' | t }}</h2>
          </fieldset>
          <div class="cols">
            <p class="w50">
              <label for="name">{{ 'blog.article.comment_form.name' | t }}<span class="overlay-theme">*</span></label>
              <input type="text" id="name" name="comment[author]" placeholder="{{ 'blog.article.comment_form.name' | t }}" required>
            </p>
            <p class="w50">
              <label for="email_address">{{ 'blog.article.comment_form.email' | t }}<span class="overlay-theme">*</span></label>
              <input type="email" id="email_address" name="comment[email]" placeholder="{{ 'blog.article.comment_form.email' | t }}" required>
            </p>
          </div>
          <p>
            <label for="comment">{{ 'blog.article.comment_form.comment' | t }}<span class="overlay-theme">*</span></label>
            <textarea id="comment" name="comment[body]" placeholder="{{ 'blog.article.comment_form.comment' | t }}" required>{{ form.body }}</textarea>
          </p>
          <p class="submit">
            <button type="submit" class="overlay-tertiary"><span class="txt">{{ 'blog.article.comment_form.post_comment' | t }}</span></button>
          </p>
        {%- endform -%}
      {%- endif -%}
  {%- endcase -%}
{%- endfor -%}
</div>

{% schema %}
{
  "name": "t:main.article.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "compact",
      "label": "t:main.article.settings.compact.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "big_fontsize",
      "label": "t:main.article.settings.big_fontsize.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "spacer",
      "name": "t:global.spacer.name",
      "settings": [
        {
          "type": "range",
          "id": "height",
          "label": "t:global.spacer.settings.height.label",
          "min": 5,
          "max": 200,
          "step": 5,
          "unit": "px",
          "default": 20
        }
      ]
    },
    {
      "type": "featured_image",
      "name": "t:main.article.blocks.featured_image.name",
      "limit": 1,
      "settings": [

      ]
    },
    {
      "type": "title",
      "name": "t:main.article.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "title_size",
          "label": "t:global.typography.title_size.label",
          "options": [
            {
              "value": "h1",
              "label": "t:global.typography.title_size.h1.label"
            },
            {
              "value": "h2",
              "label": "t:global.typography.title_size.h2.label"
            },
            {
              "value": "h3",
              "label": "t:global.typography.title_size.h3.label"
            },
            {
              "value": "h4",
              "label": "t:global.typography.title_size.h4.label"
            },
            {
              "value": "h5",
              "label": "t:global.typography.title_size.h5.label"
            }
          ],
          "default": "h1"
        },
        {
          "id": "show_banner",
          "type": "checkbox",
          "label": "t:main.article.blocks.title.settings.show_banner.label",
          "info": "t:main.article.blocks.title.settings.show_banner.info"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:main.article.blocks.title.settings.overlay_opacity.label",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 0,

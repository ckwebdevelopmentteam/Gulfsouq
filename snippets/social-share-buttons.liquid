{% doc %}
  Renders social media sharing buttons for various platforms. Allows customers to share content on WhatsApp, Facebook, Twitter, Pinterest, Messenger, and email with proper URLs and metadata.

  @param {object} share - Object containing sharing metadata (url, title, featured_image or image)
  @param {boolean} [share_whatsapp] - Whether to show WhatsApp sharing button
  @param {boolean} [share_facebook] - Whether to show Facebook sharing button
  @param {boolean} [share_twitter] - Whether to show Twitter sharing button
  @param {boolean} [share_pinterest] - Whether to show Pinterest sharing button (requires image)
  @param {boolean} [share_messenger] - Whether to show Facebook Messenger sharing button (mobile only)
  @param {boolean} [share_email] - Whether to show email sharing button

  @example
  {% render 'social-share-buttons', share: product, share_facebook: true, share_twitter: true %}
  @example
  {% render 'social-share-buttons', share: article, share_whatsapp: true, share_email: true %}
  @example
  {% render 'social-share-buttons', share: product, share_pinterest: true, share_facebook: true, share_messenger: true %}
{% enddoc %}

{%- if share_whatsapp -%}
  <li>
    <a target="_blank" href="whatsapp://send?text={{ shop.url }}{{ share.url }}">
      <span class="gs-social-icon gs-social-whatsapp" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.301-.15-1.781-.879-2.057-.979-.276-.1-.476-.15-.676.15-.2.3-.777.979-.952 1.179-.175.2-.351.225-.652.075-.3-.15-1.267-.467-2.414-1.488-.893-.796-1.496-1.78-1.671-2.08-.175-.3-.019-.462.131-.612.135-.135.301-.35.451-.525.15-.175.2-.3.301-.5.1-.2.05-.375-.025-.525-.075-.15-.676-1.63-1.026-2.23-.24-.41-.49-.35-.676-.36-.175-.01-.375-.01-.576-.01-.2 0-.526.075-.802.375-.276.3-1.052 1.028-1.052 2.507 0 1.478 1.078 2.905 1.228 3.105.15.2 2.122 3.24 5.141 4.542.718.31 1.279.495 1.716.634.722.23 1.379.197 1.899.12.58-.087 1.781-.728 2.032-1.432.25-.704.25-1.307.175-1.432-.075-.125-.275-.2-.576-.35zm-5.438 7.368c-1.85 0-3.665-.497-5.263-1.442l-.377-.224-3.914 1.026 1.045-3.815-.246-.392a10.825 10.825 0 0 1-1.66-5.753c0-5.98 4.866-10.846 10.85-10.846 2.898 0 5.623 1.128 7.671 3.179 2.05 2.051 3.178 4.777 3.177 7.675 0 5.981-4.867 10.847-10.852 10.847zm9.262-17.712C18.825 1.572 15.65 0 12.034 0 5.397 0 .003 5.394.003 12.032c0 2.119.553 4.187 1.603 6.009L0 24l6.136-1.61a12.001 12.001 0 0 0 5.898 1.53h.005c6.634 0 12.03-5.395 12.03-12.035 0-3.216-1.252-6.24-3.527-8.514z"/></svg>
      </span>
      <span>{{ 'social_share.whatsapp' | t }}</span>
    </a>
  </li>
{% endif %}
{%- if share_facebook -%}
  <li>
    <a
      target="_blank"
      onclick="return !window.open(this.href,'{{ share.title }}', 'width=500,height=500')"
      href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ share.url }}"
    >
      <span class="gs-social-icon gs-social-facebook" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </span>
      <span>{{ 'social_share.facebook' | t }}</span>
    </a>
  </li>
{%- endif %}
{% if share_twitter -%}
  <li>
    <a
      target="_blank"
      onclick="return !window.open(this.href,'{{ share.title }}', 'width=500,height=500')"
      href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ share.url }}"
    >
      <span class="gs-social-icon gs-social-twitter" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </span>
      <span>{{ 'social_share.twitter' | t }}</span>
    </a>
  </li>
{%- endif -%}
{%- if share_pinterest -%}
  <li>
    <a
      target="_blank"
      onclick="return !window.open(this.href,'{{ share.title }}', 'width=500,height=500')"
      href="http://pinterest.com/pin/create/button/?url={{ shop.url }}{{ share.url }}&media={% if share.featured_image %}{{ share.featured_image | image_url }}{% else %}{{ share.image | image_url }}{% endif %}&description={{ share.title | url_encode }}"
    >
      <span class="gs-social-icon gs-social-pinterest" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
      </span>
      <span>{{ 'social_share.pinterest' | t }}</span>
    </a>
  </li>
{% endif %}
{%- if share_messenger -%}
  <li class="desktop-hide">
    <a href="fb-messenger://share/?link={{ shop.url }}{{ share.url }}">
      <span class="gs-social-icon gs-social-messenger" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 4.974 0 11.111c0 3.498 1.744 6.614 4.469 8.654V24l4.088-2.242c1.082.3 2.235.464 3.443.464 6.627 0 12-4.974 12-11.111C24 4.974 18.627 0 12 0zm1.191 14.963l-3.055-3.26-5.963 3.26L10.79 7.9l3.127 3.259 5.891-3.259-6.617 7.063z"/></svg>
      </span>
      <span>{{ 'social_share.messenger' | t }}</span>
    </a>
  </li>
{%- endif -%}
{%- if share_email -%}
  <li>
    <a href="mailto:?subject=&body={{ shop.url }}{{ share.url }}">
      <span class="gs-social-icon gs-social-email" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
      </span>
      <span>{{ 'social_share.email' | t }}</span>
    </a>
  </li>
{%- endif -%}

{% doc %}
  Renders breadcrumb navigation showing the current page's location within the site hierarchy. Automatically adapts to different page types (products, collections, articles, etc.) with proper SEO and accessibility markup.

  @param {boolean} [hide_mobile] - Whether to hide breadcrumbs on mobile devices.

  @example
  {% render 'breadcrumbs' %}
  @example
  {% render 'breadcrumbs', hide_mobile: true %}
{% enddoc %}

<style>
  .n6br,
  .shopify-section-breadcrumbs .n6br,
  #root .n6br,
  #content .n6br {
    padding-left: 20px !important;
    padding-right: 20px !important;
    box-sizing: border-box !important;
  }
  @media (max-width: 768px) {
    .n6br,
    .shopify-section-breadcrumbs .n6br,
    #root .n6br,
    #content .n6br {
      padding-left: 16px !important;
      padding-right: 16px !important;
    }
  }
</style>

<nav
  class="n6br{% if settings.breadcrumbs_font == 'primary' %} title-font{% endif %}"
  role="navigation"
  aria-label="breadcrumbs"
>
  <ol
    {% if hide_mobile %}
      class="mobile-hide"
    {% endif %}
  >
    <li>
      <a href="/" title="Home">{{ 'general.breadcrumbs.home' | t }}</a>
    </li>

    {% if template.name == 'collection' and collection.handle %}
      {% if current_tags %}
        {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
        <li>
          {{ collection.title | link_to: url }}
        </li>
        <li>
          {% for tag in current_tags %}
            {% assign filter = tag | split: ':' | last %}
            {{ filter | capitalize }}
            {% unless forloop.last %}+ {% endunless %}
          {% endfor %}
        </li>
      {% else %}
        <li>
          {{ collection.title }}
        </li>
      {% endif %}

    {% elsif template.name == 'blog' %}
      <li>
        {{ 'blog.breadcrumb' | t | capitalize | link_to: blog.url }}
      </li>
      <li>
        {{ blog.title | capitalize }}
      </li>

    {% elsif template.name == 'article' %}
      <li>
        {{ 'blog.breadcrumb' | t | capitalize | link_to: blog.url }}
      </li>
      <li>
        {{ blog.title | link_to: blog.url }}
      </li>
      <li>
        {{ article.title }}
      </li>

    {% elsif template.name == 'page' %}
      <li>
        {{ page.title }}
      </li>

    {% elsif page_title == 'Account' and template.name != 'account' %}
      <li>
        {{ page_title }}
      </li>
      <li>
        {{ template.name | capitalize }}
      </li>

    {% elsif template.name == 'search' %}
      <li>
        {{ 'search.title' | t }}
      </li>

    {% elsif template.name == 'cart' %}
      <li>
        {{ 'cart.title' | t }}
      </li>

    {% elsif template.name == 'product' and product != blank %}
      <li>
        {{ product.title }}
      </li>

    {% elsif template.suffix != null %}
      <li>
        {{ template.suffix | capitalize }}
      </li>

    {% else %}
      <li>
        {{ page_title }}
      </li>
    {% endif %}
  </ol>

  {%- if template.name == 'product' -%}
    <p class="mobile-only">
      <a class="breadcrumb-back"
        ><i aria-hidden="true" class="icon-chevron-left"></i> {{ 'general.breadcrumbs.back' | t -}}
      </a>
    </p>
  {%- endif -%}
</nav>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ 'general.breadcrumbs.home' | t | default: 'Home' | json }},
      "item": "{{ shop.url }}"
    }
    {%- if template.name == 'collection' and collection.handle -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ shop.url }}{{ collection.url }}"
      }
    {%- elsif template.name == 'product' and product != blank -%}
      {%- if collection -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": "{{ shop.url }}{{ collection.url }}"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": "{{ shop.url }}{{ product.url }}"
        }
      {%- else -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }},
          "item": "{{ shop.url }}{{ product.url }}"
        }
      {%- endif -%}
    {%- elsif template.name == 'article' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": "{{ shop.url }}{{ blog.url }}"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": "{{ shop.url }}{{ article.url }}"
      }
    {%- elsif page -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": "{{ shop.url }}{{ page.url }}"
      }
    {%- endif -%}
  ]
}
</script>

{% doc %}
  Renders breadcrumb navigation showing the current page's location within the site hierarchy. Automatically adapts to different page types (products, collections, articles, etc.) with proper SEO and accessibility markup.

  @param {boolean} [hide_mobile] - Whether to hide breadcrumbs on mobile devices.

  @example
  {% render 'breadcrumbs' %}
  @example
  {% render 'breadcrumbs', hide_mobile: true %}
{% enddoc %}

<style>
  .n6br,
  .shopify-section-breadcrumbs .n6br,
  #root .n6br,
  #content .n6br {
    padding-left: 20px !important;
    padding-right: 20px !important;
    box-sizing: border-box !important;
  }
  @media (max-width: 768px) {
    .n6br,
    .shopify-section-breadcrumbs .n6br,
    #root .n6br,
    #content .n6br {
      padding-left: 16px !important;
      padding-right: 16px !important;
    }
  }

  /* Breadcrumb item links */
  .n6br ol li a,
  .n6br ul li a,
  .n6br p a,
  .shopify-section-breadcrumbs .n6br ol li a,
  #root .n6br ol li a,
  #content .n6br ol li a {
    color: #64748b !important;
    opacity: 1 !important;
    text-decoration: none !important;
    transition: color 0.2s ease, opacity 0.2s ease !important;
  }

  /* Breadcrumb hover state: visible orange accent hover */
  .n6br ol li a:hover,
  .n6br ul li a:hover,
  .n6br p a:hover,
  .shopify-section-breadcrumbs .n6br ol li a:hover,
  #root .n6br ol li a:hover,
  #content .n6br ol li a:hover,
  .n6br a:hover,
  #root .n6br a:hover,
  #content .n6br a:hover {
    color: #ff7a00 !important;
    opacity: 1 !important;
    text-decoration: underline !important;
  }

  /* Last/active breadcrumb item */
  .n6br ol li:last-child,
  .n6br ul li:last-child,
  .shopify-section-breadcrumbs .n6br ol li:last-child,
  #root .n6br ol li:last-child {
    color: #0c3e61 !important;
    font-weight: 600 !important;
    opacity: 1 !important;
  }

  /* Breadcrumb separator icon */
  .n6br li:before {
    color: #94a3b8 !important;
    opacity: 0.6 !important;
  }
</style>

<nav
  class="n6br{% if settings.breadcrumbs_font == 'primary' %} title-font{% endif %}"
  role="navigation"
  aria-label="breadcrumbs"
>
  <ol
    {% if hide_mobile %}
      class="mobile-hide"
    {% endif %}
  >
    <li>
      <a href="/" title="Home">{{ 'general.breadcrumbs.home' | t }}</a>
    </li>

    {% if template.name == 'collection' and collection.handle %}
      {% if current_tags %}
        {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
        <li>
          {{ collection.title | link_to: url }}
        </li>
        <li>
          {% for tag in current_tags %}
            {% assign filter = tag | split: ':' | last %}
            {{ filter | capitalize }}
            {% unless forloop.last %}+ {% endunless %}
          {% endfor %}
        </li>
      {% else %}
        <li>
          {{ collection.title }}
        </li>
      {% endif %}

    {% elsif template.name == 'blog' %}
      {% if current_tags %}
        <li>
          <a href="{{ blog.url }}">Blog</a>
        </li>
        <li>
          {{ current_tags | join: " + " }}
        </li>
      {% else %}
        <li>
          Blog
        </li>
      {% endif %}

    {% elsif template.name == 'article' %}
      <li>
        <a href="{{ blog.url }}">Blog</a>
      </li>
      <li>
        {{ article.title }}
      </li>

    {% elsif template.name == 'page' %}
      <li>
        {{ page.title }}
      </li>

    {% elsif page_title == 'Account' and template.name != 'account' %}
      <li>
        {{ page_title }}
      </li>
      <li>
        {{ template.name | capitalize }}
      </li>

    {% elsif template.name == 'search' %}
      <li>
        {{ 'search.title' | t }}
      </li>

    {% elsif template.name == 'cart' %}
      <li>
        {{ 'cart.title' | t }}
      </li>

    {% elsif template.name == 'product' and product != blank %}
      <li>
        {{ product.title }}
      </li>

    {% elsif template.suffix != null %}
      <li>
        {{ template.suffix | capitalize }}
      </li>

    {% else %}
      <li>
        {{ page_title }}
      </li>
    {% endif %}
  </ol>

  {%- if template.name == 'product' -%}
    <p class="mobile-only">
      <a class="breadcrumb-back"
        ><i aria-hidden="true" class="icon-chevron-left"></i> {{ 'general.breadcrumbs.back' | t -}}
      </a>
    </p>
  {%- endif -%}
</nav>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ 'general.breadcrumbs.home' | t | default: 'Home' | json }},
      "item": "{{ shop.url }}"
    }
    {%- if template.name == 'collection' and collection.handle -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ shop.url }}{{ collection.url }}"
      }
    {%- elsif template.name == 'product' and product != blank -%}
      {%- if collection -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": "{{ shop.url }}{{ collection.url }}"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": "{{ shop.url }}{{ product.url }}"
        }
      {%- else -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }},
          "item": "{{ shop.url }}{{ product.url }}"
        }
      {%- endif -%}
    {%- elsif template.name == 'article' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": "{{ shop.url }}{{ blog.url }}"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": "{{ shop.url }}{{ article.url }}"
      }
    {%- elsif page -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": "{{ shop.url }}{{ page.url }}"
      }
    {%- endif -%}
  ]
}
</script>

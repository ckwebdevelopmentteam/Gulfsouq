{% comment %}
  GulfSouq Bulk & Corporate Orders Inquiry Card
  Replaces marquee with a clean, high-converting luxury card.
{% endcomment %}

<div class="gs-pdp-bulk-card">
  <div class="gs-pdp-bulk-left">
    <div class="gs-pdp-bulk-icon">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="#25D366">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
      </svg>
    </div>
    <div class="gs-pdp-bulk-info">
      <span class="gs-pdp-bulk-title">Bulk & Corporate Gifting</span>
      <span class="gs-pdp-bulk-desc">Special wholesale pricing & custom gift hampers available</span>
    </div>
  </div>
  <a
    href="https://wa.me/917025545444?text={{ 'Hi GulfSouq Team, I am interested in bulk/wholesale order for: ' | append: product.title | url_encode }}"
    target="_blank"
    rel="noopener noreferrer"
    class="gs-pdp-bulk-btn"
  >
    <span>Chat on WhatsApp</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </a>
</div>
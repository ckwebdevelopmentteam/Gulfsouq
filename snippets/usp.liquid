<style>
 
  .delivery-container {
     margin-bottom: 16px;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }
  
  .delivery-row {
    display: flex;
    align-items: center;
    flex-wrap: revert;
    justify-content: space-between;
    gap: 16px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }
  
  .pincode-section {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 140px;
     border: none;
    border-bottom: 1px solid #e5e7eb;
  }
  
  .location-icon {
    color: #9ca3af;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }
  
  .pincode-input {
    width: 80px;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: 500;
    color: #e5e7eb;
     border: none;
    outline: none;
    background: transparent;
  }
  
  .pincode-input:focus {
    border-bottom-color: #0066cc;
  }
  
  .check-btn {
    padding: 4px 12px;
    background: transparent;
    color: #666;
    border: none;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  
  .check-btn:hover {
    color: #0066cc;
  }
  
  .delivery-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  
  .delivery-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: #9ca3af;
  }
  
  .delivery-text {
    font-size: 14px;
    color: #333;
    font-weight: 500;
    white-space: nowrap;
  }
  
  .delivery-message {
    margin-top: 12px;
    font-size: 14px;
    color: #333;
    display: none;
  }
  
  .delivery-message.show {
    display: block;
  }
  
  .delivery-message.success {
    color: #333;
  }
  
  .delivery-message.error {
    color: #dc2626;
  }
  
  /* Mobile First Responsive */
  @media screen and (max-width: 768px) {
    .delivery-row {
      gap: 12px;
    }
    
    .pincode-section {
      min-width: 120px;
    }
    
    .pincode-input {
      {% comment %} width: 70px; {% endcomment %}
      font-size: 8px;
    }
    
    .delivery-text {
      font-size: 13px;
    }
    
    .check-btn {
      font-size: 13px;
      padding: 3px 8px;
    }
  }
  
  @media screen and (max-width: 480px) {
    .delivery-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    
    .pincode-section {
      width: 100%;
      justify-content: flex-start;
    }
    
    .delivery-item {
      width: 100%;
    }
    
    .delivery-text {
      white-space: normal;
    }
  }
  
  @media screen and (max-width: 320px) {
    .pincode-input {
      width: 60px;
       font-size: 8px;
    }
    
    .delivery-text {
      font-size: 12px;
    }
    
    .check-btn {
      font-size: 12px;
    }
  }
</style>


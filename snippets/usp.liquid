<script>
        function validatePincode(input) {
            // Remove any non-digit characters
            input.value = input.value.replace(/\D/g, '');
            
            // Limit to 6 digits
            if (input.value.length > 6) {
                input.value = input.value.slice(0, 6);
            }
        }
        
        function checkDelivery() {
            const pincode = document.getElementById('pincodeInput').value;
            const messageDiv = document.getElementById('deliveryMessage');
            
            if (pincode.length !== 6) {
                messageDiv.innerHTML = '<span style="color: #dc3545;">Please enter a valid 6-digit pincode</span>';
                messageDiv.classList.add('show');
                return;
            }
            
            // Simulate delivery check based on pincode ranges
            let deliveryTime;
            const pincodeNum = parseInt(pincode);
            
            if (pincodeNum >= 670000 && pincodeNum <= 695999) {
                // Kerala
                deliveryTime = '2-3 days';
            } else if (pincodeNum >= 600000 && pincodeNum <= 699999) {
                // South India
                deliveryTime = '3-5 days';
            } else if (pincodeNum >= 110000 && pincodeNum <= 199999) {
                // North India
                deliveryTime = '5-7 days';
            } else if (pincodeNum >= 780000 && pincodeNum <= 799999) {
                // North East
                deliveryTime = '7-10 days';
            } else {
                deliveryTime = '4-8 days';
            }
            
            messageDiv.innerHTML = `<span style="color: #28a745;">✓ Delivery available in ${deliveryTime}</span>`;
            messageDiv.classList.add('show');
        }
        
        // Allow Enter key to trigger check
        document.getElementById('pincodeInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                checkDelivery();
            }
        });
    </script>
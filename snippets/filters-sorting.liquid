{% doc %}
  Renders filtering and sorting interface for collections and search results. Supports multiple display modes including full filters, sorting controls, and mobile filter buttons with advanced features like color swatches and price ranges.

  @param {string} [display] - Display mode: 'filters' shows filter options, 'sorting' shows sort controls, 'mobile-filter-button' shows mobile filter button. Defaults to 'filters'.
  @param {string} [origin] - Context origin: 'collection' for collection pages, 'search' for search results. Defaults to 'collection'.
  @param {object} [object] - Collection or search object to filter/sort. Defaults to collection.
  @param {boolean} [show_amount_of_products] - Whether to display product/result count. Defaults to false.
  @param {boolean} [show_collection_image] - Whether to display collection featured image. Defaults to false.
  @param {boolean} [show_filters] - Whether to show filter options. Defaults to false.
  @param {string} [collection_view] - Display mode: 'grid' or 'list'. Defaults to 'grid'.
  @param {object} [filters] - Custom filters array. Defaults to object.filters.
  @param {object} [quick_links] - Menu links for collection navigation.
  @param {object} [collections_menu] - Additional collections to display in navigation.
  @param {number} [filters_show_more_limit] - Number of filter values to show before 'show more' link.
  @param {boolean} [sticky] - Whether sorting controls should be sticky on mobile.
  @param {boolean} [enable_collection_grid_choice] - Enable desktop grid size selection.
  @param {boolean} [enable_collection_grid_choice_mobile] - Enable mobile grid size selection.
  @param {boolean} [enable_collection_view_choice] - Enable grid/list view toggle.
  @param {string} [grid_1] - First grid option in 'width|label' format.
  @param {string} [grid_2] - Second grid option in 'width|label' format.
  @param {string} [grid_1_mobile] - First mobile grid option in 'width|label' format.
  @param {string} [grid_2_mobile] - Second mobile grid option in 'width|label' format.
  @param {string} [collection_grid_view] - Current desktop grid width setting.
  @param {string} [collection_grid_view_mobile] - Current mobile grid width setting.

  @example
  {% render 'filters-sorting', display: 'filters', show_filters: true, show_collection_image: true %}
  @example
  {% render 'filters-sorting', display: 'sorting', show_amount_of_products: true, collection_view: 'grid' %}
  @example
  {% render 'filters-sorting', display: 'mobile-filter-button', show_filters: true, sticky: true %}
{% enddoc %}

<link href="{{ 'async-validation.css' | asset_url }}" rel="preload" as="style" onload="this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'async-validation.css' | asset_url }}"></noscript>

{%- liquid
  assign display = display | default: 'filters'
  assign origin = origin | default: 'collection'
  assign object = object | default: collection
  assign show_amount_of_products = show_amount_of_products | default: false
  assign show_collection_image = show_collection_image | default: false
  assign show_filters = show_filters | default: false

  assign collection_view = collection_view | default: 'grid'
  if origin == 'collection'
    assign amount_of_products = collection.products_count | default: 0
    assign amount_of_products_translation = 'collection.amount_of_products'
  elsif origin == 'search'
    assign amount_of_products = search.results_count | default: 0
    assign amount_of_products_translation = 'search.amount_of_results'
  endif

  assign quick_links = quick_links | default: empty
  assign collections_menu = collections_menu | default: empty
  if quick_links != empty
    assign has_quick_links = true
  endif
  if collections_menu != empty
    assign has_quick_links = true
  endif
-%}

{%- if display == 'filters' -%}
  {%- liquid
    assign filters = filters | default: object.filters
    for filter in filters
      if filter.active_values != null and filter.active_values != empty
        assign has_active_filters = true
        break
      endif
      if filter.type == 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          if filter.min_value.value != filter.range_min and filter.max_value.value != filter.range_max
            assign has_active_filters = true
            break
          endif
        endif
      endif
    endfor
  -%}
  {%- if has_quick_links != empty or object.image -%}
    <nav class="n6as">
      {%- if object.image and show_collection_image -%}
        <figure class="{% if settings.multiply_collection_images == 'multiply' %}img-multiply{% elsif settings.multiply_collection_images == 'multiply-bg' %}img-multiply-bg{% endif %}">
          <img
            src="{{ object.image | image_url: width: 350 }}"
            srcset="{% render 'image-srcset', image: object.image, max_width: 350 %}"
            sizes="
              (min-width: 1000px) 245
              0
            "
            alt="{{ object.image.alt | default: object.title | escape }}"
            width="245"
            height="245"
            loading="lazy"
          >
        </figure>
      {%- endif -%}
      {%- if has_quick_links -%}
        <ul>
          <li>
            <a href="{{ routes.collections_url }}">{{ 'collection.view_all_collections' | t }}</a>
          </li>
          {%- liquid
            assign handles = empty
            assign collection_links = quick_links.links | where: 'type', 'collection_link'
            assign collection_links_handles = collection_links | map: 'handle'
            assign handles = handles | concat: collection_links_handles
          -%}
          {%- for link in quick_links.links -%}
            <li class="{% if link.active or link.child_active %}strong toggle{% endif %}">
              <a href="{{ link.url }}">{{ link.title }}</a>
              {%- if link.links != blank -%}
                {%- liquid
                  assign collection_links = link.links | where: 'type', 'collection_link'
                  assign collection_links_handles = collection_links | map: 'handle'
                  assign handles = handles | concat: collection_links_handles
                -%}
                <a href="./" class="toggle">{{ 'general.accessibility.toggle' | t: item: link.title }}</a>
                <ul>
                  {%- for sublink in link.links -%}
                    {%- liquid
                      assign collection_links = sublink.links | where: 'type', 'collection_link'
                      assign collection_links_handles = collection_links | map: 'handle'
                      assign handles = handles | concat: collection_links_handles
                    -%}
                    <li class="{% if sublink.active or sublink.child_active %}strong toggle{% endif %}">
                      <a href="{{ sublink.url }}">{{ sublink.title }}</a>
                      {%- if sublink.links != blank -%}
                        <a href="./" class="toggle">{{ 'general.accessibility.toggle' | t: item: sublink.title }}</a>
                        <ul>
                          {%- for subsublink in sublink.links -%}
                            {%- liquid
                              assign collection_links = subsublink.links | where: 'type', 'collection_link'
                              assign collection_links_handles = collection_links | map: 'handle'
                              assign handles = handles | concat: collection_links_handles
                            -%}
                            <li class="{% if subsublink.active %}strong{% endif %}">
                              <a href="{{ subsublink.url }}">{{ subsublink.title }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
          {%- for collection in collections_menu -%}
            {% unless handles contains collection.handle %}
              <li class="{% if collection.handle == object.handle %}active toggle{% endif %}">
                <a href="{{ collection.url }}">{{ collection.title }}</a>
              </li>
            {% endunless %}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>
  {%- endif %}
  <form action="" method="get" class="f8fl" id="filter" data-template="{{ section.id }}">
    <input
      class="sort_by_clone"
      name="sort_by"
      type="hidden"
      value="{{ collection.sort_by | default: collection.default_sort_by }}"
    >
    {%- if search.performed -%}
      <input type="hidden" name="q" value="{{ search.terms | escape }}">
    {%- elsif object.current_vendor or object.current_type -%}
      <input type="hidden" name="q" value="{{ object.current_vendor }}{{ object.current_type }}">
    {%- endif -%}
    {%- if show_filters -%}
      <fieldset>
        <legend>{{ 'collection.filters.filter' | t }}</legend>
        <header>
          <h3>
            {%- if has_active_filters -%}
              <span class="desktop-only">{{ 'collection.filters.current_filters' | t }}</span>
            {%- endif -%}
            <span
              {% if has_active_filters %}
                class="desktop-hide"
              {% endif %}
            >
              {{- 'collection.filters.filter' | t -}}
            </span>
            {%- if has_active_filters -%}
              <a href="{{ collection.url }}" class="desktop-hide remove-all">
                {{- 'collection.filters.remove_all_filters' | t -}}
              </a>
            {%- endif -%}
          </h3>
          {%- if has_active_filters -%}
            <ul class="desktop-only">
              {%- for filter in filters -%}
                {%- for value in filter.active_values -%}
                  <li>
                    <label for="Filter-{{ value.param_name }}-{{ value.value }}">
                      <a href="{{ value.url_to_remove }}">
                        <span>{{ filter.label | escape }}</span> {{ value.label | escape }}
                      </a>
                    </label>
                  </li>
                {%- endfor -%}
                {% if filter.type == 'price_range' %}
                  {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                    {%- if filter.min_value.value != filter.range_min and filter.max_value.value != filter.range_max -%}
                      <li>
                        <a href="{{ filter.url_to_remove }}" class="clear-range">
                          <span>{{ filter.label | escape }}</span>
                          {% if filter.min_value.value -%}
                            {{- filter.min_value.value | money -}}
                          {%- else -%}
                            {{- filter.range_min | money -}}
                          {%- endif %}
                          -
                          {% if filter.max_value.value -%}
                            {{- filter.max_value.value | money -}}
                          {%- else -%}
                            {{- filter.range_max | money -}}
                          {%- endif %}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endif -%}
                {% endif %}
              {%- endfor -%}
              <li class="strong">
                <a href="{{ collection.url }}" class="remove-all">{{ 'collection.filters.remove_all_filters' | t }}</a>
              </li>
            </ul>
          {%- endif -%}
        </header>
        {%- for filter in filters -%}
          {%- case filter.type -%}
            {%- when 'list' -%}
              {%- if filter.param_name == 'filter.v.availability' -%}
                {%- assign in_stock_filter = filter.values | where: 'value', '1' | first -%}
                <h4 data-filter-toggle="{{ filter.label | handleize }}" class="desktop-hide">{{ filter.label }}</h4>
                <ul class="check">
                  <li>
                    <input
                      type="checkbox"
                      name="{{ in_stock_filter.param_name }}"
                      value="{{ in_stock_filter.value }}"
                      id="Filter-{{ in_stock_filter.param_name }}-{{ in_stock_filter.value }}"
                      {% if in_stock_filter.active %}
                        checked
                      {% endif %}
                    >
                    <label for="Filter-{{ in_stock_filter.param_name }}-{{ in_stock_filter.value }}" class="strong">
                      <a href="{%- if in_stock_filter.active -%}{{ in_stock_filter.url_to_remove }}{%- else -%}{{ in_stock_filter.url_to_add }}{%- endif -%}">
                        {{ in_stock_filter.label }}
                      </a>
                    </label>
                  </li>
                </ul>
              {%- else -%}
                {%- liquid
                  assign triggers = settings.color_swatch_name | newline_to_br | strip_newlines | replace: '<br />', ',' | split: ','
                  if settings.enable_color_swatches and triggers contains filter.label
                    assign is_color = true
                    render 'color-swatches'
                  else
                    assign is_color = false
                  endif
                -%}
                <h4 data-filter-toggle="{{ filter.label | handleize }}">{{ filter.label }}</h4>
                <ul class="check" data-filter-toggle="{{ filter.label | handleize }}">
                  {%- for filter_value in filter.values -%}
                    <li>
                      <input
                        type="checkbox"
                        name="{{ filter_value.param_name }}"
                        value="{{ filter_value.value }}"
                        id="Filter-{{ filter_value.param_name }}-{{ filter_value.value }}"
                        {% if filter_value.active %}
                          checked
                        {% endif %}
                      >
                      <label for="Filter-{{ filter_value.param_name }}-{{ filter_value.value }}" class="align-middle">
                        {% if filter_value.swatch.image %}
                          {%- liquid
                            case section.settings.image_swatches_size
                              when 'xs'
                                assign width = 15
                              when 's'
                                assign width = 30
                              when 'm'
                                assign width = 45
                              when 'l'
                                assign width = 60
                            endcase
                            assign width_2 = width | times: 2
                          -%}
                          <figure class="size-{{ section.settings.image_swatches_size }}{% if section.settings.image_swatches_fill_images %} cover{% if section.settings.image_swatches_show_in_circle %} rounded{% endif %}{% endif %}">
                            <picture>
                              <img
                                src="{{ filter_value.swatch.image | image_url: width: width }}"
                                srcset="{{ filter_value.swatch.image | image_url: width: width }} 1x,{{ filter_value.swatch.image | image_url: width: width_2 }} 2x"
                                alt="{{ filter.label | escape }}"
                                width="{{ width }}"
                                height="{{ width }}"
                                style="object-fit:{% if section.settings.image_swatches_fill_images %}cover{% else %}contain{% endif %};"
                                loading="lazy"
                              >
                            </picture>
                          </figure>
                        {% elsif filter_value.swatch.color %}
                          <i
                            aria-hidden="true"
                            class="icon-circle"
                            style="background-color: {{ filter_value.swatch.color }};"
                          ></i>
                        {% elsif is_color %}
                          <i
                            aria-hidden="true"
                            class="icon-circle swatch-custom-color-{{ filter_value.label | handleize }}"
                            style="background-color: {{ filter_value.label | split: ' ' | last }};"
                          ></i>
                        {% endif %}
                        <span>
                          {{ filter_value.label }}
                          <span>({{ filter_value.count }})</span>
                        </span>
                      </label>
                    </li>
                  {%- endfor -%}
                  {%- if filter.values.size > filters_show_more_limit -%}
                    <li class="link-more">
                      <a href="./" class="link-more" data-limit="{{ filters_show_more_limit }}">
                        {{- 'general.read_more.show' | t }}
                        <span>{{ 'general.read_more.more' | t }}</span>
                        <span class="hidden">{{ 'general.read_more.less' | t }}</span>
                        <i aria-hidden="true" class="icon-chevron-down"></i
                      ></a>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            {%- when 'boolean' -%}
              <h4 data-filter-toggle="{{ filter.label | handleize }}">{{ filter.label }}</h4>
              <ul class="check" data-filter-toggle="{{ filter.label | handleize }}">
                {%- for filter_value in filter.values -%}
                  <li>
                    <input
                      type="checkbox"
                      name="{{ filter_value.param_name }}"
                      value="{{ filter_value.value }}"
                      id="Filter-{{ filter_value.param_name }}-{{ filter_value.value }}"
                      {% if filter_value.active %}
                        checked
                      {% endif %}
                    >
                    <label for="Filter-{{ filter_value.param_name }}-{{ filter_value.value }}"
                      ><a href="{%- if filter_value.active -%}{{ filter_value.url_to_remove }}{%- else -%}{{ filter_value.url_to_add }}{%- endif -%}">
                        {{- filter_value.label }}
                        <span>({{ filter_value.count }})</span></a
                      ></label
                    >
                  </li>
                {%- endfor -%}
                {%- if filter.values.size > filters_show_more_limit -%}
                  <li class="link-more">
                    <a href="./" class="link-more" data-limit="{{ filters_show_more_limit }}">
                      {{- 'general.read_more.show' | t }}
                      <span>{{ 'general.read_more.more' | t }}</span>
                      <span class="hidden">{{ 'general.read_more.less' | t }}</span>
                      <i aria-hidden="true" class="icon-chevron-down"></i
                    ></a>
                  </li>
                {%- endif -%}
              </ul>
            {%- when 'price_range' -%}
              <h4 data-filter-toggle="{{ filter.label | handleize }}">
                <span class="desktop-only">{{ 'collection.filters.price.title' | t }}</span
                ><span class="desktop-hide">{{ filter.label }}</span>
              </h4>
              <p class="input-range">
                <span>
                  <label for="min">{{ 'collection.filters.price.range_from' | t }}</label>
                  <span class="input-prefix">
                    <span>{{ cart.currency.symbol }}</span>
                    <input
                      type="number"
                      id="min"
                      name="{{ filter.min_value.param_name }}"
                      value="{% if filter.min_value.value -%}{{ filter.min_value.value | ceil | divided_by: 100 }}{% else %}0{% endif %}"
                      min="{{ filter.range_min | ceil | divided_by: 100 }}"
                    >
                  </span>
                </span>
                <span>
                  <label for="max">{{ 'collection.filters.price.range_to' | t }}</label>
                  <span class="input-prefix">
                    <span>{{ cart.currency.symbol }}</span>
                    <input
                      type="number"
                      id="max"
                      name="{{ filter.max_value.param_name }}"
                      value="{% if filter.max_value.value -%}{{ filter.max_value.value | ceil | divided_by: 100 }}{% else %}{{ filter.range_max | ceil | divided_by: 100 }}{% endif %}"
                      max="{{ filter.range_max | ceil | divided_by: 100 }}"
                    >
                  </span>
                </span>
              </p>
          {%- endcase -%}
        {%- endfor -%}
        <p class="link-btn submit desktop-hide">
          <a
            href="./"
            aria-controls="filter"
            {% if settings.button_style == 'inv' %}
              class="inv"
            {% endif %}
          >
            {{- 'collection.filters.show_products' | t: count: amount_of_products }}
            <span>({{ amount_of_products }})</span></a
          >
        </p>
      </fieldset>
    {%- endif -%}
  </form>

{%- elsif display == 'sorting' -%}
  <style>
    @media (max-width: 768px) {
      .offers-left-filters {
        display: none !important;
      }
      .offers-grid-toggles {
        display: none !important;
      }
      .offers-top-toolbar {
        flex-direction: row !important;
        justify-content: space-between !important;
        align-items: center !important;
        padding: 10px 0 !important;
        margin: 10px 0 16px 0 !important;
      }
      .offers-right-controls {
        width: 100% !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
      }
    }

    /* Mobile Full Screen Filter & Sort Modal */
    #gs-mobile-filter-modal,
    .gs-mobile-filter-modal {
      display: none;
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important;
      background: #ffffff !important;
      z-index: 2147483647 !important;
      flex-direction: column !important;
      box-sizing: border-box !important;
      margin: 0 !important;
      padding: 0 !important;
      font-family: inherit !important;
      overflow: hidden !important;
    }
    #gs-mobile-filter-modal.open,
    .gs-mobile-filter-modal.open {
      display: flex !important;
    }

    body.gs-modal-open {
      overflow: hidden !important;
      touch-action: none !important;
    }

    /* Lower site navigation z-index when modal is open so modal header is 100% visible */
    body.gs-modal-open #header-outer,
    body.gs-modal-open #header,
    body.gs-modal-open header,
    body.gs-modal-open .sticky-header,
    body.gs-modal-open [id*="header"],
    body.gs-modal-open [class*="header-bar"] {
      z-index: 1 !important;
    }

    /* Hide floating chat/sticker/badge icons when modal is open */
    body.gs-modal-open [class*="chat"],
    body.gs-modal-open [class*="whatsapp"],
    body.gs-modal-open [class*="sticker"],
    body.gs-modal-open [class*="badge"],
    body.gs-modal-open iframe,
    body.gs-modal-open #hubspot-messages-iframe-container,
    body.gs-modal-open .gorgias-chat-key {
      display: none !important;
      visibility: hidden !important;
    }

    .gs-mobile-modal-header {
      display: flex !important;
      align-items: center !important;
      height: 56px !important;
      min-height: 56px !important;
      padding: 0 20px !important;
      background: #ffffff !important;
      border-bottom: 1px solid #e5e7eb !important;
      position: sticky !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      z-index: 100 !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    .gs-mobile-modal-header h2 {
      font-size: 16px !important;
      font-weight: 700 !important;
      color: #111827 !important;
      margin: 0 !important;
      letter-spacing: 0.05em !important;
      font-family: inherit !important;
      text-transform: uppercase !important;
    }
    .gs-mobile-modal-close,
    #gs-mobile-filter-modal .gs-mobile-modal-close {
      position: absolute !important;
      right: 20px !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      background: transparent !important;
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
      cursor: pointer !important;
      color: #111827 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 0 !important;
      margin: 0 !important;
      width: 24px !important;
      height: 24px !important;
      min-width: 0 !important;
      min-height: 0 !important;
      max-width: 24px !important;
      max-height: 24px !important;
      flex: none !important;
    }

    .gs-mobile-modal-close::before,
    .gs-mobile-modal-close::after,
    #gs-mobile-filter-modal .gs-mobile-modal-close::before,
    #gs-mobile-filter-modal .gs-mobile-modal-close::after {
      display: none !important;
      content: none !important;
    }

    .gs-mobile-modal-body {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
      background: #ffffff;
    }

    .gs-filter-group {
      margin-bottom: 4px;
    }
    .gs-filter-heading {
      font-size: 12px;
      font-weight: 600;
      color: #4b5563;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin: 0 0 16px 0;
      font-family: inherit;
    }
    .gs-filter-divider {
      height: 1px;
      background: #e5e7eb;
      margin: 20px 0;
    }

    .gs-filter-options {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .gs-checkbox-label,
    .gs-radio-label {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      color: #1f2937;
      cursor: pointer;
      user-select: none;
    }
    .gs-checkbox-label input[type="checkbox"],
    .gs-radio-label input[type="radio"] {
      width: 18px;
      height: 18px;
      accent-color: #d9b268;
      cursor: pointer;
      margin: 0;
    }

    .gs-price-range-display {
      font-size: 14px;
      color: #374151;
      font-weight: 500;
      margin-bottom: 12px;
    }
    .gs-price-inputs-flex {
      display: flex;
      gap: 12px;
    }
    .gs-price-input-col {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .gs-price-input-col label {
      font-size: 11px;
      color: #6b7280;
      font-weight: 500;
    }
    .gs-price-input-col input {
      width: 100%;
      padding: 8px 12px;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 14px;
      color: #111827;
      background: #ffffff;
      box-sizing: border-box;
    }

    .gs-mobile-modal-footer {
      padding: 14px 20px;
      background: #ffffff;
      border-top: 1px solid #e5e7eb;
      display: flex;
      gap: 14px;
      align-items: center;
      position: sticky;
      bottom: 0;
      z-index: 10;
    }
    #gs-mobile-filter-modal .gs-btn-clear,
    #gs-mobile-filter-modal .gs-btn-apply,
    .gs-btn-clear,
    .gs-btn-apply {
      appearance: none !important;
      -webkit-appearance: none !important;
      position: relative !important;
      overflow: hidden !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      height: 48px !important;
      line-height: 48px !important;
      padding: 0 20px !important;
      border-radius: 6px !important;
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
      font-size: 15px !important;
      font-weight: 600 !important;
      letter-spacing: 0 !important;
      text-transform: none !important;
      text-decoration: none !important;
      color: #ffffff !important;
      cursor: pointer !important;
      width: 100% !important;
      flex: 1 !important;
      box-sizing: border-box !important;
    }
    #gs-mobile-filter-modal .gs-btn-clear,
    .gs-btn-clear {
      background-color: #2d3748 !important;
      background: #2d3748 !important;
      color: #ffffff !important;
    }
    #gs-mobile-filter-modal .gs-btn-apply,
    .gs-btn-apply {
      background-color: #d9b268 !important;
      background: #d9b268 !important;
      color: #ffffff !important;
    }
    #gs-mobile-filter-modal .gs-btn-clear::before,
    #gs-mobile-filter-modal .gs-btn-clear::after,
    #gs-mobile-filter-modal .gs-btn-apply::before,
    #gs-mobile-filter-modal .gs-btn-apply::after,
    .gs-btn-clear::before,
    .gs-btn-clear::after,
    .gs-btn-apply::before,
    .gs-btn-apply::after {
      display: none !important;
      content: none !important;
      border: none !important;
      background: none !important;
      opacity: 0 !important;
      width: 0 !important;
      height: 0 !important;
    }
  </style>

  {%- assign sort_by = object.sort_by | default: object.default_sort_by -%}
  {%- assign amount_of_products = collection.products_count | default: 0 -%}
  <div class="offers-top-toolbar">
    <!-- LEFT SIDE: Availability & Price Dropdowns -->
    <div class="offers-left-filters">
      <!-- Availability Filter Dropdown -->
      <div class="offers-dropdown-container" id="offers-avail-container">
        <button type="button" class="offers-dropdown-btn" onclick="toggleOffersDropdown('offers-avail-menu', event)">
          <span>Availability</span>
          <svg class="offers-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1L5 5L9 1"/></svg>
        </button>
        <div class="offers-dropdown-menu" id="offers-avail-menu">
          <form class="offers-filter-form">
            {%- assign avail_filter = object.filters | where: "param_name", "filter.v.availability" | first -%}
            {%- if avail_filter == nil -%}
              {%- assign avail_filter = object.filters | where: "label", "Availability" | first -%}
            {%- endif -%}
            {%- if avail_filter and avail_filter.values.size > 0 -%}
              {%- for val in avail_filter.values -%}
                <label class="offers-checkbox-item">
                  <input type="checkbox" name="{{ val.param_name }}" value="{{ val.value }}" {% if val.active %}checked{% endif %} onchange="submitOffersFilter(this)">
                  <span>{{ val.label }}</span>
                </label>
              {%- endfor -%}
            {%- else -%}
              <label class="offers-checkbox-item">
                <input type="checkbox" name="filter.v.availability" value="1" {% for f in object.filters %}{% for v in f.active_values %}{% if v.value == '1' %}checked{% endif %}{% endfor %}{% endfor %} onchange="submitOffersFilter(this)">
                <span>In stock</span>
              </label>
              <label class="offers-checkbox-item">
                <input type="checkbox" name="filter.v.availability" value="0" {% for f in object.filters %}{% for v in f.active_values %}{% if v.value == '0' %}checked{% endif %}{% endfor %}{% endfor %} onchange="submitOffersFilter(this)">
                <span>Out of stock</span>
              </label>
            {%- endif -%}
          </form>
        </div>
      </div>

      <!-- Price Filter Dropdown -->
      <div class="offers-dropdown-container" id="offers-price-container">
        <button type="button" class="offers-dropdown-btn" onclick="toggleOffersDropdown('offers-price-menu', event)">
          <span>Price</span>
          <svg class="offers-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1L5 5L9 1"/></svg>
        </button>
        <div class="offers-dropdown-menu offers-price-menu" id="offers-price-menu">
          <form class="offers-filter-form" onsubmit="submitOffersPriceFilter(event, this)">
            {%- assign price_filter = object.filters | where: "type", "price_range" | first -%}
            <div class="offers-price-inputs">
              <div class="offers-price-field">
                <label>From ({{ cart.currency.symbol }})</label>
                <input type="number" name="filter.v.price.gte" min="0" placeholder="0" value="{% if price_filter.min_value.value %}{{ price_filter.min_value.value | ceil | divided_by: 100 }}{% endif %}">
              </div>
              <div class="offers-price-field">
                <label>To ({{ cart.currency.symbol }})</label>
                <input type="number" name="filter.v.price.lte" min="0" placeholder="Max" value="{% if price_filter.max_value.value %}{{ price_filter.max_value.value | ceil | divided_by: 100 }}{% endif %}">
              </div>
            </div>
            <button type="submit" class="offers-price-apply-btn">Apply</button>
          </form>
        </div>
      </div>
    </div>

    <!-- RIGHT SIDE: Count, Sort, Grid toggles -->
    <div class="offers-right-controls">
      <span class="offers-items-count">{{ amount_of_products }} items</span>

      <!-- Sort Dropdown -->
      <div class="offers-dropdown-container" id="offers-sort-container">
        <button type="button" class="offers-dropdown-btn" onclick="toggleOffersDropdown('offers-sort-menu', event)">
          <span>Sort</span>
          <svg class="offers-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1L5 5L9 1"/></svg>
        </button>
        <div class="offers-dropdown-menu offers-sort-menu" id="offers-sort-menu">
          <ul class="offers-sort-list">
            {%- for option in object.sort_options -%}
              {%- assign is_active = false -%}
              {%- if option.value == sort_by -%}
                {%- assign is_active = true -%}
              {%- endif -%}
              <li class="offers-sort-item {% if is_active %}active{% endif %}" onclick="selectOffersSort('{{ option.value }}')">
                <span class="offers-sort-tick">{% if is_active %}✓{% else %}&nbsp;{% endif %}</span>
                <span class="offers-sort-name">{{ option.name }}</span>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>

      <!-- Grid View Toggles -->
      <div class="offers-grid-toggles">
        <button type="button" class="offers-grid-btn active" title="Standard Grid View" onclick="setOffersGrid('standard', this)">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor">
            <rect x="1" y="1" width="7" height="7" rx="1.5"/>
            <rect x="10" y="1" width="7" height="7" rx="1.5"/>
            <rect x="1" y="10" width="7" height="7" rx="1.5"/>
            <rect x="10" y="10" width="7" height="7" rx="1.5"/>
          </svg>
        </button>
        <button type="button" class="offers-grid-btn" title="Compact 7-per-row Grid View (Image & Title)" onclick="setOffersGrid('compact', this)">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor">
            <rect x="1" y="1" width="4" height="4" rx="1"/>
            <rect x="7" y="1" width="4" height="4" rx="1"/>
            <rect x="13" y="1" width="4" height="4" rx="1"/>
            <rect x="1" y="7" width="4" height="4" rx="1"/>
            <rect x="7" y="7" width="4" height="4" rx="1"/>
            <rect x="13" y="7" width="4" height="4" rx="1"/>
            <rect x="1" y="13" width="4" height="4" rx="1"/>
            <rect x="7" y="13" width="4" height="4" rx="1"/>
            <rect x="13" y="13" width="4" height="4" rx="1"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- MOBILE FULL SCREEN FILTER & SORT MODAL -->
  <div id="gs-mobile-filter-modal" class="gs-mobile-filter-modal">
    <div class="gs-mobile-modal-header">
      <h2>FILTER</h2>
      <button type="button" class="gs-mobile-modal-close" onclick="closeGsMobileFilterModal()" aria-label="Close Filter Modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    
    <form id="gs-mobile-filter-form" class="gs-mobile-modal-body">
      <input type="hidden" name="sort_by" id="gs-mobile-sort-by-input" value="{{ sort_by }}">

      <!-- 1. AVAILABILITY -->
      {%- assign avail_filter = object.filters | where: "param_name", "filter.v.availability" | first -%}
      {%- if avail_filter == nil -%}
        {%- assign avail_filter = object.filters | where: "label", "Availability" | first -%}
      {%- endif -%}
      <div class="gs-filter-group">
        <h3 class="gs-filter-heading">AVAILABILITY</h3>
        <div class="gs-filter-options">
          {%- if avail_filter and avail_filter.values.size > 0 -%}
            {%- for val in avail_filter.values -%}
              <label class="gs-checkbox-label">
                <input type="checkbox" name="{{ val.param_name }}" value="{{ val.value }}" {% if val.active %}checked{% endif %}>
                <span>{{ val.label }} ({% if val.count != nil %}{{ val.count }}{% else %}0{% endif %})</span>
              </label>
            {%- endfor -%}
          {%- else -%}
            {%- liquid
              assign in_stock_active = false
              assign out_stock_active = false
              for f in object.filters
                for v in f.active_values
                  if v.param_name == 'filter.v.availability' or f.label == 'Availability'
                    if v.value == '1'
                      assign in_stock_active = true
                    elsif v.value == '0'
                      assign out_stock_active = true
                    endif
                  endif
                endfor
              endfor
            -%}
            <label class="gs-checkbox-label">
              <input type="checkbox" name="filter.v.availability" value="1" {% if in_stock_active %}checked{% endif %}>
              <span>In stock</span>
            </label>
            <label class="gs-checkbox-label">
              <input type="checkbox" name="filter.v.availability" value="0" {% if out_stock_active %}checked{% endif %}>
              <span>Out of stock</span>
            </label>
          {%- endif -%}
        </div>
      </div>

      <div class="gs-filter-divider"></div>

      <!-- 2. PRICE -->
      {%- assign price_filter = object.filters | where: "type", "price_range" | first -%}
      <div class="gs-filter-group">
        <h3 class="gs-filter-heading">PRICE</h3>
        {%- assign current_min = price_filter.min_value.value | ceil | divided_by: 100 | default: 0 -%}
        {%- assign current_max = price_filter.max_value.value | ceil | divided_by: 100 | default: price_filter.range_max | ceil | divided_by: 100 | default: 2090 -%}
        {%- assign max_range = price_filter.range_max | ceil | divided_by: 100 | default: 2090 -%}
        
        <div class="gs-price-wrapper">
          <div class="gs-price-range-display">
            Price: {{ cart.currency.symbol }} <span id="gs-m-price-min-text">{{ current_min }}</span> - {{ cart.currency.symbol }} <span id="gs-m-price-max-text">{% if price_filter.max_value.value %}{{ current_max }}{% else %}{{ max_range }}{% endif %}</span>
          </div>
          
          <div class="gs-price-inputs-flex">
            <div class="gs-price-input-col">
              <label>Min ({{ cart.currency.symbol }})</label>
              <input type="number" name="filter.v.price.gte" min="0" max="{{ max_range }}" placeholder="0" value="{% if price_filter.min_value.value %}{{ current_min }}{% endif %}" oninput="document.getElementById('gs-m-price-min-text').textContent = this.value || 0">
            </div>
            <div class="gs-price-input-col">
              <label>Max ({{ cart.currency.symbol }})</label>
              <input type="number" name="filter.v.price.lte" min="0" max="{{ max_range }}" placeholder="{{ max_range }}" value="{% if price_filter.max_value.value %}{{ current_max }}{% endif %}" oninput="document.getElementById('gs-m-price-max-text').textContent = this.value || {{ max_range }}">
            </div>
          </div>
        </div>
      </div>

      <!-- 3. SORT BY -->
      <div class="gs-filter-divider"></div>
      <div class="gs-filter-group">
        <h3 class="gs-filter-heading">SORT BY</h3>
        <div class="gs-filter-options">
          {%- for option in object.sort_options -%}
            <label class="gs-radio-label">
              <input type="radio" name="gs_mobile_sort_radio" value="{{ option.value }}" {% if option.value == sort_by %}checked{% endif %} onchange="document.getElementById('gs-mobile-sort-by-input').value = this.value">
              <span>{{ option.name }}</span>
            </label>
          {%- endfor -%}
        </div>
      </div>

      <!-- 4. OTHER FILTERS -->
      {%- for filter in object.filters -%}
        {%- unless filter.type == 'price_range' or filter.param_name == 'filter.v.availability' or filter.label == 'Availability' -%}
          <div class="gs-filter-divider"></div>
          <div class="gs-filter-group">
            <h3 class="gs-filter-heading">{{ filter.label | upcase }}</h3>
            <div class="gs-filter-options">
              {%- for val in filter.values -%}
                <label class="gs-checkbox-label">
                  <input type="checkbox" name="{{ val.param_name }}" value="{{ val.value }}" {% if val.active %}checked{% endif %}>
                  <span>{{ val.label }} ({{ val.count }})</span>
                </label>
              {%- endfor -%}
            </div>
          </div>
        {%- endunless -%}
      {%- endfor -%}
    </form>

    <div class="gs-mobile-modal-footer">
      <button type="button" class="gs-btn-clear" onclick="clearGsMobileFilters()">Clear all</button>
      <button type="button" class="gs-btn-apply" onclick="applyGsMobileFilters()">Apply</button>
    </div>
  </div>

  <!-- Hidden form so Shopify sort_by JS doesn't break -->
  <form action="./" method="post" class="f8sr hidden" style="display:none;">
    <select id="sort_by" name="sort_by">
      {%- for option in object.sort_options -%}
        <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
      {%- endfor -%}
    </select>
  </form>

  <script>
    function toggleOffersDropdown(menuId, event) {
      if (window.innerWidth <= 768) {
        openGsMobileFilterModal();
        return;
      }
      event.stopPropagation();
      const btn = event.currentTarget;
      const container = btn.closest('.offers-dropdown-container');
      const isOpen = container.classList.contains('open');
      document.querySelectorAll('.offers-dropdown-container').forEach(c => c.classList.remove('open'));
      if (!isOpen) {
        container.classList.add('open');
      }
    }

    function openGsMobileFilterModal() {
      const modal = document.getElementById('gs-mobile-filter-modal');
      if (modal) {
        if (modal.parentNode !== document.body) {
          document.body.appendChild(modal);
        }
        modal.classList.add('open');
        document.body.classList.add('gs-modal-open');
      }
    }

    function closeGsMobileFilterModal() {
      const modal = document.getElementById('gs-mobile-filter-modal');
      if (modal) {
        modal.classList.remove('open');
        document.body.classList.remove('gs-modal-open');
      }
    }

    function clearGsMobileFilters() {
      window.location.href = window.location.pathname;
    }

    function applyGsMobileFilters() {
      const form = document.getElementById('gs-mobile-filter-form');
      if (!form) return;
      const formData = new FormData(form);
      const params = new URLSearchParams(window.location.search);
      
      const keysToDelete = [];
      for (const key of params.keys()) {
        if (key.startsWith('filter.') || key === 'sort_by') {
          keysToDelete.push(key);
        }
      }
      keysToDelete.forEach(k => params.delete(k));

      for (const [key, value] of formData.entries()) {
        if (value !== '' && key !== 'gs_mobile_sort_radio') {
          params.append(key, value);
        }
      }

      window.location.search = params.toString();
    }

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.offers-dropdown-container')) {
        document.querySelectorAll('.offers-dropdown-container').forEach(c => c.classList.remove('open'));
      }
    });

    function selectOffersSort(sortValue) {
      const urlParams = new URLSearchParams(window.location.search);
      urlParams.set('sort_by', sortValue);
      window.location.search = urlParams.toString();
    }

    function submitOffersFilter(checkbox) {
      const urlParams = new URLSearchParams(window.location.search);
      if (checkbox.checked) {
        urlParams.set(checkbox.name, checkbox.value);
      } else {
        urlParams.delete(checkbox.name);
      }
      window.location.search = urlParams.toString();
    }

    function submitOffersPriceFilter(event, form) {
      event.preventDefault();
      const urlParams = new URLSearchParams(window.location.search);
      const minInput = form.querySelector('[name="filter.v.price.gte"]');
      const maxInput = form.querySelector('[name="filter.v.price.lte"]');
      if (minInput && minInput.value !== '') {
        urlParams.set('filter.v.price.gte', minInput.value);
      } else {
        urlParams.delete('filter.v.price.gte');
      }
      if (maxInput && maxInput.value !== '') {
        urlParams.set('filter.v.price.lte', maxInput.value);
      } else {
        urlParams.delete('filter.v.price.lte');
      }
      window.location.search = urlParams.toString();
    }

    function setOffersGrid(mode, btn) {
      try {
        const viewList = document.getElementById('collection');
        if (viewList && viewList.classList) {
          if (mode === 'compact') {
            viewList.classList.add('gs-compact-7');
          } else {
            viewList.classList.remove('gs-compact-7');
          }
          const buttons = document.querySelectorAll('.offers-grid-btn');
          if (buttons && buttons.length) {
            buttons.forEach(b => { if (b && b.classList) b.classList.remove('active'); });
          }
          if (btn && btn.classList) btn.classList.add('active');
          try {
            localStorage.setItem('gs_grid_mode_pref', mode);
          } catch(e){}
        }
      } catch(e) {
        console.warn('setOffersGrid error:', e);
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      try {
        const savedMode = localStorage.getItem('gs_grid_mode_pref');
        if (savedMode === 'compact') {
          const compactBtn = document.querySelector('.offers-grid-btn[onclick*="compact"]');
          if (compactBtn) setOffersGrid('compact', compactBtn);
        } else {
          const standardBtn = document.querySelector('.offers-grid-btn[onclick*="standard"]');
          if (standardBtn) setOffersGrid('standard', standardBtn);
        }
      } catch(e){}
    });
  </script>
{%- elsif display == 'mobile-filter-button' and show_filters -%}
  <form action="./" method="post" class="f8sr desktop-hide{% if sticky %} mobile-sticky mobile-compact{% endif %}">
    <fieldset>
      <p class="link-btn desktop-hide">
        <a
          href="javascript:void(0)"
          onclick="openGsMobileFilterModal()"
          {% if settings.button_style == 'inv' %}
            class="inv"
          {% endif %}
          ><i aria-hidden="true" class="icon-filter"></i> {{ 'collection.filters.filter' | t -}}
        </a>
      </p>
    </fieldset>
  </form>
{%- endif -%}

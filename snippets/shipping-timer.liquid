{% doc %}
  Renders an elevated shipping dispatch timer with live countdown for GulfSouq.
{% enddoc %}

<div class="gs-ship-timer-card">
  <div class="gs-ship-timer-icon-wrap">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="1" y="3" width="15" height="13"></rect>
      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
      <circle cx="5.5" cy="18.5" r="2.5"></circle>
      <circle cx="18.5" cy="18.5" r="2.5"></circle>
    </svg>
  </div>
  <div class="gs-ship-timer-content">
    <span class="gs-ship-timer-text">
      Order within <strong id="gs-countdown" class="gs-ship-countdown">--:--:--</strong> for <span class="gs-ship-highlight">Same-Day&nbsp;Dispatch</span>
    </span>
  </div>
</div>

<script>
(function(){
  var CUTOFF_HOUR = 17, CUTOFF_MIN = 0;
  function tick(){
    var now = new Date();
    var cutoff = new Date(now);
    cutoff.setHours(CUTOFF_HOUR, CUTOFF_MIN, 0, 0);
    if(now >= cutoff) cutoff.setDate(cutoff.getDate() + 1);
    var diff = Math.floor((cutoff - now) / 1000);
    if(diff < 0) diff = 0;
    var h = String(Math.floor(diff/3600)).padStart(2,'0');
    var m = String(Math.floor((diff%3600)/60)).padStart(2,'0');
    var s = String(diff%60).padStart(2,'0');
    var el = document.getElementById('gs-countdown');
    if(el) el.textContent = h + ':' + m + ':' + s;
  }
  tick();
  setInterval(tick, 1000);
})();
</script>

{% doc %}
  @prompt
    Create a premium, clean, minimal “Shipping & Returns” section in the GulfSouq design style.
    
    ✨ Design Style
    
    Light premium background (#FAF8F4)
    
    Navy blue headings (#0C3E61)
    
    Gold icons (#BE982D)
    
    Soft white cards with rounded corners (16–18px)
    
    Smooth shadow for luxury feel
    
    Ultra-clean typography
    
    Spacious and balanced layout
    
    🧩 Section Structure
    
    Main centered title:
    Shipping & Returns
    
    Below the title, create a 2-column grid (1-column on mobile) containing 4 feature cards:
    
    CARD 1 — Fast Delivery
    
    Icon: high-quality truck icon in gold
    
    Title: Fast Delivery
    
    Text: 3–6 business days Pan-India. Express delivery available for metro cities.
    
    CARD 2 — COD Available
    
    Icon: gold cash/card icon
    
    Title: COD Available
    
    Text: Cash on Delivery available across 27,000+ pin codes in India.
    
    CARD 3 — Easy Returns
    
    Icon: gold refresh/return arrow
    
    Title: Easy Returns
    
    Text: 7-day hassle-free returns for unopened products. Instant refund for damaged items.
    
    CARD 4 — Premium Packaging
    
    Icon: gold parcel/box icon
    
    Title: Premium Packaging
    
    Text: Temperature-controlled shipping and tamper-proof packaging ensures freshness.
    
    🎨 Layout Requirements
    
    Icon inside a circular light gold background (#F8F1E5)
    
    Card layout: left icon, right text block
    
    Perfect alignment and spacing
    
    Full width but centered container max-width 1200px
    
    Mobile-friendly & responsive
    
    🧑‍💻 Output Format
    
    Generate full HTML + CSS custom liquid code, clean and lightweight, ready for Shopify Custom Liquid section., font selection facility needed
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shipping-returns-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-shipping-returns-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-shipping-returns-title-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: 600;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
  }

  .ai-shipping-returns-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.title_spacing }}px;
  }

  .ai-shipping-returns-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    box-shadow: {{ block.settings.card_shadow }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-shipping-returns-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(12, 62, 97, 0.12);
  }

  .ai-shipping-returns-icon-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-shipping-returns-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    color: {{ block.settings.icon_color }};
  }

  .ai-shipping-returns-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-shipping-returns-card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_title_color }};
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    font-family: {{ block.settings.card_title_font.family }}, {{ block.settings.card_title_font.fallback_families }};
    font-weight: {{ block.settings.card_title_font.weight }};
    font-style: {{ block.settings.card_title_font.style }};
  }

  .ai-shipping-returns-card-text-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_text_size }}px;
    line-height: 1.6;
    margin: 0;
    font-family: {{ block.settings.card_text_font.family }}, {{ block.settings.card_text_font.fallback_families }};
    font-weight: {{ block.settings.card_text_font.weight }};
    font-style: {{ block.settings.card_text_font.style }};
  }

  @media screen and (max-width: 768px) {
    .ai-shipping-returns-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-shipping-returns-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.75 }}px;
    }

    .ai-shipping-returns-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    }

    .ai-shipping-returns-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }

    .ai-shipping-returns-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }

    .ai-shipping-returns-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.9 }}px;
    }

    .ai-shipping-returns-card-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-shipping-returns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shipping-returns-container-{{ ai_gen_id }}">
    {% if block.settings.main_title != blank %}
      <h2 class="ai-shipping-returns-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
    {% endif %}

    <div class="ai-shipping-returns-grid-{{ ai_gen_id }}">
      <div class="ai-shipping-returns-card-{{ ai_gen_id }}">
        <div class="ai-shipping-returns-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-shipping-returns-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="ai-shipping-returns-content-{{ ai_gen_id }}">
          <h3 class="ai-shipping-returns-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
          <p class="ai-shipping-returns-card-text-{{ ai_gen_id }}">{{ block.settings.card_1_text }}</p>
        </div>
      </div>

      <div class="ai-shipping-returns-card-{{ ai_gen_id }}">
        <div class="ai-shipping-returns-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-shipping-returns-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
        </div>
        <div class="ai-shipping-returns-content-{{ ai_gen_id }}">
          <h3 class="ai-shipping-returns-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
          <p class="ai-shipping-returns-card-text-{{ ai_gen_id }}">{{ block.settings.card_2_text }}</p>
        </div>
      </div>

      <div class="ai-shipping-returns-card-{{ ai_gen_id }}">
        <div class="ai-shipping-returns-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-shipping-returns-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
        </div>
        <div class="ai-shipping-returns-content-{{ ai_gen_id }}">
          <h3 class="ai-shipping-returns-card-title-{{ ai_gen_id }}">{{ block.settings.card_3_title }}</h3>
          <p class="ai-shipping-returns-card-text-{{ ai_gen_id }}">{{ block.settings.card_3_text }}</p>
        </div>
      </div>

      <div class="ai-shipping-returns-card-{{ ai_gen_id }}">
        <div class="ai-shipping-returns-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-shipping-returns-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <div class="ai-shipping-returns-content-{{ ai_gen_id }}">
          <h3 class="ai-shipping-returns-card-title-{{ ai_gen_id }}">{{ block.settings.card_4_title }}</h3>
          <p class="ai-shipping-returns-card-text-{{ ai_gen_id }}">{{ block.settings.card_4_text }}</p>
        </div>
      </div>
    </div>
  </div>
</div>


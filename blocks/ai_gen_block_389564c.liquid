{% doc %}
  @prompt
    Create a premium, clean, minimalist “GulfSouq Trust” section using HTML + CSS.
    The design must match a luxury ecommerce style using these brand colors:
    
    Navy Blue: #0C3E61
    
    Gold: #BE982D
    
    White: #FFFFFF
    
    🔹 Section Header
    
    Centered title using two parts:
    
    GulfSouq (navy color)
    
    Trust (gold color)
    
    Font: bold, modern, elegant.
    
    🔹 Feature Grid (Trust Badges)
    
    Create a 3-column grid on desktop and 2-column grid on mobile, containing the following 8 trust badges:
    
    Secure Payment
    
    Delivery Tracking
    
    Easy Returns
    
    Quality Assurance
    
    Customer Support
    
    Genuine Products
    
    All India Delivery
    
    Offline Payments
    
    🔹 Icon Style
    
    Use gold SVG icons inside each item (use simple, elegant outline icons)
    
    Icon size around 20–22px desktop and 24–26px mobile
    
    Icons aligned to the left of the text
    
    🔹 Text Style
    
    Navy text (#0C3E61)
    
    Font weight: 600
    
    Size: 14px desktop, 13–14px mobile
    
    🔹 Mobile Layout Fix
    
    On mobile (max-width 768px):
    
    Increase space between columns
    
    Increase row spacing
    
    Icons become slightly larger
    
    Allow text to wrap
    
    🔹 Container
    
    Full width with white background
    
    Max-width container: 1100px
    
    Section padding: 18px top/bottom
    
    🔹 Output Required
    
    Generate clean HTML + CSS only.
    Code should be fully responsive and match this exact structure:
    
    Title centered
    
    Grid of 8 trust items
    
    Icon + label horizontally aligned
    
    Perfect spacing and visual balance on mobile and desktop
    
    PROMPT END
    
    ✅ What this prompt produces
    
    Using this prompt, Shopify AI Builder will generate:
    
    ✔ The exact same design you have
    ✔ Correct desktop 3-column layout
    ✔ Correct mobile 2-column layout with spacing
    ✔ Matching GulfSouq brand colors
    ✔ Professionally styled icons and text, section must be full width, edge to edge
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gulfsouq-trust-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
    width: 100%;
    margin: 0;
  }

  .ai-gulfsouq-trust-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-gulfsouq-trust-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 32px;
  }

  .ai-gulfsouq-trust-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .ai-gulfsouq-trust-title-navy-{{ ai_gen_id }} {
    color: {{ block.settings.navy_color }};
  }

  .ai-gulfsouq-trust-title-gold-{{ ai_gen_id }} {
    color: {{ block.settings.gold_color }};
  }

  .ai-gulfsouq-trust-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px 32px;
  }

  .ai-gulfsouq-trust-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-gulfsouq-trust-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: {{ block.settings.gold_color }};
  }

  .ai-gulfsouq-trust-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
  }

  .ai-gulfsouq-trust-label-{{ ai_gen_id }} {
    color: {{ block.settings.navy_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    line-height: 1.3;
  }

  @media screen and (max-width: 768px) {
    .ai-gulfsouq-trust-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-gulfsouq-trust-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 24px;
    }

    .ai-gulfsouq-trust-icon-{{ ai_gen_id }} {
      width: 26px;
      height: 26px;
    }

    .ai-gulfsouq-trust-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-gulfsouq-trust-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-gulfsouq-trust-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gulfsouq-trust-container-{{ ai_gen_id }}">
    <div class="ai-gulfsouq-trust-header-{{ ai_gen_id }}">
      <h2 class="ai-gulfsouq-trust-title-{{ ai_gen_id }}">
        <span class="ai-gulfsouq-trust-title-navy-{{ ai_gen_id }}">{{ block.settings.title_part_1 }}</span>
        <span class="ai-gulfsouq-trust-title-gold-{{ ai_gen_id }}">{{ block.settings.title_part_2 }}</span>

{% doc %}
  @prompt
    <section class="gs-trust-strip">
      <div class="gs-trust-inner">
    
        <!-- 1. 100% Genuine -->
        <div class="gs-trust-item">
          <div class="gs-trust-icon-wrap">
            <svg viewBox="0 0 24 24" class="gs-trust-icon" aria-hidden="true">
              <path d="M12 2 4 5v6c0 4.1 2.8 7.6 8 9 5.2-1.4 8-4.9 8-9V5l-8-3Z"/>
            </svg>
          </div>
          <div class="gs-trust-text">
            <p class="gs-trust-heading">100% Genuine</p>
            <p class="gs-trust-subtext">Authentic Imported Products</p>
          </div>
        </div>
    
        <!-- 2. Secure Payments -->
        <div class="gs-trust-item">
          <div class="gs-trust-icon-wrap">
            <svg viewBox="0 0 24 24" class="gs-trust-icon" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" ry="2"/>
              <rect x="4" y="9" width="16" height="2"/>
            </svg>
          </div>
          <div class="gs-trust-text">
            <p class="gs-trust-heading">Secure Payments</p>
            <p class="gs-trust-subtext">Encrypted Transactions</p>
          </div>
        </div>
    
        <!-- 3. Express Delivery -->
        <div class="gs-trust-item">
          <div class="gs-trust-icon-wrap">
            <svg viewBox="0 0 24 24" class="gs-trust-icon" aria-hidden="true">
              <path d="M3 7h9v8H3z"/>
              <path d="M14 9h4l3 3v6h-7z"/>
              <circle cx="7" cy="18" r="1.7"/>
              <circle cx="17" cy="18" r="1.7"/>
            </svg>
          </div>
          <div class="gs-trust-text">
            <p class="gs-trust-heading">Express Delivery</p>
            <p class="gs-trust-subtext">Pan-India Shipping</p>
          </div>
        </div>
    
        <!-- 4. Premium Support -->
        <div class="gs-trust-item">
          <div class="gs-trust-icon-wrap">
            <svg viewBox="0 0 24 24" class="gs-trust-icon" aria-hidden="true">
              <path d="M12 4a6 6 0 0 0-6 6v3a3 3 0 0 0 3 3h1v-5H7.5V10a4.5 4.5 0 0 1 9 0v1H14v5h1a3 3 0 0 0 3-3v-3a6 6 0 0 0-6-6z"/>
            </svg>
          </div>
          <div class="gs-trust-text">
            <p class="gs-trust-heading">Premium Support</p>
       , 4 IN ROW IN DESK TOP AND MOBILE 2 COLUMS , FULL WIDTH ADN BOX WIDTH SELECTION FACILITY NEEDED, IT MUST BE FULL WIDTH TO PAGE, I MEAN SIDE WISE, REMOVE WIDTH  STYLE FACILITY, AND IT SHOULD BE FULLY WIDTH, Make this trust badge strip section 100% FULL WIDTH (edge-to-edge) across the entire screen:
    
    The background color must touch both the left and right edges of the browser
    
    The section must ignore the theme’s container or boxed width
    
    Remove any max-width, container, or page padding limitations
    
    The inner items should use flexible spacing but the background must stretch full screen
    
    Absolutely no left or right white space
    
    Must work on:
    
    Desktop
    
    Tablet
    
    Mobile
    
    Do NOT use sliders, carousels, or JavaScript
    
    Keep performance lightweight and SEO safe
    
    Keep all text, icons, colors, and layout exactly the same as previously defined, only force TRUE full-width behavior.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .gs-trust-strip-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  .gs-trust-inner-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.item_spacing }}px;
    padding: 0 {{ block.settings.padding_horizontal }}px;
    max-width: 100%;
  }

  .gs-trust-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .gs-trust-icon-wrap-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .gs-trust-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
    fill: {{ block.settings.icon_color }};
  }

  .gs-trust-text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .gs-trust-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    line-height: 1.2;
  }

  .gs-trust-subtext-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .gs-trust-strip-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical_mobile }}px 0;
    }

    .gs-trust-inner-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.item_spacing_mobile }}px;
      padding: 0 {{ block.settings.padding_horizontal_mobile }}px;
    }

    .gs-trust-item-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_text_gap_mobile }}px;
      flex-direction: column;
      text-align: center;
    }

    .gs-trust-icon-wrap-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .gs-trust-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size_mobile }}px * 0.6);
      height: calc({{ block.settings.icon_size_mobile }}px * 0.6);
    }

    .gs-trust-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .gs-trust-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size_mobile }}px;
    }
  }
{% endstyle %}

<section class="gs-trust-strip-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="gs-trust-inner-{{ ai_gen_id }}">
    {% if block.settings.item_1_enabled %}
      <div class="gs-trust-item-{{ ai_gen_id }}">
        <div class="gs-trust-icon-wrap-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" class="gs-trust-icon-{{ ai_gen_id }}" aria-hidden="true">
            <path d="M12 2 4 5v6c0 4.1 2.8 7.6 8 9 5.2-1.4 8-4.9 8-9V5l-8-3Z"/>
          </svg>
        </div>
        <div class="gs-trust-text-{{ ai_gen_id }}">
          <p class="gs-trust-heading-{{ ai_gen_id }}">{{ block.settings.item_1_heading }}</p>
          <p class="gs-trust-subtext-{{ ai_gen_id }}">{{ block.settings.item_1_subtext }}</p>
        </div>
      </div>
    {% endif %}

    {% if block.settings.item_2_enabled %}
      <div class="gs-trust-item-{{ ai_gen_id }}">
        <div class="gs-trust-icon-wrap-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" class="gs-trust-icon-{{ ai_gen_id }}" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" ry="2"/>
            <rect x="4" y="9" width="16" height="2"/>
          </svg>
        </div>
        <div class="gs-trust-text-{{ ai_gen_id }}">
          <p class="gs-trust-heading-{{ ai_gen_id }}">{{ block.settings.item_2_heading }}</p>
          <p class="gs-trust-subtext-{{ ai_gen_id }}">{{ block.settings.item_2_subtext }}</p>
        </div>
      </div>
    {% endif %}

    {% if block.settings.item_3_enabled %}
      <div class="gs-trust-item-{{ ai_gen_id }}">
        <div class="gs-trust-icon-wrap-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" class="gs-trust-icon-{{ ai_gen_id }}" aria-hidden="true">
            <path d="M3 7h9v8H3z"/>
            <path d="M14 9h4l3 3v6h-7z"/>
            <circle cx="7" cy="18" r="1.7"/>
            <circle cx="17" cy="18" r="1.7"/>
          </svg>
        </div>
        <div class="gs-trust-text-{{ ai_gen_id }}">
          <p class="gs-trust-heading-{{ ai_gen_id }}">{{ block.settings.item_3_heading }}</p>
          <p class="gs-trust-subtext-{{ ai_gen_id }}">{{ block.settings.item_3_subtext }}</p>
        </div>
      </div>
    {% endif %}

    {% if block.settings.item_4_enabled %}
      <div class="gs-trust-item-{{ ai_gen_id }}">
        <div class="gs-trust-icon-wrap-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" class="gs-trust-icon-{{ ai_gen_id }}" aria-hidden="true">
            <path d="M12 4a6 6 0 0 0-6 6v3a3 3 0 0 0 3 3h1v-5H7.5V10a4.5 4.5 0 0 1 9 0v1H14v5h1a3 3 0 0 0 3-3v-3a6 6 0 0 0-6-6z"/>
          </svg>
        </div>
        <div class="gs-trust-text-{{ ai_gen_id }}">
          <p class="gs-trust-heading-{{ ai_gen_id }}">{{ block.settings.item_4_heading }}</p>
          <p class="gs-trust-subtext-{{ ai_gen_id }}">{{ block.settings.item_4_subtext }}</p>
        </div>
      </div>
    {% endif %}
  </div>
</section>


<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.ensureSeamlessLoop();
      }

      ensureSeamlessLoop() {
        const track = this.querySelector('.ai-announcement-bar-track-{{ ai_gen_id }}');
        if (!track) return;

        track.addEventListener('animationiteration', function() {
          this.style.transform = 'translateX(0)';
        });
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>


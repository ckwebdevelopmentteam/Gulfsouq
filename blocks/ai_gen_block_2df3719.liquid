{% doc %}
  @prompt
    3 card moving announcement bar, icon on/off facility needed, and custom icon selection facility needed., no gap between cards, 3 card should be like one line cards, there is no separation or gap, reduce thickness of this section, it must be loop, there is no ending for animation, animation loop needed
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    position: relative;
  }

  .ai-announcement-bar-track-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-announcement-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-announcement-bar-{{ ai_gen_id }}:hover .ai-announcement-bar-track-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-announcement-bar-group-{{ ai_gen_id }} {
    display: flex;
    flex-shrink: 0;
  }

  .ai-announcement-bar-card-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: {{ block.settings.card_padding }}px {{ block.settings.card_padding | times: 2 }}px;
    background-color: {{ block.settings.card_background_color }};
    color: {{ block.settings.text_color }};
    text-decoration: none;
    transition: opacity 0.3s ease;
    min-width: 280px;
    border-right: 1px solid {{ block.settings.separator_color }};
    white-space: nowrap;
  }

  .ai-announcement-bar-card-{{ ai_gen_id }}:hover {
    opacity: 0.85;
  }

  .ai-announcement-bar-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-announcement-bar-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-announcement-bar-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-announcement-bar-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
  }

  .ai-announcement-bar-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
    line-height: 1.4;
    opacity: 0.9;
  }

  @keyframes ai-announcement-scroll-{{ ai_gen_id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-card-{{ ai_gen_id }} {
      min-width: 240px;
      padding: {{ block.settings.card_padding | times: 0.8 }}px {{ block.settings.card_padding | times: 1.5 }}px;
    }

    .ai-announcement-bar-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-announcement-bar-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-announcement-bar-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }
  }
{% endstyle %}


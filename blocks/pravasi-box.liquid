    {
      "type": "range",
      "id": "description_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "text",
      "id": "feature_1_text",
      "label": "Feature 1",
      "default": "Premium Curation – Handpicked Gulf treasures"
    },
    {
      "type": "text",
      "id": "feature_2_text",
      "label": "Feature 2",
      "default": "Gifting Ready – Luxury packaging included"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary button text",
      "default": "Order Your Pravasi Box"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary button text",
      "default": "Customize Box"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price text",
      "default": "Starting at ₹2,999 • Free Premium Packaging"
    },
    {
      "type": "header",
      "content": "Rating badge"
    },
    {
      "type": "checkbox",
      "id": "show_rating",

{% doc %}
  @prompt
    <section class="gs-story-section">
      <div class="gs-story-inner">
        <p class="gs-story-label">OUR STORY</p>
    
        <h2 class="gs-story-heading">Bridging the Gulf &amp; India</h2>
    
        <div class="gs-story-underline"></div>
    
        <div class="gs-story-body">
          <p>
            "<span>Gulf Souq was born from a simple yet profound realization: millions of Indian families have deep connections to the Arabian Gulf, yet access to authentic Gulf products in India remains limited.</span>
          </p>
    
          <p>
            We set out to change that. Today, Gulf Souq stands as India's premier destination for authentic imported Gulf products – from the sacred Ajwa dates of Madinah to the luxurious attars of Arabia, from premium chocolates to elegant modest wear.
          </p>
    
          <p>
            Every product is handpicked, every shipment is carefully curated, and every customer is treated like family. Because at Gulf Souq, we're not just selling products – we're delivering a piece of the Gulf to every Indian home."
          </p>
        </div>
    
        <div class="gs-story-founder">
          <span class="gs-story-line"></span>
          <span class="gs-story-founder-text">Gulf Souq Founder</span>
          <span class="gs-story-line"></span>
        </div>
      </div>
    </section>
    
    <style>
      .gs-story-section {
        background: #0C3E61;
        color: #FFFFFF;
        width: 100%;
        padding: 60px 16px 70px;
      }
    
      .gs-story-inner {
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
      }
    
      .gs-story-label {
        margin: 0 0 8px;
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #BE982D;
      }
    
      .gs-story-heading {
        margin: 0;
        font-size: 32px;
        line-height: 1.25;
        font-weight: 700;
      }
    
      .gs-story-underline {
        width: 80px;
        height: 2px;
        background: #BE982D;
        margin: 14px auto 28px;
      }
    
      .gs-story-body p {
        margin: 0 0 16px;
        font-size: 15px;
        line-height: 1.7;
        color: rgba(255,255,255,0.9);
      }
    
      .gs-story-body p:first-child span::f, Make this “Our Story – Bridging the Gulf & India” section 100% FULL WIDTH (edge-to-edge) across the entire screen:
    
    The dark navy background must touch both left and right edges
    
    Remove any container, page padding, boxed width, or max-width restriction
    
    The content can stay centered, but the background must be full screen
    
    Do NOT crop the gradient or background color at any breakpoint
    
    Must work perfectly on:
    
    Desktop
    
    Tablet
    
    Mobile
    
    Do NOT use sliders, carousels, or JavaScript
    
    Keep performance lightweight and SEO-safe
    
    ✅ Keep all text, fonts, spacing, and layout exactly the same
    ✅ Only change the section to be TRUE full width
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-story-hero-section-{{ ai_gen_id }} {
    background: #FDFBF7;
    color: #2D3748;
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 44px 0 54px;
    font-family: 'Outfit', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  }

  .ai-story-hero-container-{{ ai_gen_id }} {
    max-width: 1540px;
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
  }

  .ai-story-hero-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1.32fr;
    gap: 48px;
    align-items: center;
  }

  /* Left Column */
  .ai-story-hero-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ai-story-hero-eyebrow-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .ai-story-eyebrow-line-{{ ai_gen_id }} {
    width: 28px;
    height: 2px;
    background: #BE982D;
    border-radius: 2px;
    display: inline-block;
  }

  .ai-story-eyebrow-text-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #BE982D;
  }

  .ai-story-hero-title-{{ ai_gen_id }} {
    margin: 0 0 12px 0;
    font-size: 40px;
    line-height: 1.18;
    font-weight: 700;
    color: #0C3E61;
    letter-spacing: -0.5px;
  }

  .ai-gold-accent-{{ ai_gen_id }} {
    color: #BE982D;
  }

  .ai-story-hero-subtitle-{{ ai_gen_id }} {
    margin: 0 0 16px 0;
    font-size: 16px;
    line-height: 1.45;
    font-weight: 600;
    color: #0C3E61;
    opacity: 0.9;
  }

  .ai-story-hero-copy-{{ ai_gen_id }} p {
    margin: 0 0 14px 0;
    font-size: 15px;
    line-height: 1.7;
    color: #4A5568;
  }

  .ai-story-hero-copy-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-story-hero-btn-wrap-{{ ai_gen_id }} {
    margin-top: 24px;
    display: flex;
    justify-content: flex-start;
  }

  .ai-story-hero-btn-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 30px;
    border-radius: 30px;
    background: #0C3E61;
    color: #FFFFFF !important;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-decoration: none;
    border: 1.5px solid #0C3E61;
    box-shadow: 0 4px 14px rgba(12, 62, 97, 0.25);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .ai-story-hero-btn-{{ ai_gen_id }}:hover {
    background: #082C46;
    border-color: #082C46;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(12, 62, 97, 0.35);
  }

  .ai-story-hero-btn-{{ ai_gen_id }} svg {
    transition: transform 0.2s ease;
  }

  .ai-story-hero-btn-{{ ai_gen_id }}:hover svg {
    transform: translateX(4px);
  }

  /* Right Column: Visual Banner */
  .ai-story-hero-right-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-story-banner-card-{{ ai_gen_id }} {
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(12, 62, 97, 0.09);
    border: 1px solid rgba(190, 152, 45, 0.22);
    background: #FFFFFF;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-story-banner-card-{{ ai_gen_id }}:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 46px rgba(12, 62, 97, 0.14);
  }

  .ai-story-banner-img-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Bottom Row: 4 KPI Cards */
  .ai-story-kpi-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 36px;
  }

  .ai-story-kpi-card-{{ ai_gen_id }} {
    background: #FFFFFF;
    border: 1px solid #EAE6DF;
    border-radius: 16px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .ai-story-kpi-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(12, 62, 97, 0.08);
    border-color: #BE982D;
  }

  .ai-story-kpi-icon-pill-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #FAF7F2;
    border: 1px solid rgba(190, 152, 45, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-story-kpi-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-story-kpi-val-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 700;
    color: #0C3E61;
    line-height: 1.15;
    letter-spacing: -0.3px;
  }

  .ai-story-kpi-lbl-{{ ai_gen_id }} {
    font-size: 13.5px;
    color: #718096;
    font-weight: 500;
    margin-top: 3px;
    line-height: 1.25;
  }

  @media screen and (max-width: 1024px) {
    .ai-story-hero-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-story-hero-title-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-story-kpi-row-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin-top: 30px;
    }
  }

  @media screen and (max-width: 640px) {
    .ai-story-hero-section-{{ ai_gen_id }} {
      padding: 24px 0 32px;
    }

    .ai-story-hero-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-story-hero-title-{{ ai_gen_id }} {
      font-size: 26px;
    }

    .ai-story-hero-subtitle-{{ ai_gen_id }} {
      font-size: 14.5px;
    }

    .ai-story-hero-copy-{{ ai_gen_id }} p {
      font-size: 14px;
    }

    .ai-story-kpi-card-{{ ai_gen_id }} {
      padding: 14px;
      gap: 12px;
    }

    .ai-story-kpi-icon-pill-{{ ai_gen_id }} {
      width: 44px;
      height: 44px;
    }

    .ai-story-kpi-val-{{ ai_gen_id }} {
      font-size: 20px;
    }

    .ai-story-kpi-lbl-{{ ai_gen_id }} {
      font-size: 12px;
    }
  }
{% endstyle %}

<section class="ai-story-hero-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-story-hero-container-{{ ai_gen_id }}">
    <div class="ai-story-hero-grid-{{ ai_gen_id }}">
      
      <!-- Left: Headline, Story Copy & Button -->
      <div class="ai-story-hero-left-{{ ai_gen_id }}">
        <div class="ai-story-hero-eyebrow-{{ ai_gen_id }}">
          <span class="ai-story-eyebrow-line-{{ ai_gen_id }}"></span>
          <span class="ai-story-eyebrow-text-{{ ai_gen_id }}">{{ block.settings.label | default: 'OUR STORY' }}</span>
        </div>

        <h2 class="ai-story-hero-title-{{ ai_gen_id }}">
          Bridging the <span class="ai-gold-accent-{{ ai_gen_id }}">Gulf &amp; India</span>
        </h2>

        <p class="ai-story-hero-subtitle-{{ ai_gen_id }}">Authentic products. A richer lifestyle. Now closer to you.</p>

        <div class="ai-story-hero-copy-{{ ai_gen_id }}">
          <p>
            Gulf Souq was born from a simple yet profound realization: millions of Indian families have deep connections to the Arabian Gulf, yet access to authentic Gulf products in India remains limited.
          </p>
          <p>
            We set out to change that. Today, Gulf Souq stands as India's premier destination for authentic imported Gulf products &ndash; from the sacred Ajwa dates of Madinah to the luxurious attars of Arabia, from premium chocolates to elegant modest wear.
          </p>
          <p>
            Every product is handpicked, every shipment is carefully curated, and every customer is treated like family. Because at Gulf Souq, we're not just selling products &ndash; we're delivering a piece of the Gulf to every Indian home.
          </p>
        </div>

        <div class="ai-story-hero-btn-wrap-{{ ai_gen_id }}">
          <a href="{{ block.settings.button_link | default: '/pages/about-us' }}" class="ai-story-hero-btn-{{ ai_gen_id }}">
            <span>{{ block.settings.button_text | default: 'Read Our Story' }}</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: Master Visual Banner Graphic -->
      <div class="ai-story-hero-right-{{ ai_gen_id }}">
        <div class="ai-story-banner-card-{{ ai_gen_id }}">
          <img src="{{ 'gulfsouq_hero_banner.png' | asset_url }}" alt="Authentic Products from the GCC - GulfSouq" class="ai-story-banner-img-{{ ai_gen_id }}" width="800" height="300" loading="eager">
        </div>
      </div>

    </div>

    <!-- Bottom: 4 KPI Cards (Original Data) -->
    <div class="ai-story-kpi-row-{{ ai_gen_id }}">
      
      <!-- Card 1: Happy Customers -->
      <div class="ai-story-kpi-card-{{ ai_gen_id }}">
        <div class="ai-story-kpi-icon-pill-{{ ai_gen_id }}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#BE982D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <div class="ai-story-kpi-info-{{ ai_gen_id }}">
          <div class="ai-story-kpi-val-{{ ai_gen_id }}">10000+</div>
          <div class="ai-story-kpi-lbl-{{ ai_gen_id }}">Happy Customers</div>
        </div>
      </div>

      <!-- Card 2: Average Rating -->
      <div class="ai-story-kpi-card-{{ ai_gen_id }}">
        <div class="ai-story-kpi-icon-pill-{{ ai_gen_id }}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#BE982D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <div class="ai-story-kpi-info-{{ ai_gen_id }}">
          <div class="ai-story-kpi-val-{{ ai_gen_id }}">4.9/5</div>
          <div class="ai-story-kpi-lbl-{{ ai_gen_id }}">Average Rating</div>
        </div>
      </div>

      <!-- Card 3: Genuine Products -->
      <div class="ai-story-kpi-card-{{ ai_gen_id }}">
        <div class="ai-story-kpi-icon-pill-{{ ai_gen_id }}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#BE982D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div class="ai-story-kpi-info-{{ ai_gen_id }}">
          <div class="ai-story-kpi-val-{{ ai_gen_id }}">100%</div>
          <div class="ai-story-kpi-lbl-{{ ai_gen_id }}">Genuine Products</div>
        </div>
      </div>

      <!-- Card 4: Cities Delivered -->
      <div class="ai-story-kpi-card-{{ ai_gen_id }}">
        <div class="ai-story-kpi-icon-pill-{{ ai_gen_id }}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#BE982D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="ai-story-kpi-info-{{ ai_gen_id }}">
          <div class="ai-story-kpi-val-{{ ai_gen_id }}">200+</div>
          <div class="ai-story-kpi-lbl-{{ ai_gen_id }}">Cities Delivered</div>
        </div>
      </div>

    </div>

  </div>
</section>


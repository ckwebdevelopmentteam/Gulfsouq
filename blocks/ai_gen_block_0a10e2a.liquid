{% doc %}
  @prompt
    <section class="gs-story-section">
      <div class="gs-story-inner">
        <p class="gs-story-label">OUR STORY</p>
    
        <h2 class="gs-story-heading">Bridging the Gulf &amp; India</h2>
    
        <div class="gs-story-underline"></div>
    
        <div class="gs-story-body">
          <p>
            "<span>Gulf Souq was born from a simple yet profound realization: millions of Indian families have deep connections to the Arabian Gulf, yet access to authentic Gulf products in India remains limited.</span>
          </p>
    
          <p>
            We set out to change that. Today, Gulf Souq stands as India's premier destination for authentic imported Gulf products – from the sacred Ajwa dates of Madinah to the luxurious attars of Arabia, from premium chocolates to elegant modest wear.
          </p>
    
          <p>
            Every product is handpicked, every shipment is carefully curated, and every customer is treated like family. Because at Gulf Souq, we're not just selling products – we're delivering a piece of the Gulf to every Indian home."
          </p>
        </div>
    
        <div class="gs-story-founder">
          <span class="gs-story-line"></span>
          <span class="gs-story-founder-text">Gulf Souq Founder</span>
          <span class="gs-story-line"></span>
        </div>
      </div>
    </section>
    
    <style>
      .gs-story-section {
        background: #0C3E61;
        color: #FFFFFF;
        width: 100%;
        padding: 60px 16px 70px;
      }
    
      .gs-story-inner {
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
      }
    
      .gs-story-label {
        margin: 0 0 8px;
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #BE982D;
      }
    
      .gs-story-heading {
        margin: 0;
        font-size: 32px;
        line-height: 1.25;
        font-weight: 700;
      }
    
      .gs-story-underline {
        width: 80px;
        height: 2px;
        background: #BE982D;
        margin: 14px auto 28px;
      }
    
      .gs-story-body p {
        margin: 0 0 16px;
        font-size: 15px;
        line-height: 1.7;
        color: rgba(255,255,255,0.9);
      }
    
      .gs-story-body p:first-child span::f, Make this “Our Story – Bridging the Gulf & India” section 100% FULL WIDTH (edge-to-edge) across the entire screen:
    
    The dark navy background must touch both left and right edges
    
    Remove any container, page padding, boxed width, or max-width restriction
    
    The content can stay centered, but the background must be full screen
    
    Do NOT crop the gradient or background color at any breakpoint
    
    Must work perfectly on:
    
    Desktop
    
    Tablet
    
    Mobile
    
    Do NOT use sliders, carousels, or JavaScript
    
    Keep performance lightweight and SEO-safe
    
    ✅ Keep all text, fonts, spacing, and layout exactly the same
    ✅ Only change the section to be TRUE full width
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-story-section-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-story-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-story-label-{{ ai_gen_id }} {
    margin: 0 0 8px;
    font-size: {{ block.settings.label_font_size }}px;
    letter-spacing: {{ block.settings.label_letter_spacing }}em;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
  }

  .ai-story-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_font_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    font-weight: {{ block.settings.heading_font_weight }};
    color: {{ block.settings.heading_color }};
  }

  .ai-story-underline-{{ ai_gen_id }} {
    width: {{ block.settings.underline_width }}px;
    height: {{ block.settings.underline_height }}px;
    background: {{ block.settings.underline_color }};
    margin: {{ block.settings.underline_margin_top }}px auto {{ block.settings.underline_margin_bottom }}px;
    {% if block.settings.text_alignment == 'left' %}
      margin-left: 0;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-right: 0;
    {% endif %}
  }

  .ai-story-body-{{ ai_gen_id }} {
    margin-top: {{ block.settings.body_margin_top }}px;
  }

  .ai-story-body-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
    font-size: {{ block.settings.body_font_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.body_text_color }};
  }

  .ai-story-body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-story-founder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.founder_gap }}px;
    margin-top: {{ block.settings.founder_margin_top }}px;
    {% if block.settings.text_alignment == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: center;
    {% endif %}
  }

  .ai-story-line-{{ ai_gen_id }} {
    flex: 1;
    height: {{ block.settings.founder_line_height }}px;
    background: {{ block.settings.founder_line_color }};
    max-width: {{ block.settings.founder_line_max_width }}px;
  }

  .ai-story-founder-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.founder_font_size }}px;
    color: {{ block.settings.founder_text_color }};
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ai-story-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 0 {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-story-inner-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.padding_horizontal_mobile }}px;
    }

    .ai-story-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size_mobile }}px;
    }

    .ai-story-body-{{ ai_gen_id }} p {
      font-size: {{ block.settings.body_font_size_mobile }}px;
    }

    .ai-story-line-{{ ai_gen_id }} {
      max-width: {{ block.settings.founder_line_max_width_mobile }}px;
    }
  }
{% endstyle %}

<section class="ai-story-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-story-inner-{{ ai_gen_id }}">
    {% if block.settings.label != blank %}
      <p class="ai-story-label-{{ ai_gen_id }}">{{ block.settings.label }}</p>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-story-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.show_underline %}
      <div class="ai-story-underline-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.body_text != blank %}
      <div class="ai-story-body-{{ ai_gen_id }}">
        {{ block.settings.body_text }}
      </div>
    {% endif %}

    {% if block.settings.show_founder_signature %}
      <div class="ai-story-founder-{{ ai_gen_id }}">
        {% if block.settings.show_founder_lines %}
          <span class="ai-story-line-{{ ai_gen_id }}"></span>
        {% endif %}
        <span class="ai-story-founder-text-{{ ai_gen_id }}">{{ block.settings.founder_text }}</span>
        {% if block.settings.show_founder_lines %}
          <span class="ai-story-line-{{ ai_gen_id }}"></span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>


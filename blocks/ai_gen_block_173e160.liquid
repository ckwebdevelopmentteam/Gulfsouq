{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% capture cards_html %}
  {% for i in (1..6) %}
    {% liquid
      assign testimonial_enabled_key = 'testimonial_' | append: i | append: '_enabled'
      assign testimonial_text_key = 'testimonial_' | append: i | append: '_text'
      assign testimonial_name_key = 'testimonial_' | append: i | append: '_name'
      assign testimonial_location_key = 'testimonial_' | append: i | append: '_location'
      assign testimonial_avatar_key = 'testimonial_' | append: i | append: '_avatar'
      assign testimonial_rating_key = 'testimonial_' | append: i | append: '_rating'
      assign testimonial_verified_key = 'testimonial_' | append: i | append: '_verified'

      assign testimonial_enabled = block.settings[testimonial_enabled_key]
      assign testimonial_text = block.settings[testimonial_text_key]
      assign testimonial_name = block.settings[testimonial_name_key]
      assign testimonial_location = block.settings[testimonial_location_key]
      assign testimonial_avatar = block.settings[testimonial_avatar_key]
      assign testimonial_rating = block.settings[testimonial_rating_key]
      assign testimonial_verified = block.settings[testimonial_verified_key]
    %}

    {% if testimonial_enabled and testimonial_text != blank %}
      <article class="gs-test-card-{{ ai_gen_id }}">
        <div class="gs-test-quote-icon-{{ ai_gen_id }}">
          <svg width="30" height="24" viewBox="0 0 32 26" fill="currentColor">
            <path d="M9.8 0C4.4 0 0 4.4 0 9.8C0 14.5 3.3 18.5 7.8 19.3C6.9 23.5 3.4 26.5 0.6 27.4L2.3 30.5C7 29 12.8 24 13.9 17.9C14.4 15.4 14.6 12.5 14.6 9.8C14.6 4.4 11 0 9.8 0ZM27.2 0C21.8 0 17.4 4.4 17.4 9.8C17.4 14.5 20.7 18.5 25.2 19.3C24.3 23.5 20.8 26.5 18 27.4L19.7 30.5C24.4 29 30.2 24 31.3 17.9C31.8 15.4 32 12.5 32 9.8C32 4.4 28.4 0 27.2 0Z"/>
          </svg>
        </div>

        <div class="gs-rating-row-{{ ai_gen_id }}">
          <div class="gs-test-stars-{{ ai_gen_id }}">
            {% if testimonial_rating == 5 %}
              ★★★★★
            {% elsif testimonial_rating == 4 %}
              ★★★★☆
            {% elsif testimonial_rating == 3 %}
              ★★★☆☆
            {% elsif testimonial_rating == 2 %}
              ★★☆☆☆
            {% else %}
              ★☆☆☆☆
            {% endif %}
          </div>
          <span class="gs-rating-score-{{ ai_gen_id }}">5.0</span>
        </div>

        <p class="gs-test-text-{{ ai_gen_id }}">{{ testimonial_text }}</p>

        <div class="gs-test-divider-{{ ai_gen_id }}"></div>

        <div class="gs-test-footer-{{ ai_gen_id }}">
          {% if testimonial_avatar != blank %}
            <div class="gs-test-avatar-{{ ai_gen_id }}">{{ testimonial_avatar }}</div>
          {% endif %}
          <div class="gs-test-info-{{ ai_gen_id }}">
            {% if testimonial_name != blank %}
              <p class="gs-test-name-{{ ai_gen_id }}">{{ testimonial_name }}</p>
            {% endif %}
            {% if testimonial_location != blank %}
              <p class="gs-test-location-{{ ai_gen_id }}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span>{{ testimonial_location }}</span>
              </p>
            {% endif %}
            {% if testimonial_verified != false %}
              <p class="gs-test-verified-{{ ai_gen_id }}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
                <span>Verified Customer</span>
              </p>
            {% endif %}
          </div>
        </div>
      </article>
    {% endif %}
  {% endfor %}
{% endcapture %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap');

  .gs-testimonials-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    width: 100%;
    position: relative;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    overflow: hidden;
  }

  .gs-testimonials-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    position: relative;
    padding: 0 {{ block.settings.section_padding_horizontal }}px;
    box-sizing: border-box;
  }

  /* Header Styles */
  .gs-testimonials-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 36px;
    padding: 0 16px;
  }

  .gs-testimonials-label-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: {{ block.settings.label_font_size }}px;
    color: {{ block.settings.label_color }};
    letter-spacing: 2.5px;
    font-weight: 700;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .gs-label-dash-{{ ai_gen_id }} {
    display: inline-block;
    width: 24px;
    height: 2px;
    background-color: {{ block.settings.label_color }};
    vertical-align: middle;
  }

  .gs-testimonials-heading-{{ ai_gen_id }} {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 14px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .gs-testimonials-underline-{{ ai_gen_id }} {
    width: {{ block.settings.underline_width }}px;
    height: {{ block.settings.underline_height }}px;
    background-color: {{ block.settings.underline_color }};
    margin: 0 auto 18px;
    border-radius: 2px;
  }

  .gs-testimonials-sub-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_font_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0 auto;
    max-width: 680px;
    line-height: 1.5;
  }

  /* Infinite Seamless Circular Carousel */
  .gs-infinite-carousel-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 10px 0 10px;
  }

  .gs-marquee-track-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: gs-infinite-scroll-{{ ai_gen_id }} {{ block.settings.marquee_speed | default: 18 }}s linear infinite;
  }

  .gs-marquee-track-{{ ai_gen_id }}:hover,
  .gs-marquee-track-{{ ai_gen_id }}.paused {
    animation-play-state: paused;
  }

  .gs-marquee-group-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.grid_gap }}px;
    padding-right: {{ block.settings.grid_gap }}px;
    flex-shrink: 0;
  }

  @keyframes gs-infinite-scroll-{{ ai_gen_id }} {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-25%, 0, 0);
    }
  }

  /* Card Styles */
  .gs-test-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: left;
    box-shadow: {{ block.settings.card_shadow }};
    border: 1px solid #f0f2f5;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 305px;
    flex: 0 0 305px;
    user-select: none;
  }

  .gs-test-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.09);
  }

  .gs-test-quote-icon-{{ ai_gen_id }} {
    color: {{ block.settings.quote_icon_color }};
    margin-bottom: 10px;
    line-height: 1;
    display: inline-block;
  }

  .gs-rating-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .gs-test-stars-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: {{ block.settings.star_size }}px;
    letter-spacing: 1.5px;
    line-height: 1;
  }

  .gs-rating-score-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 700;
    color: #0a2540;
    line-height: 1;
  }

  .gs-test-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.testimonial_text_size }}px;
    color: {{ block.settings.testimonial_text_color }};
    line-height: 1.55;
    margin: 0 0 18px;
    flex-grow: 1;
  }

  .gs-test-divider-{{ ai_gen_id }} {
    width: 100%;
    height: 1px;
    background-color: #f1f5f9;
    margin-bottom: 16px;
  }

  .gs-test-footer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .gs-test-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_background }};
    color: {{ block.settings.avatar_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: {{ block.settings.avatar_text_size }}px;
    flex-shrink: 0;
    letter-spacing: 0.5px;
  }

  .gs-test-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .gs-test-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_font_size }}px;
    color: {{ block.settings.name_color }};
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .gs-test-location-{{ ai_gen_id }} {
    font-size: {{ block.settings.location_font_size }}px;
    color: {{ block.settings.location_color }};
    margin: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    line-height: 1.3;
  }

  .gs-test-location-{{ ai_gen_id }} svg {
    color: #ff7a00;
    flex-shrink: 0;
  }

  .gs-test-verified-{{ ai_gen_id }} {
    font-size: 12px;
    color: #10b981;
    font-weight: 600;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    line-height: 1.3;
  }

  .gs-test-verified-{{ ai_gen_id }} svg {
    color: #10b981;
    flex-shrink: 0;
  }

  /* Responsive Rules */
  @media screen and (max-width: 1024px) {
    .gs-test-card-{{ ai_gen_id }} {
      width: 285px;
      flex: 0 0 285px;
    }
  }

  @media screen and (max-width: 749px) {
    .gs-testimonials-{{ ai_gen_id }} {
      padding: 15px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .gs-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .gs-testimonials-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_font_size }}px * 0.7);
    }

    .gs-testimonials-sub-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_font_size }}px * 0.9);
      padding: 0 10px;
    }

    .gs-test-card-{{ ai_gen_id }} {
      width: 270px;
      flex: 0 0 270px;
      padding: 20px 18px;
    }
  }
{% endstyle %}

<section class="gs-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <!-- Section Header -->
  <div class="gs-testimonials-header-{{ ai_gen_id }}">
    {% if block.settings.label != blank %}
      <p class="gs-testimonials-label-{{ ai_gen_id }}">
        <span class="gs-label-dash-{{ ai_gen_id }}"></span>
        <span>{{ block.settings.label }}</span>
        <span class="gs-label-dash-{{ ai_gen_id }}"></span>
      </p>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="gs-testimonials-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.show_underline %}
      <div class="gs-testimonials-underline-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <p class="gs-testimonials-sub-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
    {% endif %}
  </div>

  <!-- Infinite Circular Continuous Carousel (Zero-Gap Multi-Group Stream) -->
  <div class="gs-infinite-carousel-{{ ai_gen_id }}" id="gs-carousel-{{ ai_gen_id }}">
    <div class="gs-marquee-track-{{ ai_gen_id }}" id="gs-track-{{ ai_gen_id }}">
      <div class="gs-marquee-group-{{ ai_gen_id }}">
        {{ cards_html }}
      </div>
      <div class="gs-marquee-group-{{ ai_gen_id }}" aria-hidden="true">
        {{ cards_html }}
      </div>
      <div class="gs-marquee-group-{{ ai_gen_id }}" aria-hidden="true">
        {{ cards_html }}
      </div>
      <div class="gs-marquee-group-{{ ai_gen_id }}" aria-hidden="true">
        {{ cards_html }}
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initMarqueeTouch() {
      const track = document.getElementById('gs-track-{{ ai_gen_id }}');
      if (!track) return;

      track.addEventListener('touchstart', function() {
        track.classList.add('paused');
      }, { passive: true });

      track.addEventListener('touchend', function() {
        setTimeout(function() {
          track.classList.remove('paused');
        }, 1200);
      }, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMarqueeTouch);
    } else {
      initMarqueeTouch();
    }
  })();
</script>


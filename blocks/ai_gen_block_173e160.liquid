{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .gs-testimonials-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .gs-testimonials-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .gs-testimonials-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    color: {{ block.settings.label_color }};
    letter-spacing: 2px;
    font-weight: 600;
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  .gs-testimonials-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 700;
  }

  .gs-testimonials-underline-{{ ai_gen_id }} {
    width: {{ block.settings.underline_width }}px;
    height: {{ block.settings.underline_height }}px;
    background-color: {{ block.settings.underline_color }};
    margin: 0 auto 20px;
  }

  .gs-testimonials-sub-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_font_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0 0 40px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .gs-testimonials-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: 40px;
  }

  .gs-test-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: left;
    box-shadow: {{ block.settings.card_shadow }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .gs-test-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .gs-test-quote-icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_icon_size }}px;
    color: {{ block.settings.quote_icon_color }};
    margin-bottom: 12px;
    line-height: 1;
  }

  .gs-test-stars-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: {{ block.settings.star_size }}px;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .gs-test-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.testimonial_text_size }}px;
    color: {{ block.settings.testimonial_text_color }};
    line-height: 1.6;
    margin: 0 0 24px;
  }

  .gs-test-footer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .gs-test-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_background }};
    color: {{ block.settings.avatar_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: {{ block.settings.avatar_text_size }}px;
    flex-shrink: 0;
  }

  .gs-test-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_font_size }}px;
    color: {{ block.settings.name_color }};
    font-weight: 600;
    margin: 0 0 4px;
  }

  .gs-test-location-{{ ai_gen_id }} {
    font-size: {{ block.settings.location_font_size }}px;
    color: {{ block.settings.location_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .gs-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .gs-testimonials-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_font_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .gs-testimonials-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .gs-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .gs-testimonials-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_font_size }}px * 0.6);
    }

    .gs-testimonials-sub-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_font_size }}px * 0.9);
    }
  }
{% endstyle %}

<section class="gs-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="gs-testimonials-inner-{{ ai_gen_id }}">
    {% if block.settings.label != blank %}
      <p class="gs-testimonials-label-{{ ai_gen_id }}">{{ block.settings.label }}</p>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="gs-testimonials-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.show_underline %}
      <div class="gs-testimonials-underline-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <p class="gs-testimonials-sub-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
    {% endif %}

    <div class="gs-testimonials-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign testimonial_enabled_key = 'testimonial_' | append: i | append: '_enabled'
          assign testimonial_text_key = 'testimonial_' | append: i | append: '_text'
          assign testimonial_name_key = 'testimonial_' | append: i | append: '_name'
          assign testimonial_location_key = 'testimonial_' | append: i | append: '_location'
          assign testimonial_avatar_key = 'testimonial_' | append: i | append: '_avatar'
          assign testimonial_rating_key = 'testimonial_' | append: i | append: '_rating'

          assign testimonial_enabled = block.settings[testimonial_enabled_key]
          assign testimonial_text = block.settings[testimonial_text_key]
          assign testimonial_name = block.settings[testimonial_name_key]
          assign testimonial_location = block.settings[testimonial_location_key]
          assign testimonial_avatar = block.settings[testimonial_avatar_key]
          assign testimonial_rating = block.settings[testimonial_rating_key]
        %}

        {% if testimonial_enabled %}
          <article class="gs-test-card-{{ ai_gen_id }}">
            <div class="gs-test-quote-icon-{{ ai_gen_id }}">❝❞</div>
            
            <div class="gs-test-stars-{{ ai_gen_id }}">
              {% if testimonial_rating == 5 %}
                ★★★★★
              {% elsif testimonial_rating == 4 %}
                ★★★★☆
              {% elsif testimonial_rating == 3 %}
                ★★★☆☆
              {% elsif testimonial_rating == 2 %}
                ★★☆☆☆
              {% else %}
                ★☆☆☆☆
              {% endif %}
            </div>

            {% if testimonial_text != blank %}
              <p class="gs-test-text-{{ ai_gen_id }}">{{ testimonial_text }}</p>
            {% endif %}

            <div class="gs-test-footer-{{ ai_gen_id }}">
              {% if testimonial_avatar != blank %}
                <div class="gs-test-avatar-{{ ai_gen_id }}">{{ testimonial_avatar }}</div>
              {% endif %}
              <div>
                {% if testimonial_name != blank %}
                  <p class="gs-test-name-{{ ai_gen_id }}">{{ testimonial_name }}</p>
                {% endif %}
                {% if testimonial_location != blank %}
                  <p class="gs-test-location-{{ ai_gen_id }}">{{ testimonial_location }}</p>
                {% endif %}
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>


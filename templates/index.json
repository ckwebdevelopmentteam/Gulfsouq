    "section_custom_liquid_wUa8M4": {
      "type": "section-custom-liquid",
      "name": "Trust Strip",
      "settings": {
        "custom_liquid": "<style>\n  .custom-trust-strip {\n    background-color: #ffffff;\n    padding: 0px 0px;\n    width: 100%;\n  }\n  .trust-strip-inner {\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n  .trust-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr); \n    gap: 10px;\n    justify-content: center;\n  }\n  @media (min-width: 768px) {\n    .trust-grid {\n      gap: 30px;\n    }\n  }\n  .trust-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n  }\n  .trust-icon-box {\n    width: 36px;\n    height: 36px;\n    background-color: #0C3E61; \n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 8px;\n  }\n  .trust-icon-box svg {\n    width: 18px;\n    height: 18px;\n    color: #D4AF37; \n    fill: currentColor;\n  }\n  .trust-heading {\n    font-size: 8px;\n    font-weight: 700;\n    color: #0C3E61;\n    margin: 0 0 2px 0;\n    line-height: 1.2;\n    font-family: inherit;\n  }\n  .trust-subtext {\n    font-size: 9px;\n    color: #0C3E61;\n    opacity: 0.75;\n    margin: 0;\n    line-height: 1.1;\n    display: none;\n  }\n  @media (min-width: 768px) {\n    .custom-trust-strip {\n      padding: 30px 20px;\n    }\n    .trust-icon-box {\n      width: 50px;\n      height: 50px;\n      border-radius: 12px;\n      margin-bottom: 12px;\n      box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n    }\n    .trust-icon-box svg {\n      width: 24px;\n      height: 24px;\n    }\n    .trust-heading {\n      font-size: 15px;\n      margin-bottom: 4px;\n    }\n    .trust-subtext {\n      font-size: 12px;\n      line-height: 1.4;\n      display: block;\n    }\n  }\n  @media (min-width: 380px) and (max-width: 767px) {\n     .trust-subtext { display: block; }\n  }\n</style>\n\n<div class=\"custom-trust-strip\">\n  <div class=\"trust-strip-inner\">\n    <div class=\"trust-grid\">\n      <div class=\"trust-item\">\n        <div class=\"trust-icon-box\">\n          <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z\"/></svg>\n        </div>\n        <h3 class=\"trust-heading\">100% Genuine</h3>\n        <p class=\"trust-subtext\">Authentic Products</p>\n      </div>\n      <div class=\"trust-item\">\n        <div class=\"trust-icon-box\">\n           <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z\"/></svg>\n        </div>\n        <h3 class=\"trust-heading\">Secure Payments</h3>\n        <p class=\"trust-subtext\">Safe Transactions</p>\n      </div>\n      <div class=\"trust-item\">\n        <div class=\"trust-icon-box\">\n           <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\"/></svg>\n        </div>\n        <h3 class=\"trust-heading\">Express Delivery</h3>\n        <p class=\"trust-subtext\">Fast Shipping</p>\n      </div>\n      <div class=\"trust-item\">\n        <div class=\"trust-icon-box\">\n           <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12 1a9 9 0 0 0-9 9v7c0 1.66 1.34 3 3 3h3v-8H5v-2c0-3.87 3.13-7 7-7s7 3.13 7 7v2h-4v8h3c1.66 0 3-1.34 3-3v-7a9 9 0 0 0-9-9z\"/></svg>\n        </div>\n        <h3 class=\"trust-heading\">24/7 Support</h3>\n        <p class=\"trust-subtext\">Premium Care</p>\n      </div>\n    </div>\n  </div>\n</div>",
